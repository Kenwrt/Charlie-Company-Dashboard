@page "/"
@page "/entity/{EntitySlug}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using CharleyCompany.Dashboard.Web.Models
@using CharleyCompany.Dashboard.Web.Services
@using CharleyCompany.Dashboard.Web.Data
@using Microsoft.EntityFrameworkCore
@inject IDashboardDataSource DashboardDataSource
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject DashboardNotificationService Notifications
@inject OperationAccessService OperationAccess
@inject ILogger<Home> Logger

<PageTitle>@currentSnapshot.EntityName Dashboard</PageTitle>

<section class="dashboard-shell">
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">@(IsEntityView ? "Local service entity" : isAdministrator ? "Venture group dashboard" : "Local operator dashboard")</p>
            <h1>
                @(IsEntityView ? currentSnapshot.EntityName : isAdministrator ? "Charlie Company Ventures" : "My Operations Dashboard")
                @if (!IsEntityView)
                {
                    <span class="powered-by-centcom" style="font-size: 0.3em; font-weight: 500; margin-left: 0.65rem; vertical-align: middle;">Powered by CentCom</span>
                }
            </h1>
            <p class="dashboard-subtitle">@Subtitle</p>
        </div>

        <div class="dashboard-status">
            <span class="status-dot"></span>
            <span>@currentSnapshot.DataSource</span>
            <small>Updated @currentSnapshot.LastUpdated.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small>
        </div>
    </div>

    @if (IsEntityView)
    {
        <NavLink class="back-link" href="">@(isAdministrator ? "Back to venture group rollup" : "Back to my operations dashboard")</NavLink>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="metric-grid">
        @foreach (var metric in BuildMetrics(currentSnapshot))
        {
            @if (metric.Href is not null)
            {
                <NavLink class="@($"metric-card metric-card-link {metric.AccentClass}")" href="@metric.Href">
                    <span>@metric.Label</span>
                    <strong>@metric.Value</strong>
                    <small>@metric.Detail</small>
                </NavLink>
            }
            else
            {
                <article class="metric-card @metric.AccentClass">
                    <span>@metric.Label</span>
                    <strong>@metric.Value</strong>
                    <small>@metric.Detail</small>
                </article>
            }
        }
    </div>

    <section class="activity-panel">
        <div>
            <h2>Accounts Receivable</h2>
            <p>@(IsEntityView ? $"Uncollected Housecall Pro job balances for {currentSnapshot.EntityName}." : "Uncollected Housecall Pro job balances across the active local operations.")</p>
        </div>

        <div class="metric-grid finance-metric-grid">
            <NavLink class="metric-card metric-card-link accent-revenue" href="@ExpectedReceivablesHref">
                <span>Expected Receivables</span>
                <strong>@receivablesSummary.ExpectedBalance.ToString("C2")</strong>
                <small>@receivablesSummary.ExpectedJobCount.ToString("N0") jobs with an uncollected balance</small>
            </NavLink>
            <NavLink class="metric-card metric-card-link accent-expired" href="@OverThirtyReceivablesHref">
                <span>Receivables older than 30 days</span>
                <strong>@receivablesSummary.OverThirtyBalance.ToString("C2")</strong>
                <small>@receivablesSummary.OverThirtyJobCount.ToString("N0") jobs older than 30 days</small>
            </NavLink>
        </div>

        <h3 id="receivables-aging" class="h5 mt-4">Receivables aging report</h3>
        <p class="small text-muted">Aging uses the job’s scheduled end date, or scheduled start date when no end date is available. Unscheduled jobs without a date are shown as Unknown.</p>
        <div class="finance-table-wrap">
            <table class="finance-table receivables-aging-table">
                <colgroup><col /><col class="aging-jobs-column" /><col class="aging-balance-column" /></colgroup>
                <thead><tr><th>Aging period</th><th class="text-end">Jobs</th><th class="text-end">Uncollected balance</th></tr></thead>
                <tbody>
                    @foreach (var bucket in receivablesSummary.AgingBuckets)
                    {
                        <tr>
                            <td>@bucket.Label</td>
                            <td class="text-end">
                                @if (bucket.JobCount > 0)
                                {
                                    <NavLink href="@AgingReceivablesHref(bucket.Slug)" aria-label="@($"View {bucket.JobCount} jobs in {bucket.Label}")">@bucket.JobCount.ToString("N0")</NavLink>
                                }
                                else
                                {
                                    @bucket.JobCount.ToString("N0")
                                }
                            </td>
                            <td class="text-end">@bucket.Balance.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td>Total</td><td class="text-end"><NavLink href="@ExpectedReceivablesHref">@receivablesSummary.ExpectedJobCount.ToString("N0")</NavLink></td><td class="text-end">@receivablesSummary.ExpectedBalance.ToString("C2")</td></tr>
                </tfoot>
            </table>
        </div>
    </section>

    <section class="activity-panel revenue-forecast-panel">
        <div>
            <h2>Job revenue forecast</h2>
            <p>Every active job, its current phase, expected next phase, and the next customer payment. Forecast totals include all open payment milestones.</p>
        </div>

        <div class="metric-grid finance-metric-grid">
            @foreach (var bucket in revenueForecastSummary.Buckets)
            {
                <article class="metric-card @bucket.AccentClass">
                    <span>@bucket.Label</span>
                    <strong>@bucket.Amount.ToString("C2")</strong>
                    <small>@bucket.PaymentCount payment(s)</small>
                </article>
            }
        </div>

        <div class="row g-2 mt-2 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="forecast-location">Location</label>
                <select id="forecast-location" class="form-select" @bind="forecastOperationFilter">
                    <option value="">All available locations</option>
                    @foreach (var operation in revenueForecastSummary.Operations)
                    {
                        <option value="@operation">@operation</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="forecast-phase">Current phase</label>
                <select id="forecast-phase" class="form-select" @bind="forecastPhaseFilter">
                    <option value="">All phases</option>
                    @foreach (var phase in JobProgressOptions.Phases)
                    {
                        <option value="@phase">@phase</option>
                    }
                    <option value="Not tracked">Not tracked</option>
                </select>
            </div>
        </div>

        @if (FilteredForecastJobs.Count == 0)
        {
            <div class="empty-state">No active jobs match the selected filters.</div>
        }
        else
        {
            <div class="finance-table-wrap">
                <table class="finance-table">
                    <thead><tr><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("job")'>Job @ForecastSortIndicator("job")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("date")'>Job date @ForecastSortIndicator("date")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("operation")'>Location @ForecastSortIndicator("operation")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("customer")'>Customer @ForecastSortIndicator("customer")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("phase")'>Current phase @ForecastSortIndicator("phase")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("days")'>Time in phase @ForecastSortIndicator("days")</button></th><th>Next phase / expected</th><th>Next payment</th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("remaining")'>Remaining contract @ForecastSortIndicator("remaining")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortForecast("status")'>Forecast status @ForecastSortIndicator("status")</button></th><th></th></tr></thead>
                    <tbody>
                    @foreach (var job in FilteredForecastJobs)
                    {
                        <tr>
                            <td>@job.JobNumber</td>
                            <td>@job.JobDateText</td>
                            <td>@job.OperationName</td>
                            <td>@job.CustomerName</td>
                            <td>@job.CurrentPhase</td>
                            <td>@job.DaysInPhaseText</td>
                            <td><strong>@job.NextPhase</strong><br /><small>@job.NextPhaseDateText</small></td>
                            <td><strong>@job.NextPaymentText</strong><br /><small>@job.NextPaymentDateText</small></td>
                            <td>@job.RemainingContractValue.ToString("C2")</td>
                            <td><span class="badge @ForecastBadge(job.ForecastStatus)">@job.ForecastStatus</span>@if (!string.IsNullOrWhiteSpace(job.BlockerText)){<br /><small>@job.BlockerText</small>}</td>
                            <td><a class="btn btn-sm btn-outline-primary" href="@($"hcp/{job.OperationSlug}/jobs/{job.ExternalId}")">Review</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="activity-panel job-risk-panel">
        <div><h2>Job progress &amp; revenue risk</h2><p>Jobs delayed by permits, HOA approval, weather, materials, inspections, customers, or scheduling.</p></div>
        <div class="metric-grid finance-metric-grid">
            <article class="metric-card accent-expired"><span>Active blocked jobs</span><strong>@jobRiskSummary.BlockedJobCount</strong><small>@jobRiskSummary.CriticalJobCount critical delays</small></article>
            <article class="metric-card accent-revenue"><span>Revenue at risk</span><strong>@jobRiskSummary.RevenueAtRisk.ToString("C2")</strong><small>Pending payments affected by active blockers</small></article>
            <article class="metric-card accent-quotes"><span>Follow-ups due</span><strong>@jobRiskSummary.FollowUpsDue</strong><small>Next actions due today or earlier</small></article>
            <article class="metric-card accent-jobs"><span>Weather days lost</span><strong>@jobRiskSummary.WeatherDaysLost</strong><small>Cumulative active and resolved weather-delay days</small></article>
        </div>
        @if(jobRiskSummary.Jobs.Count==0){<div class="empty-state mt-3">No active job blockers are recorded.</div>}
        else
        {
            <div class="finance-table-wrap mt-3"><table class="finance-table"><thead><tr><th>Priority</th><th>Job</th><th>Customer</th><th>Phase</th><th>Blocker</th><th>Days blocked</th><th>Next follow-up</th><th>Revenue at risk</th><th></th></tr></thead><tbody>
            @foreach(var job in jobRiskSummary.Jobs)
            {<tr class="risk-row-@job.Severity"><td><span class="badge @RiskBadge(job.Severity)">@job.Severity</span></td><td>@job.JobNumber</td><td>@job.CustomerName</td><td>@job.Phase</td><td>@job.BlockerType</td><td>@job.DaysBlocked</td><td>@FormatRiskDate(job.NextFollowUpDate)</td><td>@job.RevenueAtRisk.ToString("C2")</td><td><a class="btn btn-sm btn-outline-primary" href="@($"hcp/{job.OperationSlug}/jobs/{job.ExternalId}")">Review</a></td></tr>}
            </tbody></table></div>
        }
    </section>

    <section class="activity-panel">
        <div>
            <h2>Accounts payable</h2>
            <p>@(IsEntityView ? "Open vendor invoices assigned to this local operation and its jobs." : "Open vendor invoices across the local operations available to you.")</p>
        </div>

        <div class="metric-grid finance-metric-grid">
            <article class="metric-card accent-expenses">
                <span>Net AP due</span>
                <strong>@apSummary.NetDue.ToString("C2")</strong>
                <small>@apSummary.OpenInvoiceCount.ToString("N0") open @(apSummary.OpenInvoiceCount == 1 ? "invoice" : "invoices") after available credits</small>
            </article>
            <article class="metric-card accent-expired">
                <span>Past due</span>
                <strong>@apSummary.PastDueBalance.ToString("C2")</strong>
                <small>@apSummary.PastDueInvoiceCount.ToString("N0") overdue @(apSummary.PastDueInvoiceCount == 1 ? "invoice" : "invoices")</small>
            </article>
            <article class="metric-card accent-quotes">
                <span>Due in 30 days</span>
                <strong>@apSummary.DueSoonBalance.ToString("C2")</strong>
                <small>Open balance due through @DateOnly.FromDateTime(DateTime.Today.AddDays(30)).ToString("MM/dd/yyyy")</small>
            </article>
            <article class="metric-card accent-jobs">
                <span>Available credits</span>
                <strong>@apSummary.AvailableCredits.ToString("C2")</strong>
                <small>Gross open invoices: @apSummary.GrossOpenBalance.ToString("C2")</small>
            </article>
        </div>

        @if (apSummary.Invoices.Count == 0)
        {
            <div class="empty-state">No payable invoices have been entered for this dashboard.</div>
        }
        else
        {
            <div class="finance-table-wrap">
                <table class="finance-table">
                    <thead>
                        <tr><th>Vendor</th><th>Operation</th><th>Invoice</th><th>Job #</th><th>Due</th><th>Past due</th><th>Status</th><th>Open</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in apSummary.Invoices)
                        {
                            <tr>
                                <td>@invoice.Vendor</td>
                                <td>@invoice.Operation</td>
                                <td>@invoice.InvoiceNumber</td>
                                <td>@invoice.JobNumber</td>
                                <td>@invoice.DueDate.ToString("MM/dd/yyyy")</td>
                                <td>@(invoice.DaysPastDue == 0 ? "Current" : $"{invoice.DaysPastDue} days")</td>
                                <td>@invoice.Status</td>
                                <td>@invoice.OpenBalance.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (!IsEntityView)
    {
        <section class="local-entity-panel">
            <div>
                <h2>@(isAdministrator ? "Local service entities" : "My locations")</h2>
                <p>@(isAdministrator ? "Click a local entity to view its individual dashboard." : "Each assigned location has an independent dashboard. Select a location to open it.")</p>
            </div>

            <div class="local-entity-grid">
                @foreach (var entity in ventureSnapshot.LocalEntities)
                {
                    <NavLink class="local-entity-card" href="@($"entity/{entity.EntitySlug}")">
                        <div>
                            <strong>@entity.EntityName</strong>
                            <span>@entity.CurrentJobsInProgress.ToString("N0") active jobs</span>
                        </div>
                        <dl>
                            <div>
                                <dt>Outstanding estimates</dt>
                                <dd>@entity.OutstandingEstimates.ToString("N0")</dd>
                            </div>
                            <div>
                                <dt>Scheduled job charges</dt>
                                <dd>@entity.MonthlyRevenue.ToString("C2")</dd>
                            </div>
                        </dl>
                    </NavLink>
                }
            </div>
        </section>
    }

    <details class="activity-panel notification-panel">
        <summary>
            <span>
                <strong>Event notifications</strong>
                <small>@currentSnapshot.RecentEvents.Count.ToString("N0") @(currentSnapshot.RecentEvents.Count == 1 ? "event" : "events")</small>
            </span>
            <span class="notification-panel-hint">Click to expand</span>
        </summary>

        <div class="notification-panel-content">
            <p>Estimate and expense webhook events will appear here as they arrive.</p>

            @if (currentSnapshot.RecentEvents.Count == 0)
            {
                <div class="empty-state">No webhook or sync notifications have been received yet.</div>
            }
            else
            {
                <div class="activity-list">
                    @foreach (var item in currentSnapshot.RecentEvents.OrderByDescending(e => e.OccurredAt))
                    {
                        <div class="activity-item">
                            <div>
                                <strong>@item.EventType</strong>
                                <span>@item.Message</span>
                            </div>
                            <time>@item.OccurredAt.ToLocalTime().ToString("h:mm tt")</time>
                        </div>
                    }
                </div>
            }
        </div>
    </details>
</section>

@code {
    [Parameter]
    public string? EntitySlug { get; set; }

    private VentureDashboardSnapshot ventureSnapshot = VentureDashboardSnapshot.Empty;
    private DashboardSnapshot currentSnapshot = DashboardSnapshot.Empty;
    private string? errorMessage;
    private ApDashboardSummary apSummary = ApDashboardSummary.Empty;
    private ReceivablesSummary receivablesSummary = ReceivablesSummary.Empty;
    private JobRiskSummary jobRiskSummary = JobRiskSummary.Empty;
    private RevenueForecastSummary revenueForecastSummary = RevenueForecastSummary.Empty;
    private string forecastOperationFilter = string.Empty;
    private string forecastPhaseFilter = string.Empty;
    private string forecastSortColumn = "date";
    private bool forecastSortDescending = true;
    private bool isAdministrator;

    private IReadOnlyList<RevenueForecastJobRow> FilteredForecastJobs
    {
        get
        {
            var rows = revenueForecastSummary.Jobs.Where(job => string.IsNullOrWhiteSpace(forecastOperationFilter) || job.OperationName == forecastOperationFilter).Where(job => string.IsNullOrWhiteSpace(forecastPhaseFilter) || job.CurrentPhase == forecastPhaseFilter);
            Func<RevenueForecastJobRow, object?> key = forecastSortColumn switch { "job" => row => row.JobNumber, "operation" => row => row.OperationName, "customer" => row => row.CustomerName, "phase" => row => row.CurrentPhase, "days" => row => ParseDays(row.DaysInPhaseText), "remaining" => row => row.RemainingContractValue, "status" => row => row.ForecastStatus, _ => row => row.JobDateText };
            return (forecastSortDescending ? rows.OrderByDescending(key) : rows.OrderBy(key)).ToList();
        }
    }

    private bool IsEntityView => !string.IsNullOrWhiteSpace(EntitySlug);
    private string DashboardOperationSlug => IsEntityView
        ? currentSnapshot.EntitySlug
        : ventureSnapshot.LocalEntities.FirstOrDefault()?.EntitySlug ?? "nashville";
    private string ExpectedReceivablesHref => $"hcp/jobs?operation={DashboardOperationSlug}&receivables=expected&allDates=true";
    private string OverThirtyReceivablesHref => $"hcp/jobs?operation={DashboardOperationSlug}&receivables=over30&allDates=true";
    private string AgingReceivablesHref(string bucket) => $"hcp/jobs?operation={DashboardOperationSlug}&receivables=aging&aging={bucket}&allDates=true";

    private string Subtitle => IsEntityView
        ? "Local view of jobs, estimates, monthly expenses, and revenue."
        : isAdministrator
            ? "Rolled-up view of all local service entities under Charlie Company Ventures Group."
            : "Rolled-up view of the locations assigned to your account.";

    protected override async Task OnInitializedAsync()
    {
        Notifications.DashboardChanged += OnDashboardChangedAsync;
        await LoadDashboardAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task OnDashboardChangedAsync()
    {
        await InvokeAsync(async () =>
        {
            await LoadDashboardAsync();
            StateHasChanged();
        });
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            errorMessage = null;
            isAdministrator = await OperationAccess.IsAdministratorAsync();

            if (IsEntityView)
            {
                if (!await OperationAccess.CanAccessAsync(EntitySlug!))
                {
                    errorMessage = "The selected local service entity could not be found.";
                    return;
                }
                var entitySnapshot = await DashboardDataSource.GetEntitySnapshotAsync(EntitySlug!, CancellationToken.None);

                if (entitySnapshot is null)
                {
                    ventureSnapshot = await DashboardDataSource.GetVentureSnapshotAsync(CancellationToken.None);
                    currentSnapshot = ventureSnapshot.Rollup;
                    errorMessage = "The selected local service entity could not be found.";
                    return;
                }

                currentSnapshot = entitySnapshot;
                await LoadReceivablesAsync(EntitySlug);
                await LoadAccountsPayableAsync(EntitySlug);
                await LoadJobRiskAsync(EntitySlug);
                await LoadRevenueForecastAsync(EntitySlug);
                return;
            }

            ventureSnapshot = await DashboardDataSource.GetVentureSnapshotAsync(CancellationToken.None);
            var allowedSlugs = (await OperationAccess.GetAccessibleOperationsAsync()).Select(operation => operation.Slug).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var allowedEntities = ventureSnapshot.LocalEntities.Where(entity => allowedSlugs.Contains(entity.EntitySlug)).ToList();
            ventureSnapshot = ventureSnapshot with { LocalEntities = allowedEntities, Rollup = BuildRollup(allowedEntities, ventureSnapshot.Rollup) };
            currentSnapshot = ventureSnapshot.Rollup;
            await LoadReceivablesAsync();
            await LoadAccountsPayableAsync();
            await LoadJobRiskAsync();
            await LoadRevenueForecastAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "The dashboard could not be refreshed. Check the console and Serilog file logs for details.";
            Logger.LogError(ex, "Dashboard page failed to load metrics.");
            Console.Error.WriteLine(ex);
        }
    }

    private async Task LoadAccountsPayableAsync(string? operationSlug = null)
    {
        var accessibleOperations = await OperationAccess.GetAccessibleOperationsAsync();
        var operationIds = accessibleOperations
            .Where(operation => operationSlug is null || operation.Slug.Equals(operationSlug, StringComparison.OrdinalIgnoreCase))
            .Select(operation => operation.Id)
            .ToList();

        if (operationIds.Count == 0)
        {
            apSummary = ApDashboardSummary.Empty;
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var invoices = await db.PayableInvoices.AsNoTracking()
            .Where(invoice => operationIds.Contains(invoice.LocalOperationId))
            .Where(invoice => invoice.OriginalAmount > invoice.AmountPaid)
            .OrderBy(invoice => invoice.DueDate)
            .Select(invoice => new ApDashboardInvoice(
                invoice.SupplyVendor.Name,
                string.IsNullOrWhiteSpace(invoice.LocalOperation.DisplayName) ? invoice.LocalOperation.Name : invoice.LocalOperation.DisplayName,
                invoice.InvoiceNumber,
                invoice.JobNumber,
                invoice.DueDate,
                invoice.Status,
                invoice.OriginalAmount - invoice.AmountPaid,
                invoice.AmountPaid))
            .ToListAsync();

        var availableCredits = await db.VendorCredits.AsNoTracking()
            .Where(credit => operationIds.Contains(credit.LocalOperationId) && credit.AvailableAmount > 0)
            .SumAsync(credit => credit.AvailableAmount);

        var today = DateOnly.FromDateTime(DateTime.Today);
        var dueSoon = today.AddDays(30);
        var grossOpenBalance = invoices.Sum(invoice => invoice.OpenBalance);
        apSummary = new(
            invoices.Count,
            grossOpenBalance,
            availableCredits,
            Math.Max(0, grossOpenBalance - availableCredits),
            invoices.Count(invoice => invoice.DueDate < today),
            invoices.Where(invoice => invoice.DueDate < today).Sum(invoice => invoice.OpenBalance),
            invoices.Where(invoice => invoice.DueDate >= today && invoice.DueDate <= dueSoon).Sum(invoice => invoice.OpenBalance),
            invoices.Sum(invoice => invoice.AmountPaid),
            invoices.Take(10).ToList());
    }

    private async Task LoadReceivablesAsync(string? operationSlug = null)
    {
        var operationIds = (await OperationAccess.GetAccessibleOperationsAsync())
            .Where(operation => operationSlug is null || operation.Slug.Equals(operationSlug, StringComparison.OrdinalIgnoreCase))
            .Select(operation => operation.Id)
            .ToList();
        if (operationIds.Count == 0)
        {
            receivablesSummary = ReceivablesSummary.Empty;
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var receivables = await db.HousecallProJobs.AsNoTracking()
            .Where(job => operationIds.Contains(job.LocalOperationId))
            .Where(job =>
                job.WorkStatus != "user canceled" &&
                job.WorkStatus != "pro canceled" &&
                job.WorkStatus != "pro-canceled" &&
                job.OutstandingBalance > 0)
            .Select(job => new
            {
                job.OutstandingBalance,
                AgeDate = job.ScheduledEnd ?? job.ScheduledStart
            })
            .ToListAsync();

        var today = DateTimeOffset.Now.Date;
        var rows = receivables
            .Select(item => new ReceivableRow(
                item.OutstandingBalance,
                item.AgeDate is null ? (int?)null : (today - item.AgeDate.Value.ToLocalTime().Date).Days))
            .ToList();

        var agingBuckets = new[]
        {
            BuildAgingBucket("Current to 30 days", "current-30", rows.Where(row => row.AgeInDays is <= 30)),
            BuildAgingBucket("31–60 days", "31-60", rows.Where(row => row.AgeInDays is >= 31 and <= 60)),
            BuildAgingBucket("61–90 days", "61-90", rows.Where(row => row.AgeInDays is >= 61 and <= 90)),
            BuildAgingBucket("91+ days", "91-plus", rows.Where(row => row.AgeInDays is >= 91)),
            BuildAgingBucket("Unknown (unscheduled/no date)", "unknown", rows.Where(row => row.AgeInDays is null))
        };
        var overThirty = rows.Where(row => row.AgeInDays is >= 31).ToList();
        receivablesSummary = new(
            rows.Count,
            rows.Sum(row => row.Balance),
            overThirty.Count,
            overThirty.Sum(row => row.Balance),
            agingBuckets);
    }

    private async Task LoadJobRiskAsync(string? operationSlug=null)
    {
        var operationIds=(await OperationAccess.GetAccessibleOperationsAsync()).Where(x=>operationSlug is null||x.Slug.Equals(operationSlug,StringComparison.OrdinalIgnoreCase)).Select(x=>x.Id).ToList();
        if(operationIds.Count==0){jobRiskSummary=JobRiskSummary.Empty;return;}
        await using var db=await DbContextFactory.CreateDbContextAsync();
        var jobs=await db.HousecallProJobs.AsNoTracking().Include(x=>x.LocalOperation).Include(x=>x.Progress).Include(x=>x.Blockers).Include(x=>x.PaymentMilestones).Where(x=>operationIds.Contains(x.LocalOperationId)&&x.Blockers.Any(b=>b.ResolvedOn==null)).ToListAsync();
        var today=DateOnly.FromDateTime(DateTime.Today);
        var rows=new List<JobRiskRow>();
        foreach(var job in jobs)
        {
            var active=job.Blockers.Where(x=>x.ResolvedOn is null).ToList();
            var primary=active.OrderByDescending(BlockerSeverityRank).ThenBy(x=>x.StartedOn).First();
            var pending=job.PaymentMilestones.Where(x=>x.Status is not("Paid" or "Waived")).OrderBy(x=>x.ExpectedPaymentDate).FirstOrDefault();
            var risk=Math.Max(active.Sum(x=>x.RevenueAtRisk),pending?.Amount??0);
            rows.Add(new(BlockerSeverity(primary),job.JobNumber??job.ExternalId,job.CustomerName??"Not provided",job.Progress?.CurrentPhase??"Not tracked",primary.BlockerType,Math.Max(0,today.DayNumber-primary.StartedOn.DayNumber),job.Progress?.NextFollowUpDate??primary.NextFollowUpDate,risk,job.LocalOperation.Slug,job.ExternalId));
        }
        rows=rows.OrderByDescending(x=>SeverityRank(x.Severity)).ThenByDescending(x=>x.DaysBlocked).ToList();
        var allWeatherDays=jobs.SelectMany(x=>x.Blockers).Where(x=>x.BlockerType=="Weather").Sum(x=>Math.Max(0,(x.ResolvedOn??today).DayNumber-x.StartedOn.DayNumber));
        jobRiskSummary=new(rows.Count,rows.Count(x=>x.Severity=="Critical"),rows.Sum(x=>x.RevenueAtRisk),rows.Count(x=>x.NextFollowUpDate is not null&&x.NextFollowUpDate<=today),allWeatherDays,rows.Take(20).ToList());
    }

    private async Task LoadRevenueForecastAsync(string? operationSlug = null)
    {
        var operationIds = (await OperationAccess.GetAccessibleOperationsAsync())
            .Where(operation => operationSlug is null || operation.Slug.Equals(operationSlug, StringComparison.OrdinalIgnoreCase))
            .Select(operation => operation.Id)
            .ToList();
        if (operationIds.Count == 0)
        {
            revenueForecastSummary = RevenueForecastSummary.Empty;
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var earliestForecastJobDate = new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
        var jobs = await db.HousecallProJobs.AsNoTracking()
            .Include(job => job.LocalOperation)
            .Include(job => job.Progress)
            .Include(job => job.Blockers)
            .Include(job => job.PaymentMilestones)
            .Where(job => operationIds.Contains(job.LocalOperationId))
            .Where(job => job.InternalStatus != HousecallProEstimateStatuses.FollowUpComplete)
            .Where(job =>
                job.InternalStatus == "scheduled" ||
                job.InternalStatus == "unscheduled" ||
                job.InternalStatus == "needs scheduling" ||
                job.InternalStatus == "in progress" ||
                (job.InternalStatus == null &&
                    (job.WorkStatus == "scheduled" ||
                     job.WorkStatus == "unscheduled" ||
                     job.WorkStatus == "needs scheduling" ||
                     job.WorkStatus == "in progress")))
            .Where(job => job.ScheduledStart == null || job.ScheduledStart >= earliestForecastJobDate)
            .Where(job => job.WorkStatus != "user canceled" && job.WorkStatus != "pro canceled" && job.WorkStatus != "pro-canceled")
            .ToListAsync();

        jobs = jobs.Where(job =>
            !IsCompletedJob(job.WorkStatus) ||
            job.OutstandingBalance > 0 ||
            job.PaymentMilestones.Any(milestone => milestone.Status is not ("Paid" or "Waived")))
            .ToList();

        var today = DateOnly.FromDateTime(DateTime.Today);
        var rows = new List<RevenueForecastJobRow>();
        var openPayments = new List<HousecallProJobPaymentMilestone>();
        foreach (var job in jobs)
        {
            var currentPhase = job.Progress?.CurrentPhase ?? "Not tracked";
            var currentIndex = Array.IndexOf(JobProgressOptions.Phases, currentPhase);
            var nextPhase = currentIndex >= 0 && currentIndex < JobProgressOptions.Phases.Length - 1
                ? JobProgressOptions.Phases[currentIndex + 1]
                : currentPhase == "Complete" ? "Complete" : "Not scheduled";
            var nextPhaseDate = job.Progress?.ExpectedPhaseCompletionDate;
            var openMilestones = job.PaymentMilestones
                .Where(milestone => milestone.Status is not ("Paid" or "Waived"))
                .OrderBy(milestone => milestone.ExpectedPaymentDate is null)
                .ThenBy(milestone => milestone.ExpectedPaymentDate)
                .ToList();
            openPayments.AddRange(openMilestones);
            var nextPayment = openMilestones.FirstOrDefault();
            var activeBlockers = job.Blockers.Where(blocker => blocker.ResolvedOn is null).ToList();
            var forecastStatus = job.Progress is null || nextPayment is null || nextPayment.ExpectedPaymentDate is null
                ? "Missing schedule"
                : activeBlockers.Any(blocker => BlockerSeverity(blocker) == "Critical") ? "At risk"
                : activeBlockers.Count > 0 ? "Watch" : "Forecast";
            var paidMilestones = job.PaymentMilestones.Where(milestone => milestone.Status == "Paid").Sum(milestone => milestone.Amount);
            var remainingContract = Math.Max(job.OutstandingBalance, Math.Max(0, job.JobPrice - paidMilestones));
            var daysInPhase = job.Progress is null ? (int?)null : Math.Max(0, (DateTimeOffset.UtcNow - job.Progress.PhaseEnteredAt).Days);

            rows.Add(new(
                job.JobNumber ?? job.ExternalId,
                job.ScheduledStart?.ToLocalTime().ToString("MM/dd/yyyy") ?? "Not scheduled",
                job.CustomerName ?? "Not provided",
                job.LocalOperation.EffectiveDisplayName,
                job.LocalOperation.Slug,
                job.ExternalId,
                currentPhase,
                daysInPhase is null ? "Not tracked" : $"{daysInPhase} day(s)",
                nextPhase,
                nextPhaseDate?.ToString("MM/dd/yyyy") ?? "Not scheduled",
                nextPayment is null ? "No payment scheduled" : $"{nextPayment.Name} · {nextPayment.Amount:C2}",
                nextPayment?.ExpectedPaymentDate?.ToString("MM/dd/yyyy") ?? "Not scheduled",
                remainingContract,
                forecastStatus,
                activeBlockers.Count == 0 ? string.Empty : string.Join(", ", activeBlockers.Select(blocker => blocker.BlockerType).Distinct())));
        }

        var buckets = BuildForecastBuckets(openPayments, today);
        revenueForecastSummary = new(
            rows.OrderBy(row => ForecastRank(row.ForecastStatus)).ThenBy(row => row.NextPaymentDateText == "Not scheduled").ThenBy(row => row.NextPaymentDateText).ToList(),
            buckets,
            rows.Select(row => row.OperationName).Distinct().OrderBy(name => name).ToList());
    }

    private static IReadOnlyList<RevenueForecastBucket> BuildForecastBuckets(IEnumerable<HousecallProJobPaymentMilestone> milestones, DateOnly today)
    {
        var payments = milestones.ToList();
        return
        [
            ForecastBucket("Overdue / due now", payments.Where(item => item.ExpectedPaymentDate is not null && item.ExpectedPaymentDate <= today), "accent-expired"),
            ForecastBucket("Next 7 days", payments.Where(item => DaysUntil(item.ExpectedPaymentDate, today) is >= 1 and <= 7), "accent-revenue"),
            ForecastBucket("8–14 days", payments.Where(item => DaysUntil(item.ExpectedPaymentDate, today) is >= 8 and <= 14), "accent-quotes"),
            ForecastBucket("15–30 days", payments.Where(item => DaysUntil(item.ExpectedPaymentDate, today) is >= 15 and <= 30), "accent-jobs"),
            ForecastBucket("31–60 days", payments.Where(item => DaysUntil(item.ExpectedPaymentDate, today) is >= 31 and <= 60), "accent-revenue"),
            ForecastBucket("Beyond 60 days", payments.Where(item => DaysUntil(item.ExpectedPaymentDate, today) is > 60), "accent-quotes"),
            ForecastBucket("No date scheduled", payments.Where(item => item.ExpectedPaymentDate is null), "accent-expenses")
        ];
    }

    private static int? DaysUntil(DateOnly? date, DateOnly today) => date is null ? null : date.Value.DayNumber - today.DayNumber;
    private static RevenueForecastBucket ForecastBucket(string label, IEnumerable<HousecallProJobPaymentMilestone> items, string accentClass)
    {
        var rows = items.ToList();
        return new(label, rows.Count, rows.Sum(item => item.Amount), accentClass);
    }

    private static bool IsCompletedJob(string? status) => status?.Trim().ToLowerInvariant() is "complete rated" or "complete unrated" or "completed" or "complete";
    private static int ForecastRank(string status) => status == "At risk" ? 0 : status == "Missing schedule" ? 1 : status == "Watch" ? 2 : 3;
    private static string ForecastBadge(string status) => status == "At risk" ? "text-bg-danger" : status == "Missing schedule" ? "text-bg-warning" : status == "Watch" ? "text-bg-info" : "text-bg-success";
    private void SortForecast(string column) { if (forecastSortColumn == column) forecastSortDescending = !forecastSortDescending; else { forecastSortColumn = column; forecastSortDescending = false; } }
    private string ForecastSortIndicator(string column) => forecastSortColumn == column ? (forecastSortDescending ? "▼" : "▲") : "↕";
    private static int ParseDays(string value) => int.TryParse(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault(), out var days) ? days : -1;

    private static ReceivablesAgingBucket BuildAgingBucket(string label, string slug, IEnumerable<ReceivableRow> rows)
    {
        var items = rows.ToList();
        return new(label, slug, items.Count, items.Sum(item => item.Balance));
    }

