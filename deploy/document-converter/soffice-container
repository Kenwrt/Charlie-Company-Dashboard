#!/bin/sh
set -eu
while [ "$#" -gt 2 ]; do
    if [ "$1" = --outdir ]; then
        output=$2
        shift 2
        break
    fi
    shift
done
test "$#" -eq 1
test -d "$output"
exec /usr/bin/docker run --rm -i --pull=never --network=none --read-only \
    --cap-drop=ALL --security-opt=no-new-privileges --pids-limit=128 \
    --memory=768m --cpus=1 --user=65534:65534 --env HOME=/work \
    --tmpfs /work:rw,nosuid,nodev,noexec,size=128m,mode=1777 \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=128m,mode=1777 \
    charlie-document-converter:1 < "$1" > "$output/source.pdf"
