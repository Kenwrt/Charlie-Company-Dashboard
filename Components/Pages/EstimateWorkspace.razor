    private async Task ResolveAssumptionAsync(QuoteTaskAnalysisReviewItem item)
    {
        if (quote is null || item.ReviewKind != AnalysisReviewKinds.Assumption
            || !AssumptionResolutionActions.All.Contains(item.ResolutionAction ?? string.Empty)) return;
        if (string.IsNullOrWhiteSpace(item.EstimatorResponse))
        {
            message = "Enter the corrected condition, decision, or field-verification requirement before rejecting this assumption.";
            return;
        }
        if (item.ResolutionAction is AssumptionResolutionActions.ChangeMaterials or AssumptionResolutionActions.AddTaskFee)
        {
            message = "Use the product or fee controls for the selected assumption resolution.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteTaskAnalysisReviewItems
            .Include(x => x.QuoteTaskAnalysis).ThenInclude(x => x.QuoteProjectTask)
            .SingleOrDefaultAsync(x => x.Id == item.Id && x.QuoteTaskAnalysis.QuoteProjectTask.QuoteCaseId == quote.Id);
        if (tracked is null) return;
        var response = item.EstimatorResponse.Trim();
        if (item.ResolutionAction == AssumptionResolutionActions.UpdateTaskScope)
        {
            var addition = $"[Estimator assumption correction] {response}";
            if (!tracked.QuoteTaskAnalysis.QuoteProjectTask.ScopeOfWork.Contains(addition, StringComparison.OrdinalIgnoreCase))
            {
                var revisedScope = $"{tracked.QuoteTaskAnalysis.QuoteProjectTask.ScopeOfWork.Trim()}\n{addition}".Trim();
                tracked.QuoteTaskAnalysis.QuoteProjectTask.ScopeOfWork = revisedScope[..Math.Min(4000, revisedScope.Length)];
            }
        }
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        tracked.Status = item.ResolutionAction switch
        {
            AssumptionResolutionActions.NotPartOfJob => AnalysisReviewStatuses.NotApplicable,
            AssumptionResolutionActions.FieldVerification => AnalysisReviewStatuses.FieldVerification,
            _ => AnalysisReviewStatuses.Resolved
        };
        tracked.EstimatorResponse = response;
        tracked.ResolutionAction = item.ResolutionAction;
        tracked.ResolvedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        tracked.ResolvedAt = DateTimeOffset.UtcNow;
        await SaveReusableReviewRuleAsync(db, tracked, user.FindFirstValue(ClaimTypes.NameIdentifier));
        await db.SaveChangesAsync();
        message = tracked.Status == AnalysisReviewStatuses.FieldVerification
            ? "Assumption is awaiting field verification; reanalysis will remain unavailable until it is corrected or accepted."
            : "Assumption correction saved.";
        await ReloadAsync();
    }

