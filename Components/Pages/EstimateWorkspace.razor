    private async Task SaveEstimateAsync()
    {
        if (quote is null || savingEstimate) return;
        if (currentCostSnapshot is not null && !ValidatePricingInputs()) return;
        savingEstimate = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.QuoteCases
                .Include(x => x.ProjectTasks)
                .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.Tasks)
                .SingleOrDefaultAsync(x => x.Id == quote.Id);
            if (tracked is null) return;

            tracked.WorkDescription = quote.WorkDescription?.Trim() ?? string.Empty;
            tracked.UpdatedAt = DateTimeOffset.UtcNow;
            foreach (var editedTask in quote.ProjectTasks)
            {
                var trackedTask = tracked.ProjectTasks.SingleOrDefault(x => x.Id == editedTask.Id);
                if (trackedTask is null) continue;
                trackedTask.ScopeOfWork = editedTask.ScopeOfWork?.Trim() ?? string.Empty;
                trackedTask.WorkType = string.IsNullOrWhiteSpace(editedTask.WorkType) ? null : editedTask.WorkType;
                trackedTask.EstimatedDays = Math.Max(0, editedTask.EstimatedDays);
                trackedTask.CrewSizeOverride = editedTask.CrewSizeOverride is > 0 ? editedTask.CrewSizeOverride : null;
                trackedTask.DailyCrewCostOverride = editedTask.DailyCrewCostOverride is >= 0 ? editedTask.DailyCrewCostOverride : null;
                trackedTask.ContingencyPercentOverride = editedTask.ContingencyPercentOverride is >= 0 ? editedTask.ContingencyPercentOverride : null;
                trackedTask.TargetMarginPercentOverride = editedTask.TargetMarginPercentOverride is > 0 and < 100 ? editedTask.TargetMarginPercentOverride : null;
                trackedTask.UpdatedAt = DateTimeOffset.UtcNow;
            }

            if (version is not null && currentCostSnapshot is not null)
            {
                var trackedVersion = tracked.Versions.SingleOrDefault(x => x.Id == version.Id);
                var trackedSnapshot = trackedVersion?.CostSnapshots.SingleOrDefault(x => x.Id == currentCostSnapshot.Id);
                if (trackedVersion is not null && trackedSnapshot is not null)
                {
                    trackedSnapshot.TargetMarginPercent = decimal.Round(PricingTargetMargin, 4);
                    trackedSnapshot.SuggestedCustomerPrice = PricingBasePrice;
                    trackedSnapshot.PriceAdjustment = -PricingDiscountAmount;
                    trackedSnapshot.AdjustmentReason = pricingAdjustmentReason?.Trim();
                    trackedVersion.DiscountAmount = PricingDiscountAmount;
                    trackedVersion.TaxRate = decimal.Round(pricingTaxRate, 4);
                    foreach (var taskCost in trackedSnapshot.Tasks)
                    {
                        taskCost.TargetMarginPercent = trackedSnapshot.TargetMarginPercent;
                        taskCost.SuggestedCustomerPrice = decimal.Round(taskCost.TotalCost / (1 - trackedSnapshot.TargetMarginPercent / 100m), 2);
                    }
                }
            }

            await AddAuditEventAsync(db, quote,
                currentCostSnapshot is null
                    ? "Estimate saved, including Project Overview Notes and project-task scopes."
                    : $"Estimate saved with task details and pricing: {PricingTargetMargin:N0}% target margin, {discountValue}% promotional discount, {pricingTaxRate:N2}% tax, {PricingFinalPrice:C2} customer total.");
            await db.SaveChangesAsync();
            await PublishEstimateEventAsync("EstimateWorkspace", "SaveEstimate", "Completed", "Estimate overview, project tasks, and pricing saved.");
            message = currentCostSnapshot is null
                ? "Estimate saved."
                : $"Estimate and pricing saved. Customer total is {PricingFinalPrice:C2}.";
            await ReloadAsync();
        }
        finally
        {
            savingEstimate = false;
        }
    }

    private bool ValidatePricingInputs()
    {
        if (currentCostSnapshot is null) return true;
        if (pricingTargetMargin is <= 0 or >= 100)
        {
            message = "Enter a job target gross margin greater than 0% and less than 100%.";
            return false;
        }
        if (discountValue is < 0 or > 100 || pricingTaxRate is < 0 or > 100)
        {
            message = "Discount and tax rates must be between 0% and 100%.";
            return false;
        }
        var marginChanged = decimal.Round(pricingTargetMargin, 4) != decimal.Round(currentCostSnapshot.TargetMarginPercent, 4);
        if ((PricingDiscountAmount > 0 || marginChanged) && string.IsNullOrWhiteSpace(pricingAdjustmentReason))
        {
            message = "Enter a reason for the promotional discount or job-level margin change.";
            return false;
        }
        return true;
    }

    private async Task DeleteProjectTaskAsync(QuoteProjectTask task)
    {
        if (quote is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Do you really want to delete this task?");
        if (!confirmed) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        var tracked = await db.QuoteProjectTasks
            .SingleOrDefaultAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (tracked is null) return;

        var deletedTaskNumber = tracked.SortOrder;
        var deletedTaskType = tracked.TaskType;
        tracked.IsDeleted = true;
        tracked.DeletedAt = DateTimeOffset.UtcNow;
        tracked.UpdatedAt = tracked.DeletedAt.Value;
        tracked.SortOrder = int.MinValue + tracked.Id;
        await db.SaveChangesAsync();

        var remainingTasks = await db.QuoteProjectTasks
            .Where(x => x.QuoteCaseId == quote.Id)
            .OrderBy(x => x.SortOrder)
            .ToListAsync();
        for (var index = 0; index < remainingTasks.Count; index++)
        {
            remainingTasks[index].SortOrder = -(index + 1);
        }
        await db.SaveChangesAsync();
        for (var index = 0; index < remainingTasks.Count; index++)
        {
            remainingTasks[index].SortOrder = index + 1;
        }

        await AddAuditEventAsync(db, quote, $"Project Task {deletedTaskNumber} ({deletedTaskType}) removed from the active estimate; prior analysis and costing history retained.");
        await db.SaveChangesAsync();
        await transaction.CommitAsync();

        await PublishEstimateEventAsync("EstimateWorkspace", "DeleteProjectTask", "Completed", $"Project Task {deletedTaskNumber} deleted.");
        message = $"Project Task {deletedTaskNumber} deleted.";
        expandedTaskIds.Remove(task.Id);
        await ReloadAsync();
    }

