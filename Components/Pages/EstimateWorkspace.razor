                Quantity = item.AddedProductQuantity, Unit = product.PurchaseUnit, UnitCost = price.UnitPrice,
                MatchConfidence = 1, MatchKind = MaterialMatchKinds.Catalog, ReviewDecision = MaterialReviewDecisions.Accepted,
                SourceType = product.SupplyVendor.Name, SourceReference = price.SourceReference ?? price.SourceType,
                SourcePriceDate = price.EffectiveDate, IsEstimatorLocked = true,
                Notes = "Added and locked by the estimator while resolving a CENTCOM review item."
            });
        }
        else
        {
            existing.Quantity += item.AddedProductQuantity;
            existing.IsEstimatorLocked = true;
        }
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        trackedReview.Status = AnalysisReviewStatuses.Resolved;
        trackedReview.EstimatorResponse = item.EstimatorResponse?.Trim();
        trackedReview.ResolutionAction = "Catalog product added";
