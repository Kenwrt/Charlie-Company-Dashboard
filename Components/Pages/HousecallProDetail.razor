    private async Task SaveProgressAsync(){if(localJob is null)return;var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;await using var db=await DbContextFactory.CreateDbContextAsync();var progress=await db.HousecallProJobProgress.SingleOrDefaultAsync(x=>x.HousecallProJobId==localJob.Id);var oldPhase=progress?.CurrentPhase;if(progress is null){progress=new(){HousecallProJobId=localJob.Id};db.HousecallProJobProgress.Add(progress);}if(oldPhase!=progressInput.CurrentPhase)progress.PhaseEnteredAt=DateTimeOffset.UtcNow;progress.CurrentPhase=progressInput.CurrentPhase;progress.ExpectedPhaseCompletionDate=progressInput.ExpectedPhaseCompletionDate;progress.RevisedJobCompletionDate=progressInput.RevisedJobCompletionDate;progress.NextAction=Clean(progressInput.NextAction);progress.NextFollowUpDate=progressInput.NextFollowUpDate;progress.ResponsibleParty=Clean(progressInput.ResponsibleParty);progress.UpdatedAt=DateTimeOffset.UtcNow;progress.UpdatedBy=UserName(user);AddProgressEvent(db,localJob.Id,"Phase update",$"Job phase saved as {progress.CurrentPhase}.",user);await db.SaveChangesAsync();progressMessage="Job progress saved.";await ReloadLocalJobAsync();}
    private async Task AddBlockerAsync(){if(localJob is null||string.IsNullOrWhiteSpace(blockerInput.Description)){progressMessage="Enter a blocker description.";return;}var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;await using var db=await DbContextFactory.CreateDbContextAsync();db.HousecallProJobBlockers.Add(new(){HousecallProJobId=localJob.Id,BlockerType=blockerInput.BlockerType,Description=blockerInput.Description.Trim(),StartedOn=blockerInput.StartedOn,ExpectedResolutionDate=blockerInput.ExpectedResolutionDate,NextAction=Clean(blockerInput.NextAction),NextFollowUpDate=blockerInput.NextFollowUpDate,ResponsibleParty=Clean(blockerInput.ResponsibleParty),RevenueAtRisk=blockerInput.RevenueAtRisk,CreatedBy=UserName(user)});AddProgressEvent(db,localJob.Id,"Blocker opened",$"{blockerInput.BlockerType}: {blockerInput.Description.Trim()}",user);await db.SaveChangesAsync();progressMessage="Blocker added.";await ReloadLocalJobAsync();}
    private async Task ResolveBlockerAsync(int id){if(localJob is null)return;var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;await using var db=await DbContextFactory.CreateDbContextAsync();var item=await db.HousecallProJobBlockers.SingleOrDefaultAsync(x=>x.Id==id&&x.HousecallProJobId==localJob.Id);if(item is null)return;item.ResolvedOn=DateOnly.FromDateTime(DateTime.Today);item.ResolutionNotes="Marked resolved from the job progress workspace.";AddProgressEvent(db,localJob.Id,"Blocker resolved",$"{item.BlockerType}: {item.Description}",user);await db.SaveChangesAsync();progressMessage="Blocker resolved.";await ReloadLocalJobAsync();}
    private async Task SaveMilestoneAsync(){if(localJob is null||string.IsNullOrWhiteSpace(milestoneInput.Name)||milestoneInput.Amount<=0){progressMessage="Enter a milestone name and an amount greater than zero.";return;}var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;await using var db=await DbContextFactory.CreateDbContextAsync();HousecallProJobPaymentMilestone item;if(editingMilestoneId is null){item=new(){HousecallProJobId=localJob.Id};db.HousecallProJobPaymentMilestones.Add(item);}else{item=await db.HousecallProJobPaymentMilestones.SingleOrDefaultAsync(x=>x.Id==editingMilestoneId&&x.HousecallProJobId==localJob.Id)??throw new InvalidOperationException("The payment milestone could not be found.");}item.Name=milestoneInput.Name.Trim();item.TriggerPhase=milestoneInput.TriggerPhase;item.ExpectedPaymentDate=milestoneInput.ExpectedPaymentDate;item.Amount=milestoneInput.Amount;item.Status=milestoneInput.Status;item.PaidOn=item.Status=="Paid"?item.PaidOn??DateOnly.FromDateTime(DateTime.Today):null;item.UpdatedAt=DateTimeOffset.UtcNow;var action=editingMilestoneId is null?"added":"edited";AddProgressEvent(db,localJob.Id,$"Payment milestone {action}",$"{item.Name} · {item.Amount:C2} · {item.Status}",user);await db.SaveChangesAsync();milestoneInput=new();editingMilestoneId=null;progressMessage=$"Payment milestone {action}.";await ReloadLocalJobAsync();}
    private void EditMilestone(HousecallProJobPaymentMilestone item){editingMilestoneId=item.Id;milestoneInput=new(){Name=item.Name,TriggerPhase=item.TriggerPhase,ExpectedPaymentDate=item.ExpectedPaymentDate,Amount=item.Amount,Status=item.Status};progressMessage="Update the milestone fields and select Save.";}
    private void CancelMilestoneEdit(){editingMilestoneId=null;milestoneInput=new();progressMessage=null;}
    private async Task ApplyStandardPaymentTemplateAsync(){if(localJob is null)return;if(localJob.PaymentMilestones.Count>0){progressMessage="A payment schedule already exists. Edit the current milestones instead.";return;}if(localJob.JobPrice<=0){progressMessage="A contract price is required before the standard payment schedule can be applied.";return;}var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;var today=DateOnly.FromDateTime(DateTime.Today);var designFee=Math.Min(1500m,localJob.JobPrice);var remaining=Math.Max(0,localJob.JobPrice-designFee);var startPayment=Math.Round(remaining*0.30m,2,MidpointRounding.AwayFromZero);var finalPayment=remaining-startPayment;var constructionDate=localJob.ScheduledStart is null?localJob.Progress?.ExpectedPhaseCompletionDate:DateOnly.FromDateTime(localJob.ScheduledStart.Value.LocalDateTime);var finalDate=localJob.Progress?.RevisedJobCompletionDate??(localJob.ScheduledEnd is null?null:DateOnly.FromDateTime(localJob.ScheduledEnd.Value.LocalDateTime));await using var db=await DbContextFactory.CreateDbContextAsync();var items=new[]{new HousecallProJobPaymentMilestone{HousecallProJobId=localJob.Id,Name="Design fee",TriggerPhase="Design",ExpectedPaymentDate=today,Amount=designFee,Status="Pending"},new HousecallProJobPaymentMilestone{HousecallProJobId=localJob.Id,Name="Job start payment",TriggerPhase="Day One",ExpectedPaymentDate=constructionDate,Amount=startPayment,Status="Pending"},new HousecallProJobPaymentMilestone{HousecallProJobId=localJob.Id,Name="Final balance",TriggerPhase="Final Payment",ExpectedPaymentDate=finalDate,Amount=finalPayment,Status="Pending"}};db.HousecallProJobPaymentMilestones.AddRange(items.Where(item=>item.Amount>0));AddProgressEvent(db,localJob.Id,"Payment schedule applied",$"Standard schedule created from the {localJob.JobPrice:C2} contract price.",user);await db.SaveChangesAsync();progressMessage="Standard payment schedule applied. Review and edit the dates or amounts as needed.";await ReloadLocalJobAsync();}
    private async Task AdvanceMilestoneAsync(int id){if(localJob is null)return;var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;await using var db=await DbContextFactory.CreateDbContextAsync();var item=await db.HousecallProJobPaymentMilestones.SingleOrDefaultAsync(x=>x.Id==id&&x.HousecallProJobId==localJob.Id);if(item is null)return;var index=Array.IndexOf(JobProgressOptions.MilestoneStatuses,item.Status);item.Status=JobProgressOptions.MilestoneStatuses[Math.Min(index+1,JobProgressOptions.MilestoneStatuses.Length-1)];item.UpdatedAt=DateTimeOffset.UtcNow;if(item.Status=="Paid")item.PaidOn=DateOnly.FromDateTime(DateTime.Today);AddProgressEvent(db,localJob.Id,"Payment milestone updated",$"{item.Name} advanced to {item.Status}.",user);await db.SaveChangesAsync();progressMessage="Payment milestone updated.";await ReloadLocalJobAsync();}
