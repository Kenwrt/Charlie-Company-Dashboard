    public async ValueTask DisposeAsync()
    {
        analysisMonitorCancellation?.Cancel();
        try
        {
            await JS.InvokeVoidAsync("ccvDictation.stop");
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit has already disconnected.
        }
        dictationReference?.Dispose();
        analysisMonitorCancellation?.Dispose();
    }

