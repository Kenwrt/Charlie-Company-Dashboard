    private async Task SelectReplacementFromCatalogAsync(QuoteTaskAnalysis analysis, QuoteTaskAnalysisMaterial material, string? value)
    {
        if (quote is null || analysis.Status != QuoteTaskAnalysisStatuses.NeedsReview || material.Id == 0) return;
        var replacementId = int.TryParse(value, out var selected) ? selected : 0;
        if (replacementId == 0) return;
        replacingMaterialIds.Add(material.Id);
        message = "Applying the selected catalog replacement…";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.QuoteTaskAnalysisMaterials
                .Include(x => x.QuoteTaskAnalysis).ThenInclude(x => x.QuoteProjectTask)
                .SingleOrDefaultAsync(x => x.Id == material.Id && x.QuoteTaskAnalysisId == analysis.Id && x.QuoteTaskAnalysis.QuoteProjectTask.QuoteCaseId == quote.Id);
            var replacement = await db.VendorProducts.Include(x => x.Product).Include(x => x.SupplyVendor).Include(x => x.Prices)
                .SingleOrDefaultAsync(x => x.Id == replacementId && x.IsActive && x.SupplyVendor.IsActive);
            if (tracked is null) { message = "The estimate material could not be found. Reload the workspace and try again."; return; }
            if (replacement is null) { message = "The selected catalog item is no longer active."; return; }
            var price = CurrentCatalogPrice(replacement);
            if (price is null) { message = "The selected catalog item has no active price and cannot be applied."; return; }

            var replacementDescription = replacement.VendorDescription ?? replacement.Product.Name;
            tracked.Quantity = ReplacementPurchaseQuantity(tracked, replacementDescription, replacement.PurchaseUnit);
            tracked.VendorProductId = replacement.Id;
            tracked.VendorSku = replacement.VendorSku;
            tracked.Description = replacementDescription;
            tracked.Unit = replacement.PurchaseUnit;
            tracked.UnitCost = price.UnitPrice;
            tracked.MatchConfidence = 1;
            tracked.MatchKind = MaterialMatchKinds.Catalog;
            tracked.ReviewDecision = MaterialReviewDecisions.Replaced;
            tracked.IsRemoved = false;
            tracked.IsUnmatched = false;
            tracked.IsEstimatorLocked = true;
            tracked.SourceType = replacement.SupplyVendor.Name;
            tracked.SourceReference = price.SourceReference ?? price.SourceType;
            tracked.SourcePriceDate = price.EffectiveDate;
            var currentUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await SaveReusableMaterialRuleAsync(db, tracked, currentUser.FindFirstValue(ClaimTypes.NameIdentifier));
            await db.SaveChangesAsync();
            message = $"Replaced the proposed item with {replacement.Product.Name}; quantity and pricing were recalculated.";
            await ReloadAsync();
        }
        finally
        {
            replacingMaterialIds.Remove(material.Id);
        }
    }

    private static decimal ReplacementPurchaseQuantity(QuoteTaskAnalysisMaterial material, string replacementDescription, string purchaseUnit)
    {
        if (!purchaseUnit.Equals("Each", StringComparison.OrdinalIgnoreCase) &&
            !purchaseUnit.Equals("Piece", StringComparison.OrdinalIgnoreCase))
            return material.Quantity;

        var lengthMatch = System.Text.RegularExpressions.Regex.Match(
            replacementDescription,
            @"\b\d+(?:\.\d+)?\s*x\s*\d+(?:\.\d+)?\s*x\s*(?<length>\d+(?:\.\d+)?)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!lengthMatch.Success ||
            !decimal.TryParse(lengthMatch.Groups["length"].Value, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var boardLength) || boardLength <= 0)
            return material.Quantity;

        var wasLinearDemand = material.Unit.Contains("linear", StringComparison.OrdinalIgnoreCase);
        var recoveredDeckingDemand = material.Quantity >= 100 &&
            (material.OriginalDescription?.Contains("decking", StringComparison.OrdinalIgnoreCase) == true) &&
            (material.Description.Contains("screw", StringComparison.OrdinalIgnoreCase) ||
             material.Description.Contains("fastener", StringComparison.OrdinalIgnoreCase) ||
             material.Description.Contains("plug", StringComparison.OrdinalIgnoreCase));

        return wasLinearDemand || recoveredDeckingDemand
            ? decimal.Ceiling(material.Quantity / boardLength)
            : material.Quantity;
    }

