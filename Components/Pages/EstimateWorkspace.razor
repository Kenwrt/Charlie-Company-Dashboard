@page "/estimates/{QuoteId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,LocalOperator")]
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject OperationAccessService OperationAccess
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OperationalEventPublisher OperationalEvents
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Preliminary Estimate</PageTitle>

@if (quote is null)
{
    <h1>Estimate not found</h1>
    <p>This estimate is not available to your assigned locations.</p>
}
else
{
    <section class="dashboard-shell">
        <div class="dashboard-header estimate-form-header">
            <div>
                <p class="eyebrow">@quote.LocalOperation.Name</p>
                <h1>Preliminary Estimate</h1>
                <p class="dashboard-subtitle">
                    Housecall Pro Estimate #@(quote.HousecallProEstimateNumber ?? "Not provided")
                </p>
            </div>
            <div class="dashboard-status">
                <span>@quote.Status</span>
                <small>Version @version?.VersionNumber</small>
            </div>
        </div>

        <p><a href="estimates">Back to estimates</a></p>

        @if (message is not null)
        {
            <div class="alert alert-info">@message</div>
        }

        <section class="activity-panel estimate-customer-panel">
            <p class="eyebrow">On-site inspection</p>
            <div class="row g-4">
                <div class="col-md-6">
                    <span class="form-label">Prepared for</span>
                    <h2 class="mb-1">@quote.CustomerName</h2>
                </div>
                <div class="col-md-6">
                    <span class="form-label">Project address</span>
                    <p class="fs-5 mb-0">@(quote.CustomerAddress ?? "Address not provided")</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(quote.CustomerEmail))
                {
                    <div class="col-md-6">
                        <span class="form-label">Customer email</span>
                        <p class="mb-0">@quote.CustomerEmail</p>
                    </div>
                }
                <div class="col-md-6">
                    <span class="form-label">Estimate date</span>
                    <p class="mb-0">@quote.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")</p>
                </div>
            </div>
        </section>

        <section class="activity-panel">
            <h2>Project Overview Notes</h2>
            <p class="dashboard-subtitle">
                Record the overall customer request, site context, project goals, constraints, and other information that applies to the entire estimate.
            </p>
            <div class="dictation-input-wrapper">
                <InputTextArea id="project-overview-notes"
                               class="form-control project-overview-notes"
                               rows="6"
                               maxlength="2000"
                               @bind-Value="quote.WorkDescription"
                               placeholder="Dictate or enter a general description of the project to be done." />
                <button type="button"
                        class="dictation-toggle @(IsDictating(ProjectOverviewElementId) ? "active" : null)"
                        aria-label="@(IsDictating(ProjectOverviewElementId) ? "Stop project overview dictation" : "Start project overview dictation")"
                        aria-pressed="@IsDictating(ProjectOverviewElementId)"
                        title="@(IsDictating(ProjectOverviewElementId) ? "Stop dictation" : "Start dictation")"
                        @onclick="() => ToggleDictationAsync(ProjectOverviewElementId)">
                    <span aria-hidden="true">🎙</span>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(GetDictationMessage(ProjectOverviewElementId)))
            {
                <small class="@(IsDictating(ProjectOverviewElementId) ? "text-danger" : "text-muted") d-block mt-2">@GetDictationMessage(ProjectOverviewElementId)</small>
            }
            <small class="text-muted d-block mt-2">These notes apply to every project task in this estimate.</small>
        </section>

        <section class="activity-panel">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h2>Project Tasks</h2>
                    <p class="dashboard-subtitle mb-0">
                        Add every distinct part of the project. CentCom will analyze each task’s photographs and dictated scope of work separately.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <InputSelect class="form-select" @bind-Value="newTaskType">
                        <option value="">Select task type</option>
                        @foreach (var taskType in ProjectTaskTypes.All)
                        {
                            <option value="@taskType">@taskType</option>
                        }
                    </InputSelect>
                    <button type="button"
                            class="btn btn-primary text-nowrap"
                            disabled="@string.IsNullOrWhiteSpace(newTaskType)"
                            @onclick="AddProjectTaskAsync">
                        Add Project Task
                    </button>
                </div>
            </div>
        </section>

        @if (quote.ProjectTasks.Count == 0)
        {
            <section class="activity-panel">
                <p class="mb-0">No project tasks have been added. Select a project task type above to begin.</p>
            </section>
        }

        @{
            var orderedTasks = quote.ProjectTasks.OrderBy(x => x.SortOrder).ToList();
        }
        @for (var taskIndex = 0; taskIndex < orderedTasks.Count; taskIndex++)
        {
            var task = orderedTasks[taskIndex];
            var taskNumber = taskIndex + 1;
            <section class="activity-panel project-task-panel" @key="task.Id">
                <button type="button"
                        class="project-task-toggle"
                        aria-expanded="@expandedTaskIds.Contains(task.Id)"
                        @onclick="() => ToggleProjectTask(task.Id)">
                    <div class="project-task-toggle-title">
                        <small>Project Task @taskNumber</small>
                        <h2>@task.TaskType</h2>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-light">@task.Photos.Count photo(s)</span>
                        <span class="project-task-chevron" aria-hidden="true">@(expandedTaskIds.Contains(task.Id) ? "−" : "+")</span>
                    </div>
                </button>

                @if (expandedTaskIds.Contains(task.Id))
                {
                    var analysis = LatestAnalysis(task);
                    <div class="project-task-body">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Work type</label>
                                <InputSelect class="form-select" @bind-Value="task.WorkType">
                                    <option value="">Select work type…</option>
                                    @foreach (var workType in ProjectWorkTypes.All) { <option value="@workType">@workType</option> }
                                </InputSelect>
                                <small class="text-muted">Controls the applicable supply kit, crew rate, and target margin.</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Scope of Work</label>
                                @{
                                    var taskScopeElementId = $"task-scope-{task.Id}";
                                }
                                <div class="dictation-input-wrapper">
                                    <InputTextArea id="@taskScopeElementId"
                                                   class="form-control estimate-notes-input"
                                                   rows="7"
                                                   maxlength="4000"
                                                   @bind-Value="task.ScopeOfWork"
                                                   placeholder="Dictate or enter what needs to be done for this project task, including dimensions, existing conditions, selections, exclusions, and special instructions…" />
                                    <button type="button"
                                            class="dictation-toggle @(IsDictating(taskScopeElementId) ? "active" : null)"
                                            aria-label="@(IsDictating(taskScopeElementId) ? $"Stop {task.TaskType} scope dictation" : $"Start {task.TaskType} scope dictation")"
                                            aria-pressed="@IsDictating(taskScopeElementId)"
                                            title="@(IsDictating(taskScopeElementId) ? "Stop dictation" : "Start dictation")"
                                            @onclick="() => ToggleDictationAsync(taskScopeElementId)">
                                        <span aria-hidden="true">🎙</span>
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(GetDictationMessage(taskScopeElementId)))
                                {
                                    <small class="@(IsDictating(taskScopeElementId) ? "text-danger" : "text-muted") d-block mt-2">@GetDictationMessage(taskScopeElementId)</small>
                                }
                                <small class="text-muted">Voice dictation can use the device’s built-in microphone or keyboard dictation.</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Estimated job days</label>
                                <InputNumber class="form-control" min="0" step="0.5" @bind-Value="task.EstimatedDays" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Crew size override</label>
                                <InputNumber class="form-control" min="0" step="0.5" @bind-Value="task.CrewSizeOverride" />
                                <small class="text-muted">Leave blank for policy default.</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Daily crew cost override</label>
                                <InputNumber class="form-control" min="0" step="1" @bind-Value="task.DailyCrewCostOverride" />
                                <small class="text-muted">Leave blank for policy default.</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Contingency % override</label>
                                <InputNumber class="form-control" min="0" step="0.5" @bind-Value="task.ContingencyPercentOverride" />
                                <small class="text-muted">Leave blank for policy default.</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Target margin % override</label>
                                <InputNumber class="form-control" min="0" max="99.99" step="0.5" @bind-Value="task.TargetMarginPercentOverride" />
                                <small class="text-muted">Leave blank for the task margin rule.</small>
                            </div>
                        </div>

                <div class="picture-capture-panel mt-4">
                    <h3>@task.TaskType Picture Guide</h3>
                    <p class="text-muted">Complete every required photograph. Use natural light, keep measurements straight, and make both the zero point and endpoint clearly readable.</p>
                    <div class="photo-requirement-grid">
                        @foreach (var requirement in ProjectPhotoGuidance.For(task.TaskType))
                        {
                            var captured = task.Photos.Where(x => x.RequirementKey == requirement.Key).OrderByDescending(x => x.CapturedAt).ToList();
                            <article class="photo-requirement-card">
                                <div class="photo-guide-preview @PhotoGuidePanelClass(requirement.Key)">
                                    <div class="photo-guide-overlay">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <strong>@requirement.Label</strong>
                                            <span class="badge @(captured.Count > 0 ? "text-bg-success" : "text-bg-warning")">
                                                @(captured.Count > 0 ? "Complete" : "Required")
                                            </span>
                                        </div>
                                        <p>@requirement.Instructions</p>
                                    </div>
                                </div>
                                <InputFile class="form-control"
                                           OnChange="args => CapturePicturesAsync(task, requirement, args)"
                                           accept="image/*"
                                           capture="environment" />
                                @foreach (var photo in captured)
                                {
                                    <small class="d-block mt-2">📷 @photo.OriginalFileName · @FormatFileSize(photo.FileSize)</small>
                                }
                            </article>
                        }
                    </div>
                    @if (task.Photos.Any(x => x.RequirementKey == "additional"))
                    {
                        <h4 class="mt-4">Additional Photographs</h4>
                        <div class="project-photo-list mt-3">
                            @foreach (var photo in task.Photos.Where(x => x.RequirementKey == "additional").OrderBy(x => x.CapturedAt))
                            {
                                <div class="project-photo-item">
                                    <span aria-hidden="true">📷</span>
                                    <div>
                                        <strong>@photo.OriginalFileName</strong>
                                        <small>@FormatFileSize(photo.FileSize) · @photo.CapturedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-3">
                        <label class="form-label">Optional additional photographs</label>
                        <InputFile class="form-control"
                                   OnChange="args => CapturePicturesAsync(task, AdditionalPhotoRequirement, args)"
                                   accept="image/*"
                                   capture="environment"
                                   multiple />
                    </div>
                </div>
                        <div class="border rounded p-3 mt-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <h3 class="mb-1">CentCom Analysis</h3>
                                    <p class="text-muted mb-0">
                                        Revisioned material quantities and provisional costs for this project task.
                                    </p>
                                </div>
                                <span class="badge @AnalysisStatusClass(analysis?.Status)">
                                    @(analysis?.Status ?? QuoteTaskAnalysisStatuses.NotSubmitted)
                                </span>
                            </div>

                            @if (analysis is null)
                            {
                                <div class="alert alert-light border mt-3 mb-0">
                                    This task has not been submitted to CentCom.
                                </div>
                            }
                            else
                            {
                                <dl class="row mt-3 mb-2">
                                    <dt class="col-sm-3">Revision</dt>
                                    <dd class="col-sm-9">@analysis.RevisionNumber</dd>
                                    <dt class="col-sm-3">Submitted</dt>
                                    <dd class="col-sm-9">@analysis.SubmittedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</dd>
                                    <dt class="col-sm-3">Model</dt>
                                    <dd class="col-sm-9">@(analysis.ModelVersion ?? "Pending")</dd>
                                </dl>

                                @if (!string.IsNullOrWhiteSpace(analysis.Assumptions))
                                {
                                    <h4>Assumptions</h4>
                                    <p class="preserve-lines">@analysis.Assumptions</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(analysis.QuestionsAndWarnings))
                                {
                                    <div class="alert alert-warning">
                                        <strong>Questions and warnings</strong>
                                        <div class="preserve-lines">@analysis.QuestionsAndWarnings</div>
                                    </div>
                                }
                                @if (analysis.Exclusions.Count > 0)
                                {
                                    <div class="alert alert-secondary">
                                        <strong>Excluded by costing policy</strong>
                                        <ul class="mb-0 mt-2">
                                            @foreach (var excluded in analysis.Exclusions.OrderBy(x => x.Description))
                                            {
                                                <li>@excluded.Description — @excluded.Reason</li>
                                            }
                                        </ul>
                                        <small>These entries are retained for audit purposes but are not included in the material subtotal.</small>
                                    </div>
                                }

                                @if (analysis.Materials.Count == 0)
                                {
                                    <p class="text-muted">No material recommendations have been returned yet.</p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead>
                                                <tr>
                                                    <th>SKU / Material</th>
                                                    <th>Quantity</th>
                                                    <th>Unit cost</th>
                                                    <th>Waste</th>
                                                    <th>Extended</th>
                                                    <th>Source</th>
                                                    <th>Confidence</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in analysis.Materials.OrderBy(x => x.SortOrder))
                                                {
                                                    <tr class="@(item.IsUnmatched ? "table-warning" : null)">
                                                        <td>
                                                            <strong>@(item.VendorSku ?? "Unmatched")</strong><br />
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputText class="form-control form-control-sm" @bind-Value="item.Description" />
                                                            }
                                                            else
                                                            {
                                                                <small>@item.Description</small>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.Quantity" />
                                                                <InputText class="form-control form-control-sm mt-1" @bind-Value="item.Unit" />
                                                            }
                                                            else
                                                            {
                                                                @($"{item.Quantity:N2} {item.Unit}")
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.UnitCost" />
                                                            }
                                                            else
                                                            {
                                                                @item.UnitCost.ToString("C2")
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.WastePercent" />
                                                            }
                                                            else
                                                            {
                                                                @($"{item.WastePercent:N1}%")
                                                            }
                                                        </td>
                                                        <td>@item.ExtendedCost.ToString("C2")</td>
                                                        <td>
                                                            @(item.SourceReference ?? item.SourceType ?? "Not supplied")
                                                            @if (item.SourcePriceDate is not null)
                                                            {
                                                                <br /><small>@item.SourcePriceDate.Value.ToString("MM/dd/yyyy")</small>
                                                            }
                                                        </td>
                                                        <td>@item.MatchConfidence.ToString("P0")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th colspan="4">Material subtotal</th>
                                                    <th>@analysis.MaterialSubtotal.ToString("C2")</th>
                                                    <th colspan="2"></th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <strong>Delivery</strong><br />
                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                            {
                                                <InputNumber class="form-control form-control-sm" @bind-Value="analysis.DeliveryAllowance" />
                                            }
                                            else
                                            {
                                                @analysis.DeliveryAllowance.ToString("C2")
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Tax</strong><br />
                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                            {
                                                <InputNumber class="form-control form-control-sm" @bind-Value="analysis.TaxAllowance" />
                                            }
                                            else
                                            {
                                                @analysis.TaxAllowance.ToString("C2")
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Other allowances</strong><br />
                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                            {
                                                <InputNumber class="form-control form-control-sm" @bind-Value="analysis.OtherAllowance" />
                                            }
                                            else
                                            {
                                                @analysis.OtherAllowance.ToString("C2")
                                            }
                                        </div>
                                        <div class="col-md-3"><strong>Task total</strong><br />@analysis.TotalCost.ToString("C2")</div>
                                    </div>
                                }
                            }

                            <div class="d-flex gap-2 flex-wrap mt-3">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        disabled="@(!CanSubmitAnalysis(analysis))"
                                        @onclick="() => SubmitTaskAnalysisAsync(task)">
                                    @(analysis is null ? "Analyze" : "Reanalyze")
                                </button>
                                @if (analysis?.Status == QuoteTaskAnalysisStatuses.NeedsReview)
                                {
                                    <button type="button" class="btn btn-success" @onclick="() => ReviewAnalysisAsync(analysis, true)">Accept</button>
                                    @if (editingAnalysisIds.Contains(analysis.Id))
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="() => SaveAnalysisEditsAsync(analysis)">Save edits</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => CancelAnalysisEditsAsync(analysis.Id)">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => editingAnalysisIds.Add(analysis.Id)">Edit</button>
                                    }
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => ReviewAnalysisAsync(analysis, false)">Reject</button>
                                }
                            </div>
                        </div>
                        <div class="project-task-actions">
                            <button type="button"
                                    class="btn btn-primary"
                                    @onclick="() => SaveProjectTaskAsync(task)">
                                Save Project Task
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    @onclick="() => DeleteProjectTaskAsync(task)">
                                Delete Task
                            </button>
                        </div>
                    </div>
                }
            </section>
        }

        <section class="activity-panel">
            <h2>Job Cost Summary</h2>
            <p class="dashboard-subtitle">
                Accepted CentCom material costs combined with the effective labor, task overhead, project overhead, contingency, and margin policy.
            </p>
            @{
                var acceptedAnalyses = AcceptedAnalyses().ToList();
            }
            @if (acceptedAnalyses.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No CentCom task analyses have been accepted yet.
                </div>
            }
            else if (currentCostSnapshot is null)
            {
                <div class="alert alert-warning">No immutable cost snapshot has been created for this estimate version.</div>
                <button class="btn btn-primary" @onclick="CreateCostSnapshotAsync">Price using current policy</button>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Task</th><th>CentCom materials</th><th>Required supplies</th><th>Labor</th><th>Task costs</th><th>Allocated overhead</th><th>Margin</th><th>Suggested price</th></tr></thead>
                        <tbody>
                            @foreach (var taskCost in currentCostSnapshot.Tasks.OrderBy(x => x.QuoteProjectTask.SortOrder))
                            {
                                <tr>
                                    <td>Task @taskCost.QuoteProjectTask.SortOrder - @taskCost.QuoteProjectTask.TaskType<br /><small>@(taskCost.QuoteProjectTask.WorkType ?? "Unclassified") · @taskCost.EstimatedDays:N1 day(s), @taskCost.CrewSize:N1 crew</small></td>
                                    <td>@taskCost.MaterialCost.ToString("C2")</td>
                                    <td>
                                        @taskCost.RequiredSupplyCost.ToString("C2")
                                        @if (taskCost.RequiredSupplies.Count > 0)
                                        {
                                            <details><summary>@taskCost.RequiredSupplies.Count item(s)</summary><ul class="small mb-0">@foreach (var item in taskCost.RequiredSupplies) { <li>@item.KitName: @item.Description — @item.Quantity.ToString("N2") × @item.UnitCost.ToString("C2")</li> }</ul></details>
                                        }
                                    </td>
                                    <td>@taskCost.LaborCost.ToString("C2")</td>
                                    <td>@taskCost.TaskOverhead.ToString("C2")</td>
                                    <td>@taskCost.AllocatedProjectOverhead.ToString("C2")</td>
                                    <td>@taskCost.TargetMarginPercent.ToString("N2")%</td>
                                    <td><strong>@taskCost.SuggestedCustomerPrice.ToString("C2")</strong><br /><small>Cost @taskCost.TotalCost.ToString("C2")</small></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="7">Project overhead allocated across tasks</th><th>@currentCostSnapshot.ProjectOverhead.ToString("C2")</th>
                            </tr>
                            <tr>
                                <th colspan="7">Fully burdened project cost</th><th>@currentCostSnapshot.TotalCost.ToString("C2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="metric-grid mt-3">
                    <article class="metric-card"><span>Target margin</span><strong>@($"{currentCostSnapshot.TargetMarginPercent:N2}%")</strong></article>
                    <article class="metric-card"><span>Suggested price</span><strong>@currentCostSnapshot.SuggestedCustomerPrice.ToString("C2")</strong></article>
                    <article class="metric-card"><span>Expected gross profit</span><strong>@currentCostSnapshot.ExpectedGrossProfit.ToString("C2")</strong></article>
                    <article class="metric-card accent-revenue"><span>Effective margin</span><strong>@($"{currentCostSnapshot.EffectiveMarginPercent:N2}%")</strong></article>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-3"><label class="form-label">Price adjustment</label><InputNumber class="form-control" @bind-Value="currentCostSnapshot.PriceAdjustment" /></div>
                    <div class="col-md-6"><label class="form-label">Adjustment reason</label><InputText class="form-control" @bind-Value="currentCostSnapshot.AdjustmentReason" /></div>
                    <div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-outline-primary" @onclick="SavePriceAdjustmentAsync">Save adjustment</button><button class="btn btn-outline-secondary" @onclick="CreateCostSnapshotAsync">Reprice</button></div>
                </div>
                <small class="text-muted d-block mt-3">Snapshot revision @currentCostSnapshot.RevisionNumber · Policy @currentCostSnapshot.CostingPolicyVersion.Name r@currentCostSnapshot.CostingPolicyVersion.RevisionNumber · @currentCostSnapshot.PricedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small>
            }
        </section>

        @if (version is not null)
        {
            <section class="activity-panel">
                <h2>Pricing</h2>
                <div class="metric-grid">
                    <article class="metric-card">
                        <span>Subtotal</span>
                        <strong>@version.Subtotal.ToString("C2")</strong>
                    </article>
                    <article class="metric-card">
                        <span>Discount</span>
                        <strong>@version.DiscountAmount.ToString("C2")</strong>
                    </article>
                    <article class="metric-card">
                        <span>Tax</span>
                        <strong>@version.TaxAmount.ToString("C2")</strong>
                    </article>
                    <article class="metric-card accent-revenue">
                        <span>Total Price</span>
                        <strong>@version.Total.ToString("C2")</strong>
                    </article>
                </div>

                @if (version.Lines.Count == 0)
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        Material quantities and calculated pricing will appear after project-task photographs and scope notes are analyzed.
                    </div>
                }

                @if (version.Status == "Draft")
                {
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-primary" @onclick="SubmitForReviewAsync">Submit Estimate to CentCom</button>
                        <button class="btn btn-success" disabled="@(version.Lines.Count == 0)" @onclick="ApproveAsync">Approve estimate</button>
                        <button class="btn btn-outline-danger" @onclick="RejectAsync">Reject</button>
                    </div>
                }
                else if (version.Status == "Approved")
                {
                    <button class="btn btn-outline-primary mt-3" @onclick="CreateRevisionAsync">Create revision</button>
                    <div class="alert alert-success mt-2">Approved version is locked. Customer delivery remains disabled.</div>
                }
            </section>
        }

        <details class="activity-panel">
            <summary><strong>Audit history</strong></summary>
            <div class="activity-list mt-3">
                @foreach (var item in quote.AuditEvents.OrderByDescending(x => x.OccurredAt))
                {
                    <div class="activity-item">
                        <div>
                            <strong>@item.PreviousStatus → @item.NewStatus</strong>
                            <span>@item.Explanation</span>
                        </div>
                        <time>@item.OccurredAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                    </div>
                }
            </div>
        </details>

        <section class="estimate-save-bar">
            <button type="button"
                    class="btn btn-primary btn-lg"
                    disabled="@savingEstimate"
                    @onclick="SaveEstimateAsync">
                @(savingEstimate ? "Saving Estimate…" : "Save Estimate")
            </button>
        </section>
    </section>
}

@code {
    [Parameter] public int QuoteId { get; set; }

    private QuoteCase? quote;
    private QuoteVersion? version;
    private QuoteCostSnapshot? currentCostSnapshot;
    private string? message;
    private string newTaskType = string.Empty;
    private readonly HashSet<int> expandedTaskIds = [];
    private readonly HashSet<int> editingAnalysisIds = [];
    private readonly Dictionary<string, string?> dictationMessages = [];
    private bool savingEstimate;
    private string? activeDictationElementId;
    private DotNetObjectReference<EstimateWorkspace>? dictationReference;
    private CancellationTokenSource? analysisMonitorCancellation;
    private Task? analysisMonitorTask;
    private const string ProjectOverviewElementId = "project-overview-notes";
    private static readonly ProjectPhotoRequirement AdditionalPhotoRequirement =
        new("additional", "Additional Photo", "Additional project context.");

    protected override async Task OnParametersSetAsync()
    {
        expandedTaskIds.Clear();
        await ReloadAsync();
        StartAnalysisMonitoringIfNeeded();
    }

    private void ToggleProjectTask(int taskId)
    {
        if (!expandedTaskIds.Remove(taskId))
        {
            expandedTaskIds.Add(taskId);
        }
    }

    private bool IsDictating(string elementId) =>
        string.Equals(activeDictationElementId, elementId, StringComparison.Ordinal);

    private string? GetDictationMessage(string elementId) =>
        dictationMessages.GetValueOrDefault(elementId);

    private async Task ToggleDictationAsync(string elementId)
    {
        dictationReference ??= DotNetObjectReference.Create(this);
        var result = await JS.InvokeAsync<DictationToggleResult>(
            "ccvDictation.toggle",
            elementId,
            dictationReference);
        activeDictationElementId = result.Active ? elementId : null;
        dictationMessages[elementId] = result.Supported
            ? (result.Active ? "Listening… Click the microphone again to stop." : null)
            : "Dictation is not supported by this browser. Use Chrome or Edge, or use your device’s keyboard dictation.";
    }

    [JSInvokable]
    public Task OnDictationStateChanged(string elementId, bool active, string? error)
    {
        activeDictationElementId = active ? elementId : null;
        dictationMessages[elementId] = !string.IsNullOrWhiteSpace(error)
            ? error
            : (active ? "Listening… Click the microphone again to stop." : null);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        var allowed = (await OperationAccess.GetAccessibleOperationsAsync()).Select(x => x.Id).ToList();
        await using var db = await DbFactory.CreateDbContextAsync();
        quote = await db.QuoteCases.AsNoTracking().AsSplitQuery()
            .Include(x => x.LocalOperation)
            .Include(x => x.Versions).ThenInclude(x => x.Lines)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.CostingPolicyVersion)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.Tasks).ThenInclude(x => x.QuoteProjectTask)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.Tasks).ThenInclude(x => x.RequiredSupplies)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Photos)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Materials)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Exclusions)
            .Include(x => x.AuditEvents)
            .SingleOrDefaultAsync(x => x.Id == QuoteId && allowed.Contains(x.LocalOperationId));
        version = quote?.Versions.OrderByDescending(x => x.VersionNumber).FirstOrDefault();
        currentCostSnapshot = version?.CostSnapshots.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();
    }

    private static QuoteTaskAnalysis? LatestAnalysis(QuoteProjectTask task) =>
        task.Analyses.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();

    private IEnumerable<QuoteTaskAnalysis> AcceptedAnalyses() =>
        quote?.ProjectTasks
            .Select(task => task.Analyses
                .Where(x => x.Status == QuoteTaskAnalysisStatuses.Accepted)
                .OrderByDescending(x => x.RevisionNumber)
                .FirstOrDefault())
            .Where(x => x is not null)
            .Select(x => x!) ?? [];

    private static bool CanSubmitAnalysis(QuoteTaskAnalysis? analysis) =>
        analysis?.Status is not QuoteTaskAnalysisStatuses.Queued and not QuoteTaskAnalysisStatuses.Processing;

    private static string AnalysisStatusClass(string? status) => status switch
    {
        QuoteTaskAnalysisStatuses.Accepted => "text-bg-success",
        QuoteTaskAnalysisStatuses.NeedsReview => "text-bg-warning",
        QuoteTaskAnalysisStatuses.Rejected or QuoteTaskAnalysisStatuses.Failed => "text-bg-danger",
        QuoteTaskAnalysisStatuses.Queued or QuoteTaskAnalysisStatuses.Processing => "text-bg-primary",
        _ => "text-bg-secondary"
    };

    private async Task SubmitTaskAnalysisAsync(QuoteProjectTask task)
    {
        if (quote is null || string.IsNullOrWhiteSpace(task.ScopeOfWork))
        {
            message = "Enter and save the task scope of work before requesting CentCom analysis.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var revision = (await db.QuoteTaskAnalyses
            .Where(x => x.QuoteProjectTaskId == task.Id)
            .Select(x => (int?)x.RevisionNumber)
            .MaxAsync() ?? 0) + 1;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var analysis = new QuoteTaskAnalysis
        {
            QuoteProjectTaskId = task.Id,
            RevisionNumber = revision,
            Status = QuoteTaskAnalysisStatuses.Queued,
            SubmittedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier)
        };
        db.QuoteTaskAnalyses.Add(analysis);
        db.QuoteProcessingJobs.Add(new QuoteProcessingJob
        {
            QuoteCaseId = quote.Id,
            QuoteProjectTaskId = task.Id,
            JobType = "CentCom Task Analysis",
            Status = "Queued",
            Message = $"Project Task {task.SortOrder} ({task.TaskType}) analysis revision {revision} queued."
        });
        await AddAuditEventAsync(db, quote, $"CentCom analysis revision {revision} submitted for Project Task {task.SortOrder} ({task.TaskType}).");
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("CentComAnalysis", "Submit", "Queued", $"Task {task.SortOrder} analysis revision {revision} queued.");
        message = $"Project Task {task.SortOrder} was queued for CentCom analysis.";
        await ReloadAsync();
        StartAnalysisMonitoringIfNeeded();
    }

    private void StartAnalysisMonitoringIfNeeded()
    {
        var hasPendingAnalysis = quote?.ProjectTasks.Any(task =>
            LatestAnalysis(task)?.Status is QuoteTaskAnalysisStatuses.Queued or
                QuoteTaskAnalysisStatuses.Processing) == true;
        if (!hasPendingAnalysis || analysisMonitorTask is { IsCompleted: false }) return;

        analysisMonitorCancellation?.Dispose();
        analysisMonitorCancellation = new CancellationTokenSource();
        analysisMonitorTask = MonitorPendingAnalysesAsync(analysisMonitorCancellation.Token);
    }

    private async Task MonitorPendingAnalysesAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });

                var stillPending = quote?.ProjectTasks.Any(task =>
                    LatestAnalysis(task)?.Status is QuoteTaskAnalysisStatuses.Queued or
                        QuoteTaskAnalysisStatuses.Processing) == true;
                if (!stillPending) break;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Component disposal stopped the monitor.
        }
    }

    private async Task ReviewAnalysisAsync(QuoteTaskAnalysis analysis, bool accept)
    {
        if (quote is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteTaskAnalyses
            .Include(x => x.QuoteProjectTask)
            .SingleOrDefaultAsync(x => x.Id == analysis.Id && x.QuoteProjectTask.QuoteCaseId == quote.Id);
        if (tracked is null || tracked.Status != QuoteTaskAnalysisStatuses.NeedsReview) return;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        tracked.Status = accept ? QuoteTaskAnalysisStatuses.Accepted : QuoteTaskAnalysisStatuses.Rejected;
        tracked.ReviewedAt = DateTimeOffset.UtcNow;
        tracked.ReviewedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        await AddAuditEventAsync(
            db,
            quote,
            $"CentCom analysis revision {tracked.RevisionNumber} for Project Task {tracked.QuoteProjectTask.SortOrder} was {(accept ? "accepted" : "rejected")}.");
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("CentComAnalysis", "Review", "Completed", $"Analysis revision {tracked.RevisionNumber} {(accept ? "accepted" : "rejected")}.");
        message = $"CentCom analysis revision {tracked.RevisionNumber} was {(accept ? "accepted" : "rejected")}.";
        await ReloadAsync();
    }

    private async Task SaveAnalysisEditsAsync(QuoteTaskAnalysis analysis)
    {
        if (quote is null || analysis.Status != QuoteTaskAnalysisStatuses.NeedsReview) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteTaskAnalyses
            .Include(x => x.QuoteProjectTask)
            .Include(x => x.Materials)
            .SingleOrDefaultAsync(x => x.Id == analysis.Id && x.QuoteProjectTask.QuoteCaseId == quote.Id);
        if (tracked is null) return;

        tracked.DeliveryAllowance = Math.Max(0, analysis.DeliveryAllowance);
        tracked.TaxAllowance = Math.Max(0, analysis.TaxAllowance);
        tracked.OtherAllowance = Math.Max(0, analysis.OtherAllowance);
        foreach (var edited in analysis.Materials)
        {
            var item = tracked.Materials.SingleOrDefault(x => x.Id == edited.Id);
            if (item is null) continue;
            item.Description = edited.Description.Trim();
            item.Quantity = Math.Max(0, edited.Quantity);
            item.Unit = edited.Unit.Trim();
            item.UnitCost = Math.Max(0, edited.UnitCost);
            item.WastePercent = Math.Max(0, edited.WastePercent);
        }

        await AddAuditEventAsync(
            db,
            quote,
            $"CentCom analysis revision {tracked.RevisionNumber} for Project Task {tracked.QuoteProjectTask.SortOrder} was manually edited.");
        await db.SaveChangesAsync();
        editingAnalysisIds.Remove(analysis.Id);
        await PublishEstimateEventAsync("CentComAnalysis", "Edit", "Completed", $"Analysis revision {tracked.RevisionNumber} manually edited.");
        message = $"CentCom analysis revision {tracked.RevisionNumber} edits were saved.";
        await ReloadAsync();
    }

    private async Task CancelAnalysisEditsAsync(int analysisId)
    {
        editingAnalysisIds.Remove(analysisId);
        await ReloadAsync();
    }

    private async Task AddProjectTaskAsync()
    {
        if (quote is null || !ProjectTaskTypes.All.Contains(newTaskType)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var nextSortOrder = await db.QuoteProjectTasks
            .Where(x => x.QuoteCaseId == quote.Id)
            .Select(x => (int?)x.SortOrder)
            .MaxAsync() ?? 0;
        var task = new QuoteProjectTask
        {
            QuoteCaseId = quote.Id,
            SortOrder = nextSortOrder + 1,
            TaskType = newTaskType
        };
        db.QuoteProjectTasks.Add(task);
        await AddAuditEventAsync(db, quote, $"Project Task {task.SortOrder} ({task.TaskType}) added.");
        await db.SaveChangesAsync();
        message = $"Project Task {task.SortOrder} added.";
        newTaskType = string.Empty;
        expandedTaskIds.Clear();
        expandedTaskIds.Add(task.Id);
        await ReloadAsync();
    }

    private async Task SaveEstimateAsync()
    {
        if (quote is null || savingEstimate) return;
        savingEstimate = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.QuoteCases
                .Include(x => x.ProjectTasks)
                .SingleOrDefaultAsync(x => x.Id == quote.Id);
            if (tracked is null) return;

            tracked.WorkDescription = quote.WorkDescription?.Trim() ?? string.Empty;
            tracked.UpdatedAt = DateTimeOffset.UtcNow;
            foreach (var editedTask in quote.ProjectTasks)
            {
                var trackedTask = tracked.ProjectTasks.SingleOrDefault(x => x.Id == editedTask.Id);
                if (trackedTask is null) continue;
                trackedTask.ScopeOfWork = editedTask.ScopeOfWork?.Trim() ?? string.Empty;
                trackedTask.WorkType = string.IsNullOrWhiteSpace(editedTask.WorkType) ? null : editedTask.WorkType;
                trackedTask.EstimatedDays = Math.Max(0, editedTask.EstimatedDays);
                trackedTask.CrewSizeOverride = editedTask.CrewSizeOverride is > 0 ? editedTask.CrewSizeOverride : null;
                trackedTask.DailyCrewCostOverride = editedTask.DailyCrewCostOverride is >= 0 ? editedTask.DailyCrewCostOverride : null;
                trackedTask.ContingencyPercentOverride = editedTask.ContingencyPercentOverride is >= 0 ? editedTask.ContingencyPercentOverride : null;
                trackedTask.TargetMarginPercentOverride = editedTask.TargetMarginPercentOverride is > 0 and < 100 ? editedTask.TargetMarginPercentOverride : null;
                trackedTask.UpdatedAt = DateTimeOffset.UtcNow;
            }

            await AddAuditEventAsync(db, quote, "Estimate saved, including Project Overview Notes and project-task scopes.");
            await db.SaveChangesAsync();
            await PublishEstimateEventAsync("EstimateWorkspace", "SaveEstimate", "Completed", "Estimate overview and project-task scopes saved.");
            message = "Estimate saved.";
            await ReloadAsync();
        }
        finally
        {
            savingEstimate = false;
        }
    }

    private async Task DeleteProjectTaskAsync(QuoteProjectTask task)
    {
        if (quote is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Do you really want to delete this task?");
        if (!confirmed) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.QuoteTaskCostSnapshots.AnyAsync(x => x.QuoteProjectTaskId == task.Id))
        {
            message = "This task is part of an immutable cost snapshot and cannot be deleted. Create a new estimate revision instead.";
            return;
        }
        await using var transaction = await db.Database.BeginTransactionAsync();
        var tracked = await db.QuoteProjectTasks
            .Include(x => x.Photos)
            .SingleOrDefaultAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (tracked is null) return;

        var storedPaths = tracked.Photos
            .Select(x => x.StoragePath)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
        var deletedTaskNumber = tracked.SortOrder;
        var deletedTaskType = tracked.TaskType;
        db.QuoteProjectTasks.Remove(tracked);
        await db.SaveChangesAsync();

        var remainingTasks = await db.QuoteProjectTasks
            .Where(x => x.QuoteCaseId == quote.Id)
            .OrderBy(x => x.SortOrder)
            .ToListAsync();
        for (var index = 0; index < remainingTasks.Count; index++)
        {
            remainingTasks[index].SortOrder = -(index + 1);
        }
        await db.SaveChangesAsync();
        for (var index = 0; index < remainingTasks.Count; index++)
        {
            remainingTasks[index].SortOrder = index + 1;
        }

        await AddAuditEventAsync(db, quote, $"Project Task {deletedTaskNumber} ({deletedTaskType}) deleted.");
        await db.SaveChangesAsync();
        await transaction.CommitAsync();

        foreach (var storedPath in storedPaths)
        {
            try
            {
                if (File.Exists(storedPath)) File.Delete(storedPath);
            }
            catch (IOException)
            {
                // The database record is authoritative; orphaned files can be cleaned up later.
            }
            catch (UnauthorizedAccessException)
            {
                // The database record is authoritative; orphaned files can be cleaned up later.
            }
        }

        await PublishEstimateEventAsync("EstimateWorkspace", "DeleteProjectTask", "Completed", $"Project Task {deletedTaskNumber} deleted.");
        message = $"Project Task {deletedTaskNumber} deleted.";
        expandedTaskIds.Remove(task.Id);
        await ReloadAsync();
    }

    private async Task SaveProjectTaskAsync(QuoteProjectTask task)
    {
        if (quote is null || !ProjectTaskTypes.All.Contains(task.TaskType)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteProjectTasks.SingleOrDefaultAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (tracked is null) return;
        tracked.ScopeOfWork = task.ScopeOfWork?.Trim() ?? string.Empty;
        tracked.WorkType = string.IsNullOrWhiteSpace(task.WorkType) ? null : task.WorkType;
        tracked.EstimatedDays = Math.Max(0, task.EstimatedDays);
        tracked.CrewSizeOverride = task.CrewSizeOverride is > 0 ? task.CrewSizeOverride : null;
        tracked.DailyCrewCostOverride = task.DailyCrewCostOverride is >= 0 ? task.DailyCrewCostOverride : null;
        tracked.ContingencyPercentOverride = task.ContingencyPercentOverride is >= 0 ? task.ContingencyPercentOverride : null;
        tracked.TargetMarginPercentOverride = task.TargetMarginPercentOverride is > 0 and < 100 ? task.TargetMarginPercentOverride : null;
        tracked.UpdatedAt = DateTimeOffset.UtcNow;
        await AddAuditEventAsync(db, quote, $"Project Task {tracked.SortOrder} scope updated.");
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("EstimateWorkspace", "SaveProjectTask", "Completed", $"Project Task {tracked.SortOrder} saved.");
        message = $"Project Task {tracked.SortOrder} saved.";
        await ReloadAsync();
    }

    private async Task CreateCostSnapshotAsync()
    {
        if (quote is null || version is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var policy = await db.CostingPolicyVersions.AsNoTracking()
            .Include(x => x.Rules)
            .Include(x => x.CrewRates)
            .Include(x => x.MarginRules)
            .Include(x => x.SupplyKits).ThenInclude(x => x.Items).ThenInclude(x => x.VendorProduct).ThenInclude(x => x.Prices)
            .Where(x => x.IsActive && x.EffectiveDate <= today && (x.EndDate == null || x.EndDate >= today)
                && (x.LocalOperationId == quote.LocalOperationId || x.LocalOperationId == null))
            .OrderByDescending(x => x.LocalOperationId == quote.LocalOperationId)
            .ThenByDescending(x => x.EffectiveDate)
            .ThenByDescending(x => x.RevisionNumber)
            .FirstOrDefaultAsync();
        if (policy is null)
        {
            message = "No active costing policy applies to this operation. An administrator must create one under Costing Policies.";
            return;
        }

        var trackedVersion = await db.QuoteVersions
            .Include(x => x.QuoteCase).ThenInclude(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Materials)
            .SingleOrDefaultAsync(x => x.Id == version.Id);
        if (trackedVersion is null) return;
        var accepted = trackedVersion.QuoteCase.ProjectTasks
            .Select(task => task.Analyses.Where(x => x.Status == QuoteTaskAnalysisStatuses.Accepted).OrderByDescending(x => x.RevisionNumber).FirstOrDefault())
            .Where(x => x is not null).ToDictionary(x => x!.QuoteProjectTaskId, x => x!);
        if (accepted.Count == 0) { message = "Accept at least one CentCom task analysis before pricing."; return; }

        var revision = (await db.QuoteCostSnapshots.Where(x => x.QuoteVersionId == version.Id).Select(x => (int?)x.RevisionNumber).MaxAsync() ?? 0) + 1;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var snapshot = new QuoteCostSnapshot
        {
            QuoteVersionId = version.Id, CostingPolicyVersionId = policy.Id, RevisionNumber = revision,
            TargetMarginPercent = policy.DefaultTargetMarginPercent,
            PricedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier)
        };
        decimal totalTaskCost = 0;
        decimal projectDays = 0;
        foreach (var task in trackedVersion.QuoteCase.ProjectTasks.OrderBy(x => x.SortOrder))
        {
            if (!accepted.TryGetValue(task.Id, out var analysis)) continue;
            var days = Math.Max(0, task.EstimatedDays);
            var crewRate = policy.CrewRates.Where(x => x.IsActive && x.TaskType == task.TaskType
                    && (x.WorkType == null || x.WorkType == task.WorkType))
                .OrderByDescending(x => x.WorkType != null).FirstOrDefault();
            var crew = task.CrewSizeOverride ?? crewRate?.CrewSize ?? policy.DefaultCrewSize;
            var dailyCrew = task.DailyCrewCostOverride ?? crewRate?.DailyCrewCost ?? policy.DefaultDailyCrewCost;
            var material = analysis.TotalCost;
            var applicableKits = policy.SupplyKits.Where(x => x.IsActive
                    && (x.TaskType == null || x.TaskType == task.TaskType)
                    && (x.WorkType == null || x.WorkType == task.WorkType)).ToList();
            var supplyLines = applicableKits.SelectMany(kit => kit.Items.Select(item =>
            {
                var price = item.VendorProduct.Prices
                    .Where(x => x.EffectiveDate <= today && (x.ExpirationDate == null || x.ExpirationDate >= today))
                    .OrderByDescending(x => x.EffectiveDate).FirstOrDefault();
                var extended = decimal.Round(item.Quantity * (price?.UnitPrice ?? 0) * (1 + item.WastePercent / 100m), 2);
                return new { Kit = kit, Item = item, UnitCost = price?.UnitPrice ?? 0, Extended = extended };
            })).ToList();
            var supplyCost = supplyLines.Sum(x => x.Extended);
            var labor = decimal.Round(days * dailyCrew, 2);
            var direct = material + supplyCost + labor;
            var applicable = policy.Rules.Where(x => x.IsActive && x.Scope == CostRuleScopes.Task && (x.TaskType == null || x.TaskType == task.TaskType)).ToList();
            var overhead = applicable.Sum(rule => CalculateRule(rule, direct, days));
            var contingencyPercent = task.ContingencyPercentOverride ?? policy.DefaultContingencyPercent;
            var contingency = decimal.Round((direct + overhead) * contingencyPercent / 100m, 2);
            var total = direct + overhead + contingency;
            var taskSnapshot = new QuoteTaskCostSnapshot
            {
                QuoteProjectTaskId = task.Id, MaterialCost = material, RequiredSupplyCost = supplyCost, EstimatedDays = days, CrewSize = crew,
                DailyCrewCost = dailyCrew, LaborCost = labor, TaskOverhead = overhead, Contingency = contingency,
                TotalCost = total,
                AppliedRules = string.Join("; ", applicable.Select(x => $"{x.Name}: {FormatRuleForSnapshot(x)}")
                    .Concat(applicableKits.Select(x => $"Supply kit: {x.Name}"))
                    .Concat(crewRate is null ? Enumerable.Empty<string>() : [$"Crew rate: {crewRate.TaskType}/{crewRate.WorkType ?? "All"}"]))
            };
            foreach (var line in supplyLines)
            {
                taskSnapshot.RequiredSupplies.Add(new QuoteTaskSupplyCostSnapshot
                {
                    VendorProductId = line.Item.VendorProductId, KitName = line.Kit.Name,
                    Description = line.Item.VendorProduct.Product.Name, Quantity = line.Item.Quantity,
                    UnitCost = line.UnitCost, WastePercent = line.Item.WastePercent, ExtendedCost = line.Extended
                });
            }
            snapshot.Tasks.Add(taskSnapshot);
            totalTaskCost += total;
            projectDays += days;
        }
        var projectTaskTypes = trackedVersion.QuoteCase.ProjectTasks.Select(x => x.TaskType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var projectRules = policy.Rules.Where(x => x.IsActive && x.Scope == CostRuleScopes.Project
            && (x.TaskType == null || projectTaskTypes.Contains(x.TaskType))).ToList();
        var generalOverhead = policy.GeneralOverheadFixed
            + (policy.GeneralOverheadPerProjectDay + policy.CalculatedOverheadPerCrewDay) * projectDays
            + totalTaskCost * policy.GeneralOverheadPercent / 100m
            + projectRules.Sum(rule => CalculateRule(rule, totalTaskCost, projectDays));
        snapshot.DirectCost = snapshot.Tasks.Sum(x => x.MaterialCost + x.RequiredSupplyCost + x.LaborCost + x.TaskOverhead);
        snapshot.Contingency = snapshot.Tasks.Sum(x => x.Contingency);
        snapshot.ProjectOverhead = decimal.Round(generalOverhead, 2);
        foreach (var taskCost in snapshot.Tasks)
        {
            var ratio = totalTaskCost <= 0 ? 1m / Math.Max(1, snapshot.Tasks.Count) : taskCost.TotalCost / totalTaskCost;
            taskCost.AllocatedProjectOverhead = decimal.Round(snapshot.ProjectOverhead * ratio, 2);
            taskCost.TotalCost = decimal.Round(taskCost.TotalCost + taskCost.AllocatedProjectOverhead, 2);
            var task = trackedVersion.QuoteCase.ProjectTasks.Single(x => x.Id == taskCost.QuoteProjectTaskId);
            var marginRule = policy.MarginRules.Where(x => x.IsActive && x.TaskType == task.TaskType
                    && (x.WorkType == null || x.WorkType == task.WorkType))
                .OrderByDescending(x => x.WorkType != null).FirstOrDefault();
            taskCost.TargetMarginPercent = task.TargetMarginPercentOverride ?? marginRule?.TargetMarginPercent ?? policy.DefaultTargetMarginPercent;
            taskCost.SuggestedCustomerPrice = taskCost.TargetMarginPercent >= 100
                ? taskCost.TotalCost
                : decimal.Round(taskCost.TotalCost / (1 - taskCost.TargetMarginPercent / 100m), 2);
            taskCost.AppliedRules = string.Join("; ", new[] { taskCost.AppliedRules, marginRule is null ? null : $"Margin: {marginRule.TaskType}/{marginRule.WorkType ?? "All"} {marginRule.TargetMarginPercent:N2}%" }.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        snapshot.TotalCost = snapshot.Tasks.Sum(x => x.TotalCost);
        snapshot.SuggestedCustomerPrice = snapshot.Tasks.Sum(x => x.SuggestedCustomerPrice);
        snapshot.TargetMarginPercent = snapshot.SuggestedCustomerPrice <= 0 ? 0
            : decimal.Round((snapshot.SuggestedCustomerPrice - snapshot.TotalCost) / snapshot.SuggestedCustomerPrice * 100m, 4);
        db.QuoteCostSnapshots.Add(snapshot);
        await AddAuditEventAsync(db, quote, $"Cost snapshot revision {revision} created using {policy.Name} revision {policy.RevisionNumber}.");
        await db.SaveChangesAsync();
        message = $"Cost snapshot revision {revision} created. Previous snapshots remain unchanged.";
        await ReloadAsync();
    }

    private async Task SavePriceAdjustmentAsync()
    {
        if (quote is null || currentCostSnapshot is null) return;
        if (currentCostSnapshot.PriceAdjustment != 0 && string.IsNullOrWhiteSpace(currentCostSnapshot.AdjustmentReason))
        {
            message = "Enter a reason for the customer price adjustment.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteCostSnapshots.FindAsync(currentCostSnapshot.Id);
        if (tracked is null) return;
        tracked.PriceAdjustment = currentCostSnapshot.PriceAdjustment;
        tracked.AdjustmentReason = currentCostSnapshot.AdjustmentReason?.Trim();
        await AddAuditEventAsync(db, quote, $"Price adjustment of {tracked.PriceAdjustment:C2} saved on cost snapshot revision {tracked.RevisionNumber}.");
        await db.SaveChangesAsync();
        message = "Price adjustment saved.";
        await ReloadAsync();
    }

    private static decimal CalculateRule(CostingPolicyRule rule, decimal directCost, decimal days) =>
        decimal.Round(rule.CalculationMethod switch
        {
            CostRuleCalculationMethods.PerProjectDay => rule.Rate * days,
            CostRuleCalculationMethods.PercentOfDirectCost => directCost * rule.Rate / 100m,
            _ => rule.Rate
        }, 2);

    private static string FormatRuleForSnapshot(CostingPolicyRule rule) =>
        rule.CalculationMethod == CostRuleCalculationMethods.PercentOfDirectCost
            ? $"{rule.Rate:N2}%"
            : $"{rule.Rate:C2} {rule.CalculationMethod}";

    private async Task CapturePicturesAsync(
        QuoteProjectTask task,
        ProjectPhotoRequirement requirement,
        InputFileChangeEventArgs args)
    {
        if (quote is null) return;
        var files = args.GetMultipleFiles(12);
        if (files.Count == 0) return;
        var root = Configuration["EstimatePictures:StoragePath"];
        if (string.IsNullOrWhiteSpace(root))
        {
            root = Path.Combine(Environment.ContentRootPath, "EstimatePictures");
        }
        var taskDirectory = Path.Combine(root, $"estimate-{quote.Id}", $"task-{task.Id}");
        Directory.CreateDirectory(taskDirectory);

        await using var db = await DbFactory.CreateDbContextAsync();
        var validTask = await db.QuoteProjectTasks.AnyAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (!validTask) return;

        var saved = 0;
        foreach (var file in files)
        {
            if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) continue;
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not ".jpg" and not ".jpeg" and not ".png" and not ".webp" and not ".heic") extension = ".jpg";
            var storedPath = Path.Combine(taskDirectory, $"{DateTimeOffset.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}{extension}");
            await using var source = file.OpenReadStream(20 * 1024 * 1024);
            await using var destination = File.Create(storedPath);
            await source.CopyToAsync(destination);
            db.QuoteProjectTaskPhotos.Add(new QuoteProjectTaskPhoto
            {
                QuoteProjectTaskId = task.Id,
                OriginalFileName = Path.GetFileName(file.Name),
                StoragePath = storedPath,
                ContentType = file.ContentType,
                FileSize = file.Size,
                RequirementKey = requirement.Key,
                RequirementLabel = requirement.Label
            });
            saved++;
        }

        if (saved > 0)
        {
            await AddAuditEventAsync(db, quote, $"{saved} photograph(s) added to Project Task {task.SortOrder}.");
            await db.SaveChangesAsync();
            await PublishEstimateEventAsync("EstimateWorkspace", "CaptureProjectTaskPictures", "Completed", $"{saved} photograph(s) stored for Project Task {task.SortOrder}.");
        }
        message = saved == 0 ? "No supported image files were selected." : $"{saved} photograph(s) added to Project Task {task.SortOrder}.";
        await ReloadAsync();
    }

    private async Task AddAuditEventAsync(ApplicationDbContext db, QuoteCase currentQuote, string explanation)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        db.QuoteAuditEvents.Add(new QuoteAuditEvent
        {
            QuoteCaseId = currentQuote.Id,
            PreviousStatus = currentQuote.Status,
            NewStatus = currentQuote.Status,
            UserId = user.FindFirstValue(ClaimTypes.NameIdentifier),
            Explanation = explanation
        });
        var trackedQuote = await db.QuoteCases.FindAsync(currentQuote.Id);
        if (trackedQuote is not null) trackedQuote.UpdatedAt = DateTimeOffset.UtcNow;
    }

    private async Task TransitionAsync(string status, string explanation)
    {
        if (quote is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteCases.FindAsync(quote.Id);
        if (tracked is null) return;
        var previous = tracked.Status;
        tracked.Status = status;
        tracked.UpdatedAt = DateTimeOffset.UtcNow;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        db.QuoteAuditEvents.Add(new QuoteAuditEvent
        {
            QuoteCaseId = tracked.Id,
            PreviousStatus = previous,
            NewStatus = status,
            UserId = user.FindFirstValue(ClaimTypes.NameIdentifier),
            Explanation = explanation
        });
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("EstimateWorkflow", "Transition", "Completed", $"Estimate transitioned from {previous} to {status}: {explanation}");
        await ReloadAsync();
    }

    private async Task SubmitForReviewAsync()
    {
        if (quote is null) return;
        var incomplete = quote.ProjectTasks
            .Where(task =>
                string.IsNullOrWhiteSpace(task.ScopeOfWork) ||
                ProjectPhotoGuidance.For(task.TaskType).Any(requirement =>
                    task.Photos.All(photo => photo.RequirementKey != requirement.Key)))
            .ToList();
        if (quote.ProjectTasks.Count == 0)
        {
            message = "Add at least one project task before submitting the estimate.";
            return;
        }
        if (incomplete.Count > 0)
        {
            message = $"Complete the scope of work and every required photograph for Project Task(s): {string.Join(", ", incomplete.Select(x => x.SortOrder))}.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existingQueuedTaskIds = await db.QuoteProcessingJobs
            .Where(x => x.QuoteCaseId == quote.Id && x.JobType == "CentCom Task Analysis" && x.QuoteProjectTaskId != null)
            .Select(x => x.QuoteProjectTaskId!.Value)
            .ToListAsync();
        foreach (var task in quote.ProjectTasks.Where(x => !existingQueuedTaskIds.Contains(x.Id)))
        {
            db.QuoteProcessingJobs.Add(new QuoteProcessingJob
            {
                QuoteCaseId = quote.Id,
                QuoteProjectTaskId = task.Id,
                JobType = "CentCom Task Analysis",
                Status = "Queued",
                Message = $"Project Task {task.SortOrder} ({task.TaskType}) queued with scope and {task.Photos.Count} photograph(s)."
            });
        }
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.ReadyForAnalysis, "All project tasks submitted to the CentCom analysis queue.");
        message = $"{quote.ProjectTasks.Count} project task(s) queued for CentCom analysis.";
    }
    private Task RejectAsync() => TransitionAsync(QuoteStatuses.Rejected, "Estimate rejected by operator.");

    private async Task ApproveAsync()
    {
        if (quote is null || version is null || version.Lines.Count == 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteVersions.FindAsync(version.Id);
        if (tracked is null || tracked.Status != "Draft") return;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        tracked.Status = "Approved";
        tracked.ApprovedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        tracked.ApprovedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.Approved, "Estimate version approved. External update and customer email remain disabled.");
    }

    private async Task CreateRevisionAsync()
    {
        if (quote is null || version is null || version.Status != "Approved") return;
        var next = new QuoteVersion
        {
            QuoteCaseId = quote.Id,
            VersionNumber = version.VersionNumber + 1,
            TaxRate = version.TaxRate,
            DiscountAmount = version.DiscountAmount,
            CustomerNotes = version.CustomerNotes
        };
        foreach (var line in version.Lines)
        {
            next.Lines.Add(new QuoteLine
            {
                SortOrder = line.SortOrder,
                Description = line.Description,
                Quantity = line.Quantity,
                Unit = line.Unit,
                MaterialUnitCost = line.MaterialUnitCost,
                LaborHours = line.LaborHours,
                LaborRate = line.LaborRate,
                EquipmentCost = line.EquipmentCost,
                WastePercent = line.WastePercent,
                MarkupPercent = line.MarkupPercent,
                CustomerPrice = line.CustomerPrice,
                Source = "Revision"
            });
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Add(next);
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.RevisionRequested, "A new editable estimate version was created.");
    }

    private Task PublishEstimateEventAsync(string module, string step, string status, string eventMessage) =>
        quote is null
            ? Task.CompletedTask
            : OperationalEvents.PublishAsync(new OperationalEventRequest(
                "CharlieCompany.Web",
                module,
                step,
                status,
                eventMessage,
                CorrelationId: $"quote-{quote.Id:D6}",
                LocalOperationId: quote.LocalOperationId,
                QuoteCaseId: quote.Id,
                JobNumber: quote.HousecallProJobId));

