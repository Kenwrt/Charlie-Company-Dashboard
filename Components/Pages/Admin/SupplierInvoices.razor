@page "/admin/supplier-invoices"
@rendermode InteractiveServer
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Text.Json
@using System.Text.Json.Nodes
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Models
@using CharleyCompany.Dashboard.Web.Services
@using CharleyCompany.Dashboard.Web.Options
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject HousecallProDataService HcpData
@inject SupplierInvoiceService ImportService
@inject AuthenticationStateProvider AuthenticationState
@inject ILogger<SupplierInvoices> Logger
@inject IOptions<SupplierInvoiceOptions> InvoiceOptions

<PageTitle>Supplier Invoice Review</PageTitle>
<h1 id="supplier-invoice-list-top" tabindex="-1">Supplier invoice review</h1>
<p>Review supplier documents before updating accounts payable. Catalog prices retain their effective dates; conflicting prices remain in <a href="/admin/catalog-automation">catalog review</a>.</p>
@if (message is not null) { <div class="alert alert-info" role="status">@message</div> }
<p class="fw-semibold" role="status">Remaining to review: @remainingReviewCount</p>
<label for="invoice-status" class="form-label">Status</label>
<select id="invoice-status" class="form-select mb-3" @bind="status" @bind:after="ReloadAsync" disabled="@busy">
    <option value="Unassigned Jobs">Unassigned job expenses</option><option>Needs Review</option><option>Posted</option><option>Duplicate Invoice</option><option>Rejected</option><option value="">All</option>
</select>
<button class="btn btn-outline-secondary mb-3" @onclick="ReloadAsync" disabled="@busy">Refresh</button>
<div class="table-responsive">
<table class="table"><thead><tr><th>Invoice number</th><th>Received</th><th>Supplier / document</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in imports)
{
    <tr @key="item.Id"><td>@InvoiceNumber(item)</td><td>@item.CreatedAt.ToLocalTime().ToString("g")</td><td>@item.PriceImportDocument.SupplyVendor.Name<br />@item.PriceImportDocument.OriginalFileName</td><td>@item.Status</td><td>
        <a href="@($"/api/supplier-invoices/{item.Id}/document")" target="_blank" rel="noopener">Original PDF</a>
        @if (item.Status == "Needs Review") { <button class="btn btn-sm btn-primary ms-2" @onclick="() => SelectAsync(item.Id)" disabled="@busy">Review</button> }
        @if (status == "Unassigned Jobs") { <button class="btn btn-sm btn-primary ms-2" @onclick="() => OpenAssignmentAsync(item.Id)" disabled="@busy">Assign job</button> }
        @if (item.PayableInvoiceId is int invoiceId) { <a class="ms-2" href="@($"/admin/vendors/{item.PriceImportDocument.SupplyVendorId}/invoices/{invoiceId}/lines")">AP invoice lines</a> }
    </td></tr>
}
@if (imports.Count == 0) { <tr><td colspan="5">No invoices match this status.</td></tr> }
</tbody></table></div>
<p>Showing up to 100 most recent matching imports.</p>

@if (assignmentImportId is not null)
{
    <section class="activity-panel mt-4">
        <h2>Assign job to invoice @assignmentInvoiceNumber</h2>
        <p>@assignmentReason</p>
        <label class="form-label">Housecall Pro job (same purchasing location)</label>
        <select class="form-select" @bind="assignmentJobNumber" disabled="@busy">
            <option value="">Select one job</option>
            @foreach (var job in assignmentJobs) { <option value="@job.Number">@job.Number - @job.Customer</option> }
        </select>
        <button type="button" class="btn btn-primary mt-3" @onclick="SaveAssignmentAsync" disabled="@busy">Save job assignment</button>
        <p>This updates the existing payable. Invoice amounts and catalog prices are retained.</p>
    </section>
}

@if (selected is not null && payload is not null)
{
    <section class="activity-panel mt-4">
    <h2>Review @selected.PriceImportDocument.OriginalFileName</h2>
    <p><a href="@($"/api/supplier-invoices/{selected.Id}/document")" target="_blank" rel="noopener">Download original invoice</a></p>
    @if (selected.ReviewReason is not null) { <p class="alert alert-warning">@selected.ReviewReason</p> }
    @foreach (var warning in payload.Warnings) { <p class="alert alert-warning">@warning</p> }
    <fieldset disabled="@busy">
    <EditForm Model="payload" OnSubmit="ApproveAsync" FormName="supplier-invoice-review">
    <div class="row g-3">
        <div class="col-12"><label class="form-label">Delivery address (from invoice)</label><InputText class="form-control" @bind-Value="payload.DeliveryAddress" /></div>
        <div class="col-md-6"><label class="form-label">Paying entity (if known)</label><InputSelect class="form-select" @bind-Value="payload.PayingEntityCode"><option value="">Unknown / not confirmed</option>@foreach (var payer in InvoiceOptions.Value.PayingEntities) { <option value="@payer.Key">@payer.Value</option> }</InputSelect></div>
        <div class="col-md-6"><label class="form-label">Your Reference (as printed)</label><InputText class="form-control" @bind-Value="payload.YourReference" @bind-Value:after="TrimReference" /></div>
        <div class="col-md-4"><label class="form-label">Invoice number</label><InputText class="form-control" @bind-Value="payload.InvoiceNumber" /></div>
        <div class="col-md-4"><label class="form-label">Invoice date</label><InputDate class="form-control" @bind-Value="payload.InvoiceDate" /></div>
        <div class="col-md-4"><label class="form-label">Due date</label><InputDate class="form-control" @bind-Value="payload.DueDate" /><small class="text-muted">If missing, defaults to 30 days after the invoice date.</small></div>
        <div class="col-md-6"><label class="form-label">Purchasing location</label><InputSelect class="form-select" @bind-Value="payload.LocalOperationId" @bind-Value:after="UpdateAccountingAssignment"><option value="">Select operation</option>@foreach (var operation in operations) { <option value="@operation.Id">@operation.EffectiveDisplayName</option> }</InputSelect></div>
        <div class="col-md-6"><label class="form-label" for="supplier-job">Job number</label>
            <InputText id="supplier-job" class="form-control" @bind-Value="payload.JobNumber" list="supplier-job-options" autocomplete="off" />
            <datalist id="supplier-job-options">
                @foreach (var number in payload.MatchedJobNumbers)
                {
                    <option value="@number" label="@payload.JobOptionLabels.GetValueOrDefault(number, "Description unavailable")"></option>
                }
            </datalist>
            <small class="text-muted">Choose a suggested job or type one job number. Descriptions appear in suggestions; only the number is entered. The job must belong to this purchasing location.</small>
        </div>
        <div class="col-md-3"><label class="form-label">Tax</label><InputNumber class="form-control" @bind-Value="payload.Tax" />@if (sourcePayload?.ExtractionEvidence.ContainsKey("tax") == true) { <small class="text-muted">Original PDF: @sourcePayload.Tax.ToString("C2")</small> }</div>
        <div class="col-md-3"><label class="form-label">Freight</label><InputNumber class="form-control" @bind-Value="payload.Freight" /></div>
        <div class="col-md-3"><label class="form-label">Discount</label><InputNumber class="form-control" @bind-Value="payload.Discount" /></div>
        <div class="col-md-3"><label class="form-label">Invoice total</label><InputNumber class="form-control" @bind-Value="payload.Total" />@if (sourcePayload?.ExtractionEvidence.ContainsKey("total") == true) { <small class="text-muted">Original PDF: @sourcePayload.Total.ToString("C2")</small> }</div>
        <div class="col-md-3"><label class="form-label">Amount already paid</label><InputNumber class="form-control" @bind-Value="payload.AmountPaid" />@if (!payload.PaymentStateVerified) { <small class="text-muted">Unverified. Check supplier payment records before confirming this amount.</small> }</div>
    </div>
    @if (payload.JobUnassigned)
    {
        <p class="text-muted">Job assignment deferred automatically: @payload.JobUnassignedReason</p>
    }
    <div class="alert alert-info mt-3">
        <strong>Purchase-owning entity:</strong> @EntityName(payload.PurchaseEntityCode)<br />
        <strong>Accounting scope:</strong> @(payload.AccountingPolicy == "ReportingOnly" ? "Dashboard reporting only. Excluded from the accounting posting queue." : "Eligible for a separate accounting review after dashboard approval.")
        <p class="mb-0">Post to dashboard AP records this invoice in the dashboard. It does not post to Mercury or send a payment.</p>
    </div>
    <div class="mt-3">
        <button type="button" class="btn btn-outline-secondary" @onclick="LookupJobsAsync" disabled="@busy">Look up customer jobs</button>
        <small class="d-block text-muted">Uses Housecall Pro API jobs for the selected location. Validates numbers in Your Reference or matches the full customer name.</small>
        @if (!string.IsNullOrWhiteSpace(payload.JobLookupMessage)) { <p>@payload.JobLookupMessage</p> }
        @if (payload.MatchedJobNumbers.Count > 0)
        {
            <p>Matching job numbers: @string.Join(", ", payload.MatchedJobNumbers)</p>
            <small>Source records last synchronized: @payload.JobLookupSourceSyncedAt?.ToString("u"). Multiple matches identify customer jobs, not an allocation of this invoice's cost.</small>
        }
    </div>
    <p class="mt-3">@payload.LocationAssignmentReason</p>
    <label class="form-label">Location review explanation (required for uncertain or changed assignments)</label>
    <InputTextArea class="form-control" @bind-Value="payload.LocationOverrideReason" />
    <div class="form-check mt-3"><InputCheckbox class="form-check-input" @bind-Value="payload.LocationAssignmentConfirmed" /><label class="form-check-label">I confirmed the purchase-owning entity, location and payer information (including when the payer is unknown). Job numbers are interpreted within that location.</label></div>
    <div class="form-check mt-3"><InputCheckbox class="form-check-input" @bind-Value="payload.PaymentStateVerified" /><label class="form-check-label">I confirmed the amount already paid against supplier records.</label></div>
    <section class="invoice-lines mt-4" aria-label="Invoice line items">
    <h3>Invoice items</h3>
    @for (var lineIndex = 0; lineIndex < payload.Lines.Count; lineIndex++)
    {
        var line = payload.Lines[lineIndex];
        <fieldset class="invoice-line" @key="line">
            <div class="form-check"><InputCheckbox class="form-check-input" style="width:auto;" @bind-Value="line.PackagingConfirmed" /><label>Packaging quantity verified from the invoice or supplier</label></div>
            @if (line.PackagingConfirmed)
            {
                @if (line.PackagingEvidence.StartsWith("Package count from item description:") || line.PackagingEvidence == "Purchase unit Each denotes one item per purchase unit.")
                { <small class="text-muted d-block">@line.PackagingEvidence</small> }
                else { <label>Supplier packaging evidence</label><InputText class="form-control" @bind-Value="line.PackagingEvidence" maxlength="500" /> }
            }
            else { <p class="text-muted">Package quantity is unknown. A confirmed catalog version for the invoice date will be used if available; otherwise packaging stays unknown and catalog price approval remains pending.</p> }

        <legend>Item @(lineIndex + 1)</legend>
        <div class="line-identification">
            <div><label class="form-label">Supplier SKU</label><InputText class="form-control" aria-label="Supplier SKU" @bind-Value="line.Sku" /></div>
            <div class="line-description"><label class="form-label">Description</label><InputTextArea class="form-control" aria-label="Description" rows="3" @bind-Value="line.Description" @bind-Value:after="line.RecognizeEachPackaging" /></div>
        </div>
        <div class="line-amounts">
            <div><label class="form-label">Purchase unit</label><InputText class="form-control" aria-label="Purchase unit" @bind-Value="line.PurchaseUnit" @bind-Value:after="line.RecognizeEachPackaging" /></div>
            <div><label class="form-label">Package quantity (confirmed only when verified)</label><QuantityInput class="form-control" aria-label="Package quantity" @bind-Value="line.PackageQuantity" @bind-Value:after="line.RecognizeEachPackaging" /></div>
            <div><label class="form-label">Quantity</label><QuantityInput class="form-control" aria-label="Quantity" @bind-Value="line.Quantity" /></div>
            <div><label class="form-label">Unit price</label><InputNumber class="form-control" aria-label="Unit price" @bind-Value="line.UnitPrice" /></div>
            <div class="line-total"><label class="form-label">Line total</label><InputNumber class="form-control" aria-label="Line total" @bind-Value="line.LineTotal" /></div>
        </div>
        <button class="btn btn-sm btn-outline-secondary mt-3" type="button" @onclick="() => payload.Lines.Remove(line)">Remove item</button>
        </fieldset>
    }
    </section>
    <button class="btn btn-outline-secondary" type="button" @onclick="() => payload.Lines.Add(new SupplierInvoiceItem())">Add line</button>
    <div class="form-check mt-3"><InputCheckbox class="form-check-input" @bind-Value="allowNewProducts" /><label class="form-check-label">Create catalog products for the new SKUs I reviewed.</label></div>
    <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="approvePrices" /><label class="form-check-label">Approve reviewed prices. Different prices already recorded on the same date stay in catalog review.</label></div>
    <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="confirmedOriginal" /><label class="form-check-label">I checked the original invoice, line items, totals, dates, operation and job assignment.</label></div>
    @if (message is not null)
    {
        <div id="supplier-invoice-post-feedback" class="alert alert-danger mt-3" role="alert" tabindex="-1">
            <strong>Invoice was not posted.</strong> @message
        </div>
    }
    <button class="btn btn-primary mt-3" type="submit">Post to dashboard AP</button>
    <button class="btn btn-outline-danger mt-3 ms-2" type="button" @onclick="RejectAsync">Reject import</button>
    </EditForm>
    </fieldset>
    </section>
}

@code {
    private int remainingReviewCount;
    private List<SupplierInvoiceImport> imports = [];
    private List<LocalOperation> operations = [];
    private SupplierInvoiceImport? selected;
    private SupplierInvoicePayload? payload;
    private SupplierInvoicePayload? sourcePayload;
    private string status = "Needs Review";
    private string? message;
    private int? assignmentImportId;
    private string assignmentInvoiceNumber = "", assignmentJobNumber = "", assignmentReason = "";
    private List<(string Number, string Customer)> assignmentJobs = [];
    private bool returnToList;
    private bool focusPostingError;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((!returnToList && !focusPostingError) || busy) return;
        var target = focusPostingError ? "supplier-invoice-post-feedback" : "supplier-invoice-list-top";
        returnToList = focusPostingError = false;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/supplier-invoice-review.js");
            await module.InvokeVoidAsync("returnToList", target);
        }
        catch (JSDisconnectedException) { }
    }
    private bool busy, allowNewProducts, approvePrices, confirmedOriginal;

    protected override Task OnInitializedAsync() => ReloadAsync();
    private static string InvoiceNumber(SupplierInvoiceImport item)
    {
        try
        {
            var number = JsonSerializer.Deserialize<SupplierInvoicePayload>(item.PayloadJson, SupplierInvoicePayload.JsonOptions)?.InvoiceNumber;
            return string.IsNullOrWhiteSpace(number) ? "Not extracted" : number;
        }
        catch (JsonException) { return "Not available"; }
    }
    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        remainingReviewCount = await db.SupplierInvoiceImports.CountAsync(x => x.Status == "Needs Review");
        var query = db.SupplierInvoiceImports.AsNoTracking();
        if (status == "Unassigned Jobs") query = query.Where(x => x.Status == "Posted" && x.PayableInvoice != null && x.PayableInvoice.JobNumber == "");
        else if (status.Length > 0) query = query.Where(x => x.Status == status);
        imports = await query.Include(x => x.PriceImportDocument).ThenInclude(x => x.SupplyVendor).OrderByDescending(x => x.Id).Take(100).ToListAsync();
        operations = await db.LocalOperations.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
    }
    private async Task OpenAssignmentAsync(int id)
    {
        selected = null; payload = null; message = null;
        await RunAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var item = await db.SupplierInvoiceImports.AsNoTracking().Include(x => x.PayableInvoice).SingleAsync(x => x.Id == id);
            if (item.Status != "Posted" || item.PayableInvoice is null || item.PayableInvoice.JobNumber.Length > 0)
                throw new ArgumentException("This invoice no longer needs a job. Refresh the queue.");
            var operation = await db.LocalOperations.AsNoTracking().SingleAsync(x => x.Id == item.PayableInvoice.LocalOperationId);
            var jobs = await HcpData.GetSupplierJobsAsync(operation.Slug, CancellationToken.None);
            assignmentJobs = jobs.Select(x => (Number: x.JobNumber.Trim(), Customer: x.Description + " - " + x.CustomerName + " - " + x.Address))
                .DistinctBy(x => x.Number).OrderBy(x => x.Number).ToList();
            assignmentInvoiceNumber = InvoiceNumber(item);
            assignmentReason = JsonSerializer.Deserialize<SupplierInvoicePayload>(item.PayloadJson, SupplierInvoicePayload.JsonOptions)?.JobUnassignedReason ?? "";
            assignmentJobNumber = "";
            assignmentImportId = id;
        });
    }
    private async Task SaveAssignmentAsync()
    {
        if (busy || assignmentImportId is not int id) return;
        await RunAsync(async () =>
        {
            await ImportService.AssignJobAsync(id, assignmentJobNumber, await ActorAsync(), CancellationToken.None);
            assignmentImportId = null; assignmentJobs = []; assignmentJobNumber = "";
            message = "Job assigned to the existing invoice.";
            returnToList = true;
        });
    }
    private async Task SelectAsync(int id)
    {
        assignmentImportId = null;
        selected = imports.Single(x => x.Id == id);
        payload = JsonSerializer.Deserialize<SupplierInvoicePayload>(selected.PayloadJson, SupplierInvoicePayload.JsonOptions);
        var source = JsonNode.Parse(selected.PayloadJson)?["_extractionBaseline"];
        sourcePayload = source is not null ? source.Deserialize<SupplierInvoicePayload>(SupplierInvoicePayload.JsonOptions)
            : JsonSerializer.Deserialize<SupplierInvoicePayload>(selected.PayloadJson, SupplierInvoicePayload.JsonOptions);
        if (payload is not null)
        {
            payload.RecognizeEachPackaging();
            payload.ApplyDefaultDueDate();
            payload.LocationAssignmentConfirmed = false;
            // Older pending imports inherited an unverified Ventures payer default.
            if (string.IsNullOrWhiteSpace(payload.AccountingPolicyVersion)) payload.PayingEntityCode = "";
            UpdateAccountingAssignment();
        }
        allowNewProducts = approvePrices = confirmedOriginal = false;
        message = null;
        await LookupJobsAsync();
    }
    private void TrimReference()
    {
        if (payload is not null) payload.YourReference = payload.YourReference.Trim();
    }
    private async Task LookupJobsAsync()
    {
        if (payload is null) return;
        await RunAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await SupplierInvoiceJobLookup.PopulateAsync(db, payload, CancellationToken.None, HcpData);
        });
    }
    private string EntityName(string code) => InvoiceOptions.Value.PayingEntities.GetValueOrDefault(code, "Unassigned: resolve location mapping before posting");
    private void UpdateAccountingAssignment()
    {
        if (payload is null) return;
        SupplierInvoiceAccounting.Assign(payload, operations.SingleOrDefault(x => x.Id == payload.LocalOperationId)?.Slug, InvoiceOptions.Value);
        payload.LocationAssignmentConfirmed = false;
        if (payload.JobLookupLocationId != payload.LocalOperationId)
        {
            payload.JobNumber = "";
            payload.JobLookupFilledValue = "";
            payload.MatchedJobNumbers = [];
            payload.JobLookupMessage = "Location changed. Look up jobs again for this location.";
        }
    }
    private async Task<string> ActorAsync() => (await AuthenticationState.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)
        ?? throw new InvalidOperationException("Sign in again before reviewing an invoice.");
    private async Task ApproveAsync(EditContext _)
    {
        if (busy || selected is null || payload is null) return;
        // Reporting posts retain validation conflicts instead of blocking on review checklists.
        message = null;
        payload.ApplyDefaultDueDate();
        await RunAsync(async () =>
        {
            await ImportService.ApproveAsync(selected.Id, payload, allowNewProducts, approvePrices, await ActorAsync(), CancellationToken.None);
            selected = null; payload = null; sourcePayload = null;
            allowNewProducts = approvePrices = confirmedOriginal = false;
            message = null;
            returnToList = true;
        });
        if (selected is not null && message is not null) focusPostingError = true;
    }
    private async Task RejectAsync()
    {
        if (busy || selected is null) return;
        await RunAsync(async () =>
        {
            await ImportService.RejectAsync(selected.Id, await ActorAsync(), CancellationToken.None);
            message = "Import rejected. The original document was retained.";
            selected = null; payload = null;
        });
    }
    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try { await action(); await ReloadAsync(); }
        catch (ArgumentException ex) { message = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogWarning("Supplier invoice review failed with {ErrorType}", ex.GetType().Name);
            message = "The action could not finish. Refresh the list before retrying.";
        }
        finally { busy = false; }
    }
}
