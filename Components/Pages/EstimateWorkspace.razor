    private bool PricingSnapshotNeedsRefresh()
    {
        if (currentCostSnapshot is null || quote is null) return true;
        foreach (var analysis in PricingAnalyses())
        {
            var taskCost = currentCostSnapshot.Tasks.SingleOrDefault(x => x.QuoteProjectTaskId == analysis.QuoteProjectTaskId);
            if (taskCost is null || taskCost.MaterialCost != analysis.MaterialSubtotal) return true;
            if (analysis.CompletedAt > currentCostSnapshot.PricedAt) return true;
            if (analysis.ReviewItems.Any(item => item.ResolvedAt > currentCostSnapshot.PricedAt)) return true;
            var task = quote.ProjectTasks.Single(x => x.Id == analysis.QuoteProjectTaskId);
            if (task.UpdatedAt > currentCostSnapshot.PricedAt) return true;
        }
        return false;
    }

    private static QuoteTaskAnalysis? LatestAnalysis(QuoteProjectTask task) =>
        task.Analyses.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();

    private IEnumerable<QuoteTaskAnalysis> AcceptedAnalyses() =>
        quote?.ProjectTasks
            .Select(task => task.Analyses
                .Where(x => x.Status == QuoteTaskAnalysisStatuses.Accepted)
                .OrderByDescending(x => x.RevisionNumber)
                .FirstOrDefault())
            .Where(x => x is not null)
            .Select(x => x!) ?? [];

    private IEnumerable<QuoteTaskAnalysis> PricingAnalyses() =>
        quote?.ProjectTasks
            .Select(task => task.Analyses
                .Where(x => x.Status is QuoteTaskAnalysisStatuses.Accepted or QuoteTaskAnalysisStatuses.NeedsReview)
                .OrderByDescending(x => x.RevisionNumber)
                .FirstOrDefault())
            .Where(x => x is not null)
            .Select(x => x!) ?? [];

    private static bool CanSubmitAnalysis(QuoteTaskAnalysis? analysis) =>
        analysis?.Status is not QuoteTaskAnalysisStatuses.Queued and not QuoteTaskAnalysisStatuses.Processing;

    private static bool CanSubmitOrReanalyze(QuoteTaskAnalysis? analysis) =>
        CanSubmitAnalysis(analysis)
        && (analysis is null || analysis.ReviewItems.Count == 0 || AllReviewItemsResolved(analysis));

    private static string AnalysisStatusClass(string? status) => status switch
    {
        QuoteTaskAnalysisStatuses.Accepted => "text-bg-success",
        QuoteTaskAnalysisStatuses.NeedsReview => "text-bg-warning",
        QuoteTaskAnalysisStatuses.Rejected or QuoteTaskAnalysisStatuses.Failed => "text-bg-danger",
        QuoteTaskAnalysisStatuses.Queued or QuoteTaskAnalysisStatuses.Processing => "text-bg-primary",
        _ => "text-bg-secondary"
    };

    private static IReadOnlyList<AnalysisNoteItem> AnalysisNoteItems(string? content, string defaultLabel)
    {
        if (string.IsNullOrWhiteSpace(content)) return [];

        var separated = System.Text.RegularExpressions.Regex.Replace(
            content.Trim(),
            @"(?<!^)(?=\[[^\]\r\n]+\])",
            System.Environment.NewLine);
        var lines = separated.Split(["\r\n", "\n", "\r"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var items = new List<AnalysisNoteItem>(lines.Length);
        foreach (var line in lines)
        {
            var marker = System.Text.RegularExpressions.Regex.Match(line, @"^\[(?<label>[^\]]+)\]\s*(?<body>.*)$");
            var label = marker.Success
                ? HumanizeAnalysisLabel(marker.Groups["label"].Value)
                : $"{defaultLabel} {items.Count + 1}";
            var body = marker.Success ? marker.Groups["body"].Value.Trim() : line.Trim();
            if (!string.IsNullOrWhiteSpace(body)) items.Add(new(label, body));
        }
        return items;
    }

    private static string HumanizeAnalysisLabel(string label) =>
        System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(
            label.Replace('_', ' ').Trim().ToLowerInvariant());

    private sealed record AnalysisNoteItem(string Label, string Body);

    private static string MaterialMatchClass(string matchKind) => matchKind switch
    {
        MaterialMatchKinds.Catalog or MaterialMatchKinds.HomeDepotExact or MaterialMatchKinds.ManualCatalog => "text-bg-success",
        MaterialMatchKinds.HomeDepotSimilar => "text-bg-warning",
        MaterialMatchKinds.OneOff => "text-bg-info",
        _ => "text-bg-danger"
    };

    private string MaterialVendorName(QuoteTaskAnalysisMaterial material)
    {
        if (material.VendorProductId is not null)
        {
            var catalogItem = reviewCatalogItems.FirstOrDefault(item => item.Id == material.VendorProductId.Value);
            if (catalogItem is not null) return catalogItem.SupplyVendor.Name;
        }
        if (material.MatchKind == MaterialMatchKinds.OneOff) return "One-off materials";
        if (material.MatchKind == MaterialMatchKinds.Unresolved || material.IsUnmatched) return "Unresolved materials";
        if (material.SourceType?.Contains("Home Depot", StringComparison.OrdinalIgnoreCase) == true) return "Home Depot";
        if (!string.IsNullOrWhiteSpace(material.SourceType) &&
            !material.SourceType.Equals("Manual", StringComparison.OrdinalIgnoreCase) &&
            !material.SourceType.Contains("CentCom", StringComparison.OrdinalIgnoreCase))
            return material.SourceType;
        return "Other materials";
    }

    private static int MaterialVendorSortOrder(string vendorName) => vendorName switch
    {
        "Decks & Docks" => 10,
        "Nexan Building Products, Inc." => 20,
        "Home Depot" => 30,
        "One-off materials" => 90,
        "Unresolved materials" => 100,
        _ => 50
    };

    private void AddManualMaterialLine(QuoteTaskAnalysis analysis)
    {
        analysis.Materials.Add(new QuoteTaskAnalysisMaterial
        {
            SortOrder = analysis.Materials.Count == 0 ? 1 : analysis.Materials.Max(x => x.SortOrder) + 1,
            Description = "Manually entered material",
            OriginalDescription = "Manually entered material",
            Quantity = 1,
            Unit = "Each",
            MatchKind = MaterialMatchKinds.Unresolved,
            ReviewDecision = MaterialReviewDecisions.Pending,
            IsUnmatched = true,
            SourceType = "Manual review"
        });
    }

    private static int ResolvedReviewCount(QuoteTaskAnalysis analysis) =>
        analysis.ReviewItems.Count(item => item.Status != AnalysisReviewStatuses.NeedsReview);

    private static bool IsReviewItemOutstanding(QuoteTaskAnalysisReviewItem item) =>
        item.Status is AnalysisReviewStatuses.NeedsReview or AnalysisReviewStatuses.FieldVerification;

    private static bool AllReviewItemsResolved(QuoteTaskAnalysis analysis) =>
        analysis.ReviewItems.Count > 0 && analysis.ReviewItems.All(item => !IsReviewItemOutstanding(item));

    private static string ReviewStatusClass(string status) => status switch
    {
        AnalysisReviewStatuses.Accepted => "text-bg-success",
        AnalysisReviewStatuses.Resolved => "text-bg-primary",
        AnalysisReviewStatuses.NotApplicable => "text-bg-secondary",
        AnalysisReviewStatuses.FieldVerification => "text-bg-warning",
        _ => "text-bg-warning"
    };

    private int ReviewCatalogSelection(int reviewItemId) => reviewCatalogSelections.GetValueOrDefault(reviewItemId);

    private void SetReviewCatalogSelection(int reviewItemId, string? value) =>
        reviewCatalogSelections[reviewItemId] = int.TryParse(value, out var selected) ? selected : 0;

    private void SetReusableReviewRule(int reviewItemId, object? value)
    {
        if (value is true) localOnlyReviewItemIds.Remove(reviewItemId); else localOnlyReviewItemIds.Add(reviewItemId);
    }

    private void SetReusableMaterialRule(int materialId, object? value)
    {
        if (value is true) localOnlyMaterialIds.Remove(materialId); else localOnlyMaterialIds.Add(materialId);
    }

    private async Task SaveReusableReviewRuleAsync(ApplicationDbContext db, QuoteTaskAnalysisReviewItem item, string? userId)
    {
        if (localOnlyReviewItemIds.Contains(item.Id)
            || item.Status is AnalysisReviewStatuses.NeedsReview or AnalysisReviewStatuses.FieldVerification)
            return;
        var taskType = item.QuoteTaskAnalysis.QuoteProjectTask.TaskType;
        var ruleKind = item.ReviewKind == AnalysisReviewKinds.Assumption
            ? CentComResolutionRuleKinds.Assumption
            : CentComResolutionRuleKinds.Warning;
        var rule = await db.CentComResolutionRules.SingleOrDefaultAsync(x =>
            x.TaskType == taskType && x.RuleKind == ruleKind && x.MatchText == item.Description);
        if (rule is null)
        {
            rule = new CentComResolutionRule { TaskType = taskType, RuleKind = ruleKind, MatchText = item.Description };
            db.CentComResolutionRules.Add(rule);
        }
        rule.ReviewStatus = item.Status;
        rule.ResolutionAction = item.ResolutionAction;
        rule.EstimatorResponse = item.EstimatorResponse;
        rule.VendorProductId = item.AddedVendorProductId;
        rule.CreatedByUserId = userId;
        rule.CreatedAt = DateTimeOffset.UtcNow;
        rule.IsActive = true;
    }

