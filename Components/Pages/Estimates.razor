@page "/estimates"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,LocalOperator")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject OperationAccessService OperationAccess
@inject HousecallProDataService HousecallPro
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OperationalEventPublisher OperationalEvents
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Start Estimate</PageTitle>

<section class="dashboard-shell">
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">On-site estimating</p>
            <h1>Start Estimate</h1>
            <p class="dashboard-subtitle">Search by Housecall Pro estimate number, customer name, address, email, or phone. CCV will retrieve the customer and project address from Housecall Pro.</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert @(lookup is null ? "alert-warning" : "alert-info")">@message</div>
    }

    <section class="activity-panel">
        <h2>Find the starting estimate</h2>
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Local operation</label>
                <InputSelect class="form-select" @bind-Value="input.LocalOperationId" disabled="@lookingUp">
                    <option value="0">Select location…</option>
                    @foreach (var operation in operations)
                    {
                        <option value="@operation.Id">@operation.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-5">
                <label class="form-label">Estimate or customer search</label>
                <input class="form-control" @bind="input.EstimateNumber" @bind:event="oninput" placeholder="Example: 1308-1 or Stanley Kasakevics" disabled="@lookingUp" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" @onclick="FindEstimateAsync" disabled="@lookingUp">
                    @(lookingUp ? "Searching…" : "Search")
                </button>
            </div>
        </div>
    </section>

    @if (searchResults.Count > 0)
    {
        <section class="activity-panel mt-4">
            <h2>Matching Housecall Pro estimates</h2>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Estimate</th><th>Customer</th><th>Address</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var estimate in searchResults)
                    {
                        <tr>
                            <td>@estimate.EstimateNumber</td>
                            <td>@estimate.CustomerName<br /><small>@estimate.CustomerEmail @estimate.CustomerPhone</small></td>
                            <td>@estimate.CustomerAddress</td>
                            <td>@(estimate.EstimateDate?.ToLocalTime().ToString("MM/dd/yyyy") ?? "Not provided")</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectEstimate(estimate)">Use estimate</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (lookup is not null)
    {
        <section class="activity-panel mt-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <p class="eyebrow">Housecall Pro estimate @lookup.EstimateNumber</p>
                    <h2 class="mb-1">@lookup.CustomerName</h2>
                    <p class="mb-1">@lookup.CustomerAddress</p>
                    @if (!string.IsNullOrWhiteSpace(lookup.CustomerEmail) || !string.IsNullOrWhiteSpace(lookup.CustomerPhone))
                    {
                        <p class="text-muted mb-0">@lookup.CustomerEmail @lookup.CustomerPhone</p>
                    }
                </div>
                <span class="badge text-bg-success">Synchronized HCP record confirmed</span>
            </div>

            <EditForm Model="input" OnValidSubmit="CreateAsync" FormName="start-estimate" class="mt-4">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Initial visit notes or requested work</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="input.WorkDescription" placeholder="Optional notes known before the on-site visit" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" disabled="@creating">@(creating ? "Creating…" : "Start On-Site Estimate")</button>
                    </div>
                </div>
            </EditForm>
        </section>
    }

    <section class="mt-5">
        <h2>Estimate workspaces</h2>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Estimate</th><th>Location</th><th>Customer</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                <tbody>
                @foreach (var quote in quotes)
                {
                    <tr>
                        <td>CCV-E-@quote.Id.ToString("D6")<br /><small>HCP @(quote.HousecallProEstimateNumber ?? quote.HousecallProQuoteId)</small></td>
                        <td>@quote.LocalOperation.Name</td>
                        <td>@quote.CustomerName<br /><small>@quote.CustomerAddress</small></td>
                        <td>@quote.Status</td>
                        <td>@quote.UpdatedAt.ToLocalTime().ToString("MM/dd/yyyy")</td>
                        <td>
                            <div class="d-flex gap-2 justify-content-end">
                                <a class="btn btn-sm btn-outline-primary" href="@($"estimates/{quote.Id}")">Open workspace</a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@(deletingQuoteId == quote.Id)"
                                        @onclick="() => DeleteWorkspaceAsync(quote)">
                                    @(deletingQuoteId == quote.Id ? "Deleting…" : "Delete")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>

@code {
    private IReadOnlyList<LocalOperation> operations = [];
    private List<QuoteCase> quotes = [];
    private StartEstimateInput input = new();
    private HcpEstimateStartRecord? lookup;
    private List<HcpEstimateStartRecord> searchResults = [];
    private string? message;
    private bool lookingUp;
    private bool creating;
    private int? deletingQuoteId;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        operations = await OperationAccess.GetAccessibleOperationsAsync();
        var ids = operations.Select(x => x.Id).ToList();
        await using var db = await DbFactory.CreateDbContextAsync();
        quotes = await db.QuoteCases.AsNoTracking().Include(x => x.LocalOperation)
            .Where(x => ids.Contains(x.LocalOperationId))
            .OrderByDescending(x => x.UpdatedAt).ToListAsync();
    }

    private async Task FindEstimateAsync()
    {
        lookup = null;
        searchResults = [];
        message = null;
        var operation = operations.SingleOrDefault(x => x.Id == input.LocalOperationId);
        if (operation is null)
        {
            message = "Select the local operation for this estimate.";
            return;
        }
        if (string.IsNullOrWhiteSpace(input.EstimateNumber))
        {
            message = "Enter an estimate number, customer name, address, email, or phone.";
            return;
        }

        lookingUp = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            searchResults = (await HousecallPro.SearchEstimateStartsAsync(operation.Slug, input.EstimateNumber, timeout.Token)).ToList();
            var normalizedNumber = NormalizeEstimateNumber(input.EstimateNumber);
            var exactMatch = searchResults.FirstOrDefault(result =>
                result.EstimateNumber.Equals(normalizedNumber, StringComparison.OrdinalIgnoreCase));
            if (exactMatch is not null)
            {
                SelectEstimate(exactMatch);
            }
            else if (searchResults.Count == 1)
            {
                SelectEstimate(searchResults[0]);
            }
            else
            {
                message = searchResults.Count == 0
                    ? "No synchronized Housecall Pro estimates matched that number, customer, address, email, or phone."
                    : $"Select one of the {searchResults.Count} matching Housecall Pro estimates.";
            }
        }
        catch (Exception)
        {
            message = "Housecall Pro could not be reached. No estimate workspace was created.";
        }
        finally
        {
            lookingUp = false;
        }
    }

    private void SelectEstimate(HcpEstimateStartRecord estimate)
    {
        lookup = estimate;
        input.EstimateNumber = estimate.EstimateNumber;
        searchResults = [];
        message = "Confirm the customer and project address below, then start the on-site estimate.";
    }

    private static string NormalizeEstimateNumber(string value)
    {
        value = value.Trim();
        var separator = value.LastIndexOf('-');
        return separator > 0 && int.TryParse(value[(separator + 1)..], out _)
            ? value[..separator]
            : value;
    }

    private async Task CreateAsync()
    {
        if (lookup is null || creating) return;
        var operation = operations.SingleOrDefault(x => x.Id == input.LocalOperationId);
        if (operation is null) return;

        creating = true;
        var started = System.Diagnostics.Stopwatch.StartNew();
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var quote = new QuoteCase
        {
            LocalOperationId = operation.Id,
            HousecallProQuoteId = lookup.ExternalId,
            HousecallProEstimateNumber = lookup.EstimateNumber,
            CustomerName = lookup.CustomerName,
            CustomerEmail = lookup.CustomerEmail,
            CustomerAddress = lookup.CustomerAddress,
            WorkDescription = string.IsNullOrWhiteSpace(input.WorkDescription)
                ? "On-site estimate started from Housecall Pro."
                : input.WorkDescription.Trim(),
            AssignedUserId = user.FindFirstValue(ClaimTypes.NameIdentifier)
        };
        quote.Versions.Add(new QuoteVersion());
        quote.AuditEvents.Add(new QuoteAuditEvent
        {
            PreviousStatus = "",
            NewStatus = QuoteStatuses.Received,
            UserId = quote.AssignedUserId,
            Explanation = $"Estimate workspace created from live Housecall Pro estimate {lookup.EstimateNumber}."
        });
        quote.ProcessingJobs.Add(new QuoteProcessingJob
        {
            JobType = "Housecall Pro Estimate Retrieval",
            Status = "Completed",
            Message = $"Customer and project address retrieved for HCP estimate {lookup.EstimateNumber}."
        });
        quote.ProcessingJobs.Add(new QuoteProcessingJob { JobType = "CompanyCam Photo Retrieval", Status = "Disabled", Message = "Awaiting API configuration." });
        quote.ProcessingJobs.Add(new QuoteProcessingJob { JobType = "CentCom Image Analysis", Status = "Disabled", Message = "Awaiting WrightServer endpoint configuration." });

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Add(quote);
        await db.SaveChangesAsync();
        started.Stop();
        await OperationalEvents.PublishAsync(new(
            "CharlieCompany.Web", "Estimating", "StartEstimate", "Completed",
            $"Estimate CCV-E-{quote.Id:D6} started from HCP estimate {lookup.EstimateNumber}.",
            CorrelationId: $"estimate-{quote.Id:D6}",
            LocalOperationId: quote.LocalOperationId,
            QuoteCaseId: quote.Id,
            DurationMilliseconds: started.ElapsedMilliseconds));
        Navigation.NavigateTo($"estimates/{quote.Id}");
    }

    private async Task DeleteWorkspaceAsync(QuoteCase quote)
    {
        if (deletingQuoteId is not null) return;
        var estimateReference = quote.HousecallProEstimateNumber ?? quote.HousecallProQuoteId ?? $"CCV-E-{quote.Id:D6}";
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Do you really want to delete estimate workspace {estimateReference} for {quote.CustomerName}? This removes its CCV tasks, photos, pricing, and history. The Housecall Pro estimate will not be deleted.");
        if (!confirmed) return;

        deletingQuoteId = quote.Id;
        message = null;
        try
        {
            var allowedOperationIds = operations.Select(x => x.Id).ToList();
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.QuoteCases
                .Include(x => x.ProjectTasks).ThenInclude(x => x.Photos)
                .SingleOrDefaultAsync(x => x.Id == quote.Id && allowedOperationIds.Contains(x.LocalOperationId));
            if (tracked is null)
            {
                message = "The estimate workspace was not found or is no longer available to your assigned locations.";
                return;
            }

            var storedPaths = tracked.ProjectTasks
                .SelectMany(x => x.Photos)
                .Select(x => x.StoragePath)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
            var localOperationId = tracked.LocalOperationId;
            var deletedQuoteId = tracked.Id;
            db.QuoteCases.Remove(tracked);
            await db.SaveChangesAsync();

            foreach (var storedPath in storedPaths)
            {
                try
                {
                    if (File.Exists(storedPath)) File.Delete(storedPath);
                }
                catch (IOException)
                {
                    // The database record is authoritative; orphaned files can be cleaned up later.
                }
                catch (UnauthorizedAccessException)
                {
                    // The database record is authoritative; orphaned files can be cleaned up later.
                }
            }

            await OperationalEvents.PublishAsync(new(
                "CharlieCompany.Web", "Estimating", "DeleteEstimateWorkspace", "Completed",
                $"Estimate workspace {estimateReference} was deleted from CCV. The Housecall Pro estimate was not changed.",
                CorrelationId: $"estimate-{deletedQuoteId:D6}",
                LocalOperationId: localOperationId,
                QuoteCaseId: deletedQuoteId));
            message = $"Estimate workspace {estimateReference} was deleted from CCV. Housecall Pro was not changed.";
            await ReloadAsync();
        }
        catch (DbUpdateException)
        {
            message = "The estimate workspace could not be deleted because related records are still in use.";
        }
        finally
        {
            deletingQuoteId = null;
        }
    }

    private sealed class StartEstimateInput
    {
        [Range(1, int.MaxValue)] public int LocalOperationId { get; set; }
        [Required, StringLength(100)] public string EstimateNumber { get; set; } = "";
        [StringLength(2000)] public string? WorkDescription { get; set; }
    }
}
