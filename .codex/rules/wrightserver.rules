prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Pushing repository changes requires explicit user approval.")
prefix_rule(pattern = ["git", ["reset", "clean"]], decision = "prompt", justification = "Destructive Git cleanup requires explicit user approval.")
prefix_rule(pattern = ["dotnet", "ef", "database"], decision = "prompt", justification = "Database schema operations require explicit approval and target verification.")
prefix_rule(pattern = ["docker", ["ps", "logs", "inspect", "version", "info"]], decision = "allow", justification = "Read-only Docker inspection is routine diagnostics.")
prefix_rule(pattern = ["docker", ["run", "create", "start", "stop", "restart", "kill", "rm", "rmi", "exec", "build", "pull", "push", "tag", "update", "rename", "commit", "import", "load", "save", "login", "logout", "compose", "container", "image", "network", "volume", "system", "swarm", "service", "stack"]], decision = "prompt", justification = "Docker mutations can affect shared services, networks, images, and persistent data.")
prefix_rule(pattern = ["cloudflared"], decision = "prompt", justification = "Cloudflare tunnel operations require explicit user approval.")
prefix_rule(pattern = ["ssh"], decision = "prompt", justification = "Remote-host operations require explicit approval and target verification.")
prefix_rule(pattern = ["scp"], decision = "prompt", justification = "Remote file transfers require explicit approval and target verification.")
prefix_rule(pattern = ["kubectl"], decision = "prompt", justification = "Cluster operations require explicit approval and context verification.")
prefix_rule(pattern = ["terraform"], decision = "prompt", justification = "Infrastructure changes require explicit user approval.")
prefix_rule(pattern = ["netsh", "advfirewall"], decision = "prompt", justification = "Firewall changes require explicit user approval.")
prefix_rule(pattern = [["Start-VM", "Stop-VM", "Restart-VM", "Remove-VM", "Checkpoint-VM", "Restore-VMSnapshot"]], decision = "prompt", justification = "Hyper-V lifecycle operations require explicit user approval.")
