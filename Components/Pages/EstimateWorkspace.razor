@page "/estimates/{QuoteId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,LocalOperator")]
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject OperationAccessService OperationAccess
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OperationalEventPublisher OperationalEvents
@inject CentComTaskAnalysisService CentComTaskAnalysis
@inject EstimateMaterialEmailService EstimateMaterialEmails
@inject EstimateAdminAuditEmailService EstimateAdminAuditEmails
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Preliminary Estimate</PageTitle>

@if (quote is null)
{
    <h1>Estimate not found</h1>
    <p>This estimate is not available to your assigned locations.</p>
}
else
{
    <section class="dashboard-shell">
        <div class="dashboard-header estimate-form-header">
            <div>
                <p class="eyebrow">@quote.LocalOperation.Name</p>
                <h1>Preliminary Estimate</h1>
                <p class="dashboard-subtitle">
                    Housecall Pro Estimate #@(quote.HousecallProEstimateNumber ?? "Not provided")
                </p>
            </div>
            <div class="dashboard-status">
                <span>@quote.Status</span>
                <small>Version @version?.VersionNumber</small>
            </div>
        </div>

        <p><a href="estimates">Back to estimates</a></p>

        @if (message is not null)
        {
            <div class="alert alert-info">@message</div>
        }

        <section class="activity-panel estimate-customer-panel">
            <p class="eyebrow">On-site inspection</p>
            <div class="row g-4">
                <div class="col-md-6">
                    <span class="form-label">Prepared for</span>
                    <h2 class="mb-1">@quote.CustomerName</h2>
                </div>
                <div class="col-md-6">
                    <span class="form-label">Project address</span>
                    <p class="fs-5 mb-0">@(quote.CustomerAddress ?? "Address not provided")</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(quote.CustomerEmail))
                {
                    <div class="col-md-6">
                        <span class="form-label">Customer email</span>
                        <p class="mb-0">@quote.CustomerEmail</p>
                    </div>
                }
                <div class="col-md-6">
                    <span class="form-label">Estimate date</span>
                    <p class="mb-0">@quote.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")</p>
                </div>
            </div>
        </section>

        <section class="activity-panel">
            <h2>Project Overview Notes</h2>
            <p class="dashboard-subtitle">
                Record the overall customer request, site context, project goals, constraints, and other information that applies to the entire estimate.
            </p>
            <div class="dictation-input-wrapper">
                <InputTextArea id="project-overview-notes"
                               class="form-control project-overview-notes"
                               rows="6"
                               maxlength="2000"
                               @bind-Value="quote.WorkDescription"
                               placeholder="Dictate or enter a general description of the project to be done." />
                <button type="button"
                        class="dictation-toggle @(IsDictating(ProjectOverviewElementId) ? "active" : null)"
                        aria-label="@(IsDictating(ProjectOverviewElementId) ? "Stop project overview dictation" : "Start project overview dictation")"
                        aria-pressed="@IsDictating(ProjectOverviewElementId)"
                        title="@(IsDictating(ProjectOverviewElementId) ? "Stop dictation" : "Start dictation")"
                        @onclick="() => ToggleDictationAsync(ProjectOverviewElementId)">
                    <span aria-hidden="true">🎙</span>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(GetDictationMessage(ProjectOverviewElementId)))
            {
                <small class="@(IsDictating(ProjectOverviewElementId) ? "text-danger" : "text-muted") d-block mt-2">@GetDictationMessage(ProjectOverviewElementId)</small>
            }
            <small class="text-muted d-block mt-2">These notes apply to every project task in this estimate.</small>
        </section>

        <section class="activity-panel project-tasks-disclosure">
            <button type="button" class="project-tasks-summary" aria-expanded="@projectTasksExpanded" @onclick="ToggleProjectTasks">
                <div>
                    <h2>Project Tasks</h2>
                    <p class="dashboard-subtitle mb-0">
                        Add every distinct part of the project. CentCom will analyze each task’s photographs and dictated scope of work separately.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-light">@quote.ProjectTasks.Count task(s)</span>
                    <span class="disclosure-chevron @(projectTasksExpanded ? "expanded" : null)" aria-hidden="true">⌄</span>
                </div>
            </button>
            @if (projectTasksExpanded)
            {
            <div class="project-tasks-body">
                <div class="project-task-add-controls">
                    <InputSelect class="form-select" @bind-Value="newTaskType">
                        <option value="">Select task type</option>
                        @foreach (var taskType in ProjectTaskTypes.All)
                        {
                            <option value="@taskType">@taskType</option>
                        }
                    </InputSelect>
                    <button type="button"
                            class="btn btn-primary text-nowrap"
                            disabled="@string.IsNullOrWhiteSpace(newTaskType)"
                            @onclick="AddProjectTaskAsync">
                        Add Project Task
                    </button>
                </div>

        @if (quote.ProjectTasks.Count == 0)
        {
            <div class="alert alert-light border mb-0">
                <p class="mb-0">No project tasks have been added. Select a project task type above to begin.</p>
            </div>
        }

        @{
            var orderedTasks = quote.ProjectTasks.OrderBy(x => x.SortOrder).ToList();
        }
        @for (var taskIndex = 0; taskIndex < orderedTasks.Count; taskIndex++)
        {
            var task = orderedTasks[taskIndex];
            var taskNumber = taskIndex + 1;
            <section class="activity-panel project-task-panel" @key="task.Id">
                <button type="button"
                        class="project-task-toggle"
                        aria-expanded="@expandedTaskIds.Contains(task.Id)"
                        @onclick="() => ToggleProjectTask(task.Id)">
                    <div class="project-task-toggle-title">
                        <small>Project Task @taskNumber</small>
                        <h2>@task.TaskType</h2>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-light">@task.Photos.Count photo(s)</span>
                        <span class="project-task-chevron" aria-hidden="true">@(expandedTaskIds.Contains(task.Id) ? "−" : "+")</span>
                    </div>
                </button>

                @if (expandedTaskIds.Contains(task.Id))
                {
                    var analysis = LatestAnalysis(task);
                    <div class="project-task-body">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Work type</label>
                                <InputSelect class="form-select" @bind-Value="task.WorkType" @bind-Value:after="() => AutoSaveProjectTaskAsync(task)">
                                    <option value="">Select work type…</option>
                                    @foreach (var workType in ProjectWorkTypes.All) { <option value="@workType">@workType</option> }
                                </InputSelect>
                                <small class="text-muted">Controls the applicable supply kit, crew rate, and target margin.</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Scope of Work</label>
                                @{
                                    var taskScopeElementId = $"task-scope-{task.Id}";
                                }
                                <div class="dictation-input-wrapper">
                                    <InputTextArea id="@taskScopeElementId"
                                                   class="form-control estimate-notes-input"
                                                   rows="7"
                                                   maxlength="4000"
                                                   @bind-Value="task.ScopeOfWork"
                                                   @bind-Value:after="() => AutoSaveProjectTaskAsync(task)"
                                                   placeholder="Dictate or enter what needs to be done for this project task, including dimensions, existing conditions, selections, exclusions, and special instructions…" />
                                    <button type="button"
                                            class="dictation-toggle @(IsDictating(taskScopeElementId) ? "active" : null)"
                                            aria-label="@(IsDictating(taskScopeElementId) ? $"Stop {task.TaskType} scope dictation" : $"Start {task.TaskType} scope dictation")"
                                            aria-pressed="@IsDictating(taskScopeElementId)"
                                            title="@(IsDictating(taskScopeElementId) ? "Stop dictation" : "Start dictation")"
                                            @onclick="() => ToggleDictationAsync(taskScopeElementId)">
                                        <span aria-hidden="true">🎙</span>
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(GetDictationMessage(taskScopeElementId)))
                                {
                                    <small class="@(IsDictating(taskScopeElementId) ? "text-danger" : "text-muted") d-block mt-2">@GetDictationMessage(taskScopeElementId)</small>
                                }
                                <small class="text-muted">Voice dictation can use the device’s built-in microphone or keyboard dictation.</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Estimated job days</label>
                                <InputNumber class="form-control" min="0" step="0.5" @bind-Value="task.EstimatedDays" @bind-Value:after="() => AutoSaveProjectTaskAsync(task)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Crew size override</label>
                                <InputNumber class="form-control" min="0" step="0.5" @bind-Value="task.CrewSizeOverride" @bind-Value:after="() => AutoSaveProjectTaskAsync(task)" />
                                <small class="text-muted">Leave blank for policy default.</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Daily crew cost override</label>
                                <InputNumber class="form-control" min="0" step="1" @bind-Value="task.DailyCrewCostOverride" @bind-Value:after="() => AutoSaveProjectTaskAsync(task)" />
                                <small class="text-muted">Leave blank for policy default.</small>
                            </div>
                        </div>

                <div class="picture-capture-panel mt-4">
                    <h3>@task.TaskType Picture Guide</h3>
                    <p class="text-muted">Photographs are optional supporting documentation. CentCom will use the saved task scope and dimensions when photos are not supplied.</p>
                    <div class="photo-requirement-grid">
                        @foreach (var requirement in ProjectPhotoGuidance.For(task.TaskType))
                        {
                            var captured = task.Photos.Where(x => x.RequirementKey == requirement.Key).OrderByDescending(x => x.CapturedAt).ToList();
                            <article class="photo-requirement-card">
                                <div class="photo-guide-preview @PhotoGuidePanelClass(requirement.Key)">
                                    <div class="photo-guide-overlay">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <strong>@requirement.Label</strong>
                                            <span class="badge @(captured.Count > 0 ? "text-bg-success" : "text-bg-secondary")">
                                                @(captured.Count > 0 ? "Added" : "Optional")
                                            </span>
                                        </div>
                                        <p>@requirement.Instructions</p>
                                    </div>
                                </div>
                                <InputFile class="form-control"
                                           OnChange="args => CapturePicturesAsync(task, requirement, args)"
                                           accept="image/*"
                                           capture="environment" />
                                @foreach (var photo in captured)
                                {
                                    <small class="d-block mt-2">📷 @photo.OriginalFileName · @FormatFileSize(photo.FileSize)</small>
                                }
                            </article>
                        }
                    </div>
                    @if (task.Photos.Any(x => x.RequirementKey == "additional"))
                    {
                        <h4 class="mt-4">Additional Photographs</h4>
                        <div class="project-photo-list mt-3">
                            @foreach (var photo in task.Photos.Where(x => x.RequirementKey == "additional").OrderBy(x => x.CapturedAt))
                            {
                                <div class="project-photo-item">
                                    <span aria-hidden="true">📷</span>
                                    <div>
                                        <strong>@photo.OriginalFileName</strong>
                                        <small>@FormatFileSize(photo.FileSize) · @photo.CapturedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-3">
                        <label class="form-label">Optional additional photographs</label>
                        <InputFile class="form-control"
                                   OnChange="args => CapturePicturesAsync(task, AdditionalPhotoRequirement, args)"
                                   accept="image/*"
                                   capture="environment"
                                   multiple />
                    </div>
                </div>
                        <details class="centcom-analysis-disclosure border rounded mt-4">
                            <summary class="centcom-analysis-summary">
                                <div>
                                    <h3 class="mb-1">CentCom Analysis</h3>
                                    <p class="text-muted mb-0">
                                        Revisioned material quantities and provisional costs for this project task.
                                    </p>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @AnalysisStatusClass(analysis?.Status)">
                                        @(analysis?.Status ?? QuoteTaskAnalysisStatuses.NotSubmitted)
                                    </span>
                                    <span class="disclosure-chevron" aria-hidden="true">⌄</span>
                                </div>
                            </summary>
                            <div class="centcom-analysis-body">

                            @if (analysis is null)
                            {
                                <div class="alert alert-light border mt-3 mb-0">
                                    This task has not been submitted to CentCom.
                                </div>
                            }
                            else
                            {
                                var assumptionItems = AnalysisNoteItems(analysis.Assumptions, "Assumption");
                                var warningItems = AnalysisNoteItems(analysis.QuestionsAndWarnings, "Review item");
                                var pendingAssumptionItems = analysis.ReviewItems
                                    .Where(item => item.ReviewKind == AnalysisReviewKinds.Assumption && IsReviewItemOutstanding(item))
                                    .OrderBy(item => item.SortOrder)
                                    .ToList();
                                var pendingReviewItems = analysis.ReviewItems
                                    .Where(item => item.ReviewKind == AnalysisReviewKinds.Warning && IsReviewItemOutstanding(item))
                                    .OrderBy(item => item.SortOrder)
                                    .ToList();
                                <dl class="row mt-3 mb-2">
                                    <dt class="col-sm-3">Revision</dt>
                                    <dd class="col-sm-9">@analysis.RevisionNumber</dd>
                                    <dt class="col-sm-3">Submitted</dt>
                                    <dd class="col-sm-9">@analysis.SubmittedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</dd>
                                    <dt class="col-sm-3">Model</dt>
                                    <dd class="col-sm-9">@(analysis.ModelVersion ?? "Pending")</dd>
                                </dl>

                                @if (assumptionItems.Count > 0)
                                {
                                    <details class="analysis-note-disclosure assumption-notes border rounded mb-3">
                                        <summary class="analysis-note-summary">
                                            <span><strong>Assumptions</strong><small>@pendingAssumptionItems.Count item(s) requiring estimator review</small></span>
                                            <span class="badge @(pendingAssumptionItems.Count == 0 ? "text-bg-success" : "text-bg-warning")">@(pendingAssumptionItems.Count == 0 ? "Complete" : "Review")</span>
                                            <span class="disclosure-chevron" aria-hidden="true">⌄</span>
                                        </summary>
                                        <div class="analysis-note-body">
                                            <div class="analysis-review-grid">
                                                @foreach (var item in pendingAssumptionItems)
                                                {
                                                    <article class="analysis-review-card">
                                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                                            <div><strong>@item.Category</strong><p>@item.Description</p></div>
                                                            <span class="badge @ReviewStatusClass(item.Status)">@item.Status</span>
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SaveReviewDispositionAsync(item, AnalysisReviewStatuses.Accepted)">Accept assumption</button>
                                                        </div>
                                                        <div class="form-check mt-2">
                                                            <input class="form-check-input" type="checkbox" checked="@(!localOnlyReviewItemIds.Contains(item.Id))" @onchange="args => SetReusableReviewRule(item.Id, args.Value)" />
                                                            <label class="form-check-label">Remember this resolution for future @task.TaskType tasks</label>
                                                        </div>
                                                        <details class="mt-3 resolution-action-panel" open="@(item.Status == AnalysisReviewStatuses.FieldVerification)">
                                                            <summary>Reject and correct this assumption</summary>
                                                            <div class="row g-2 mt-1">
                                                                <div class="col-lg-4">
                                                                    <label class="form-label">Resolution</label>
                                                                    <select class="form-select form-select-sm" @bind="item.ResolutionAction">
                                                                        <option value="">Select how to resolve…</option>
                                                                        @foreach (var action in AssumptionResolutionActions.All)
                                                                        {
                                                                            <option value="@action">@action</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="col-lg-8">
                                                                    <label class="form-label">Correction or estimator response</label>
                                                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="item.EstimatorResponse" placeholder="Enter the confirmed condition, measurement, exclusion, or decision…" />
                                                                </div>
                                                            </div>
                                                            @if (item.ResolutionAction == AssumptionResolutionActions.ChangeMaterials)
                                                            {
                                                                <div class="row g-2 mt-2">
                                                                    <div class="col-lg-7">
                                                                        <select class="form-select form-select-sm" value="@ReviewCatalogSelection(item.Id)" @onchange="args => SetReviewCatalogSelection(item.Id, args.Value?.ToString())">
                                                                            <option value="0">Select catalog product…</option>
                                                                            @foreach (var catalogItem in reviewCatalogItems.Where(x => CurrentCatalogPrice(x) is not null))
                                                                            {
                                                                                <option value="@catalogItem.Id">@catalogItem.Product.Name — @catalogItem.SupplyVendor.Name — @CurrentCatalogPrice(catalogItem)!.UnitPrice.ToString("C2")</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-lg-2"><InputNumber class="form-control form-control-sm" min="0.01" step="1" @bind-Value="item.AddedProductQuantity" placeholder="Qty" /></div>
                                                                    <div class="col-lg-3"><button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => AddReviewCatalogProductAsync(analysis, item)">Add product &amp; resolve</button></div>
                                                                </div>
                                                            }
                                                            else if (item.ResolutionAction == AssumptionResolutionActions.AddTaskFee)
                                                            {
                                                                <div class="row g-2 mt-2">
                                                                    <div class="col-lg-5"><InputText class="form-control form-control-sm" @bind-Value="item.AdditionalFeeName" placeholder="Fee name" /></div>
                                                                    <div class="col-lg-3"><InputNumber class="form-control form-control-sm" min="0" step="1" @bind-Value="item.AdditionalFeeAmount" placeholder="Amount" /></div>
                                                                    <div class="col-lg-4"><button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => AddReviewFeeAsync(item)">Add fee &amp; resolve</button></div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="() => ResolveAssumptionAsync(item)">Save assumption resolution</button>
                                                            }
                                                        </details>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    </details>
                                }
                                @if (warningItems.Count > 0)
                                {
                                    <details class="analysis-note-disclosure warning-notes border rounded mb-3">
                                        <summary class="analysis-note-summary">
                                            <span><strong>Questions and warnings</strong><small>@pendingReviewItems.Count item(s) requiring estimator review</small></span>
                                            <span class="badge @(AllReviewItemsResolved(analysis) ? "text-bg-success" : "text-bg-warning")">@(AllReviewItemsResolved(analysis) ? "Complete" : "Review")</span>
                                            <span class="disclosure-chevron" aria-hidden="true">⌄</span>
                                        </summary>
                                        <div class="analysis-note-body">
                                            <div class="analysis-review-grid">
                                                @foreach (var item in pendingReviewItems)
                                                {
                                                    <article class="analysis-review-card @(item.Status == AnalysisReviewStatuses.NeedsReview ? null : "resolved")">
                                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                                            <div><strong>@item.Category</strong><p>@item.Description</p></div>
                                                            <span class="badge @ReviewStatusClass(item.Status)">@item.Status</span>
                                                        </div>
                                                        <label class="form-label mt-2">Estimator response</label>
                                                        <InputTextArea class="form-control" rows="2" @bind-Value="item.EstimatorResponse" placeholder="Document the confirmed condition, measurement, or decision…" />
                                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SaveReviewDispositionAsync(item, AnalysisReviewStatuses.Accepted)">Accept as stated</button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveReviewDispositionAsync(item, AnalysisReviewStatuses.Resolved)">Resolve with response</button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveReviewDispositionAsync(item, AnalysisReviewStatuses.NotApplicable)">Not applicable</button>
                                                        </div>
                                                        <div class="form-check mt-2">
                                                            <input class="form-check-input" type="checkbox" checked="@(!localOnlyReviewItemIds.Contains(item.Id))" @onchange="args => SetReusableReviewRule(item.Id, args.Value)" />
                                                            <label class="form-check-label">Remember this resolution for future @task.TaskType tasks</label>
                                                        </div>
                                                        <details class="mt-3 resolution-action-panel">
                                                            <summary>Add a catalog product or task fee</summary>
                                                            <div class="row g-2 mt-1">
                                                                <div class="col-lg-7">
                                                                    <select class="form-select form-select-sm" value="@ReviewCatalogSelection(item.Id)" @onchange="args => SetReviewCatalogSelection(item.Id, args.Value?.ToString())">
                                                                        <option value="0">Select catalog product…</option>
                                                                        @foreach (var catalogItem in reviewCatalogItems.Where(x => CurrentCatalogPrice(x) is not null))
                                                                        {
                                                                            <option value="@catalogItem.Id">@catalogItem.Product.Name — @catalogItem.SupplyVendor.Name — @CurrentCatalogPrice(catalogItem)!.UnitPrice.ToString("C2")</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="col-lg-2"><InputNumber class="form-control form-control-sm" min="0.01" step="1" @bind-Value="item.AddedProductQuantity" placeholder="Qty" /></div>
                                                                <div class="col-lg-3"><button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => AddReviewCatalogProductAsync(analysis, item)">Add product &amp; resolve</button></div>
                                                                <div class="col-lg-5"><InputText class="form-control form-control-sm" @bind-Value="item.AdditionalFeeName" placeholder="Fee name (permit, disposal, rental…)" /></div>
                                                                <div class="col-lg-2"><InputNumber class="form-control form-control-sm" min="0" step="1" @bind-Value="item.AdditionalFeeAmount" placeholder="Amount" /></div>
                                                                <div class="col-lg-3"><button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="() => AddReviewFeeAsync(item)">Add fee &amp; resolve</button></div>
                                                            </div>
                                                        </details>
                                                    </article>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-primary mt-3" disabled="@(!AllReviewItemsResolved(analysis))" @onclick="() => ReanalyzeWithResolutionsAsync(task, analysis)">Reanalyze with resolutions</button>
                                        </div>
                                    </details>
                                }
                                @if (analysis.Exclusions.Count > 0)
                                {
                                    <div class="alert alert-secondary">
                                        <strong>Excluded by costing policy</strong>
                                        <ul class="mb-0 mt-2">
                                            @foreach (var excluded in analysis.Exclusions.OrderBy(x => x.Description))
                                            {
                                                <li>@excluded.Description — @excluded.Reason</li>
                                            }
                                        </ul>
                                        <small>These entries are retained for audit purposes but are not included in the material subtotal.</small>
                                    </div>
                                }

                                @if (analysis.Materials.Count == 0)
                                {
                                    <p class="text-muted">No material recommendations have been returned yet.</p>
                                }
                                else
                                {
                                    @foreach (var vendorGroup in analysis.Materials
                                        .Where(x => !x.IsRemoved)
                                        .OrderBy(x => x.SortOrder)
                                        .GroupBy(MaterialVendorName)
                                        .OrderBy(group => MaterialVendorSortOrder(group.Key))
                                        .ThenBy(group => group.Key))
                                    {
                                    <details class="vendor-analysis-disclosure border rounded mb-3">
                                        <summary class="vendor-analysis-summary">
                                            <div>
                                                <h4 class="mb-0">@vendorGroup.Key</h4>
                                                <small>@vendorGroup.Count() item(s)</small>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <strong>@vendorGroup.Sum(item => item.ExtendedCost).ToString("C2")</strong>
                                                <span class="disclosure-chevron" aria-hidden="true">⌄</span>
                                            </div>
                                        </summary>
                                    <div class="vendor-analysis-body">
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle material-analysis-table">
                                            <thead>
                                                <tr>
                                                    <th>SKU / Material</th>
                                                    <th>Quantity</th>
                                                    <th>Unit cost</th>
                                                    <th>Waste</th>
                                                    <th>Extended</th>
                                                    <th>Source</th>
                                                    <th>Match / review</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in vendorGroup)
                                                {
                                                    <tr class="@(item.IsRemoved ? "table-secondary" : item.MatchKind is MaterialMatchKinds.HomeDepotSimilar or MaterialMatchKinds.Unresolved ? "table-warning" : null)">
                                                        <td data-label="SKU / Material">
                                                            <strong>@(item.VendorSku ?? "No catalog SKU")</strong><br />
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputText class="form-control form-control-sm mb-1" @bind-Value="item.VendorSku" placeholder="SKU (optional for one-off)" />
                                                                <InputText class="form-control form-control-sm" @bind-Value="item.Description" />
                                                            }
                                                            else
                                                            {
                                                                <small>@item.Description</small>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(item.OriginalDescription) &&
                                                                !item.OriginalDescription.Equals(item.Description, StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <br /><small class="text-warning-emphasis"><strong>Originally requested:</strong> @item.OriginalDescription</small>
                                                            }
                                                        </td>
                                                        <td data-label="Quantity">
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.Quantity" />
                                                                <InputText class="form-control form-control-sm mt-1" @bind-Value="item.Unit" />
                                                            }
                                                            else
                                                            {
                                                                @($"{item.Quantity:N2} {item.Unit}")
                                                            }
                                                        </td>
                                                        <td data-label="Unit cost">
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.UnitCost" />
                                                            }
                                                            else
                                                            {
                                                                @item.UnitCost.ToString("C2")
                                                            }
                                                        </td>
                                                        <td data-label="Waste">
                                                            @if (editingAnalysisIds.Contains(analysis.Id))
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="item.WastePercent" />
                                                            }
                                                            else
                                                            {
                                                                @($"{item.WastePercent:N1}%")
                                                            }
                                                        </td>
                                                        <td data-label="Extended">@item.ExtendedCost.ToString("C2")</td>
                                                        <td data-label="Source">
                                                            @(item.SourceReference ?? item.SourceType ?? "Not supplied")
                                                            @if (item.SourcePriceDate is not null)
                                                            {
                                                                <br /><small>@item.SourcePriceDate.Value.ToString("MM/dd/yyyy")</small>
                                                            }
                                                        </td>
                                                        <td data-label="Match / review">
                                                            <span class="badge @MaterialMatchClass(item.MatchKind)">@item.MatchKind</span><br />
                                                            <small>@item.MatchConfidence.ToString("P0") · @item.ReviewDecision</small>
                                                        </td>
                                                        <td data-label="Actions">
                                                            @if (analysis.Status == QuoteTaskAnalysisStatuses.NeedsReview)
                                                            {
                                                                <div class="d-grid gap-1">
                                                                    @if (item.MatchKind == MaterialMatchKinds.Unresolved || item.IsUnmatched)
                                                                    {
                                                                        <div class="form-check text-start mb-1">
                                                                            <input class="form-check-input" type="checkbox" checked="@(!localOnlyMaterialIds.Contains(item.Id))" @onchange="args => SetReusableMaterialRule(item.Id, args.Value)" />
                                                                            <label class="form-check-label">Remember for future @task.TaskType tasks</label>
                                                                        </div>
                                                                    }
                                                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SetMaterialDecisionAsync(analysis, item, MaterialReviewDecisions.Accepted)">Accept item</button>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SetMaterialDecisionAsync(analysis, item, MaterialReviewDecisions.Removed)">Remove</button>
                                                                    <select class="form-select form-select-sm"
                                                                            @key="ReplacementSelectKey(item)"
                                                                            value="0"
                                                                            disabled="@replacingMaterialIds.Contains(item.Id)"
                                                                            @onchange="async args => await SelectReplacementFromCatalogAsync(analysis, item, args.Value?.ToString())">
                                                                        <option value="0">Replace from catalog…</option>
                                                                        @foreach (var catalogItem in reviewCatalogItems)
                                                                        {
                                                                            var catalogPrice = CurrentCatalogPrice(catalogItem);
                                                                            <option value="@catalogItem.Id" disabled="@(catalogPrice is null)">@catalogItem.Product.Name — @catalogItem.SupplyVendor.Name / @catalogItem.VendorSku@(catalogPrice is null ? " — no active price" : $" — {catalogPrice.UnitPrice:C2}")</option>
                                                                        }
                                                                    </select>
                                                                    <small class="text-muted">@(replacingMaterialIds.Contains(item.Id) ? "Applying replacement…" : "Selecting an item replaces this row immediately.")</small>
                                                                    @if (editingAnalysisIds.Contains(analysis.Id) && !item.IsRemoved)
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddMaterialToHomeDepotCatalogAsync(analysis, item)">Save as Home Depot catalog item</button>
                                                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MarkMaterialOneOffAsync(analysis, item)">Use price once</button>
                                                                    }
                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th colspan="4">@vendorGroup.Key subtotal</th>
                                                    <th>@vendorGroup.Sum(item => item.ExtendedCost).ToString("C2")</th>
                                                    <th colspan="3"></th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                    </div>
                                    </details>
                                    }
                                    <div class="alert alert-light border d-flex justify-content-between align-items-center">
                                        <strong>Overall material subtotal</strong>
                                        <strong>@analysis.MaterialSubtotal.ToString("C2")</strong>
                                    </div>
                                    @if (analysis.Materials.Any(x => x.IsRemoved))
                                    {
                                        <details class="mt-2">
                                            <summary class="text-muted">Removed materials (@analysis.Materials.Count(x => x.IsRemoved))</summary>
                                            <ul class="mb-0 mt-2">
                                                @foreach (var removed in analysis.Materials.Where(x => x.IsRemoved).OrderBy(x => x.SortOrder))
                                                {
                                                    <li>@removed.Description</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                    @if (analysis.Status == QuoteTaskAnalysisStatuses.NeedsReview && editingAnalysisIds.Contains(analysis.Id))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="() => AddManualMaterialLine(analysis)">Add material manually</button>
                                    }
                                }
                            }

                            <div class="d-flex gap-2 flex-wrap mt-3">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        disabled="@(!CanSubmitOrReanalyze(analysis))"
                                        @onclick="() => SubmitOrReanalyzeAsync(task, analysis)">
                                    @(analysis is null ? "Analyze" : analysis.ReviewItems.Count > 0 ? "Reanalyze with resolutions" : "Reanalyze")
                                </button>
                                @if (analysis?.Status == QuoteTaskAnalysisStatuses.NeedsReview)
                                {
                                    @if (editingAnalysisIds.Contains(analysis.Id))
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="() => SaveAnalysisEditsAsync(analysis)">Save edits</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => CancelAnalysisEditsAsync(analysis.Id)">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => editingAnalysisIds.Add(analysis.Id)">Edit</button>
                                    }
                                }
                            </div>
                            </div>
                        </details>
                        <div class="project-task-actions">
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    @onclick="() => DeleteProjectTaskAsync(task)">
                                Delete Task
                            </button>
                        </div>
                    </div>
                }
            </section>
            }
            </div>
            }
        </section>

        @{
            var pricingAnalyses = PricingAnalyses().ToList();
            var hasPreliminaryPricing = pricingAnalyses.Any(x => x.Status != QuoteTaskAnalysisStatuses.Accepted);
        }
        <AuthorizeView Roles="@ApplicationRoles.Administrator">
            <Authorized>
                <section class="activity-panel pricing-workspace job-cost-panel">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <p class="eyebrow">Internal estimating</p>
                    <h2>Job Cost &amp; Margin</h2>
                    <p class="dashboard-subtitle mb-0">What the job costs CCV, the gross margin we want, and the resulting selling price before customer discounts.</p>
                </div>
                @if (currentCostSnapshot is not null)
                {
                    <span class="badge @(hasPreliminaryPricing ? "text-bg-warning" : "text-bg-secondary")">@(hasPreliminaryPricing ? "Preliminary pricing" : $"Cost snapshot r{currentCostSnapshot.RevisionNumber}")</span>
                }
            </div>
            @if (pricingAnalyses.Count == 0)
            {
                <div class="alert alert-light border mt-3 mb-0">
                    Complete the CentCom analysis to calculate preliminary job and customer totals.
                </div>
            }
            else if (currentCostSnapshot is null)
            {
                <div class="alert alert-warning mt-3 mb-0">Automatic pricing is waiting for an active costing policy.</div>
            }
            else
            {
                <div class="job-economics-grid mt-3">
                    <article class="pricing-value-card cost-value">
                        <span>Current cost to perform job</span>
                        <strong>@currentCostSnapshot.TotalCost.ToString("C2")</strong>
                        <small>Materials, labor, supplies, overhead, and contingency</small>
                    </article>
                    <article class="pricing-input-card">
                        <label class="form-label" for="job-target-margin">Desired gross margin</label>
                        <div class="input-group input-group-lg">
                            <input id="job-target-margin" type="number" class="form-control" min="1" max="99" step="1" value="@pricingTargetMargin" @oninput="OnTargetMarginInput" />
                            <span class="input-group-text">%</span>
                        </div>
                        <small>Company policy: @currentCostSnapshot.CostingPolicyVersion.DefaultTargetMarginPercent.ToString("N2")%</small>
                    </article>
                    <article class="pricing-value-card sell-value">
                        <span>Selling price before discount</span>
                        <strong>@PricingBasePrice.ToString("C2")</strong>
                        <small>@PricingGrossProfit.ToString("C2") gross profit before discount</small>
                    </article>
                </div>

                <details class="mt-3">
                    <summary class="fw-semibold">View task-level cost breakdown</summary>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Task</th><th>CentCom materials</th><th>Required supplies</th><th>Labor</th><th>Task costs</th><th>Allocated overhead</th><th>Margin</th><th>Suggested price</th></tr></thead>
                        <tbody>
                            @foreach (var taskCost in currentCostSnapshot.Tasks.OrderBy(x => x.QuoteProjectTask.SortOrder))
                            {
                                <tr>
                                    <td>Task @taskCost.QuoteProjectTask.SortOrder - @taskCost.QuoteProjectTask.TaskType<br /><small>@(taskCost.QuoteProjectTask.WorkType ?? "Unclassified") · @taskCost.EstimatedDays:N1 day(s), @taskCost.CrewSize:N1 crew</small></td>
                                    <td>@taskCost.MaterialCost.ToString("C2")</td>
                                    <td>
                                        @taskCost.RequiredSupplyCost.ToString("C2")
                                        @if (taskCost.RequiredSupplies.Count > 0)
                                        {
                                            <details><summary>@taskCost.RequiredSupplies.Count item(s)</summary><ul class="small mb-0">@foreach (var item in taskCost.RequiredSupplies) { <li>@item.KitName: @item.Description — @item.Quantity.ToString("N2") × @item.UnitCost.ToString("C2")</li> }</ul></details>
                                        }
                                    </td>
                                    <td>@taskCost.LaborCost.ToString("C2")</td>
                                    <td>@taskCost.TaskOverhead.ToString("C2")</td>
                                    <td>@taskCost.AllocatedProjectOverhead.ToString("C2")</td>
                                    <td>@taskCost.TargetMarginPercent.ToString("N2")%</td>
                                    <td><strong>@taskCost.SuggestedCustomerPrice.ToString("C2")</strong><br /><small>Cost @taskCost.TotalCost.ToString("C2")</small></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="7">Project overhead allocated across tasks</th><th>@currentCostSnapshot.ProjectOverhead.ToString("C2")</th>
                            </tr>
                            <tr>
                                <th colspan="7">Fully burdened project cost</th><th>@currentCostSnapshot.TotalCost.ToString("C2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                </details>
                <small class="text-muted d-block mt-3">@(hasPreliminaryPricing ? "Preliminary totals — updates automatically as task pricing changes" : $"Cost snapshot r{currentCostSnapshot.RevisionNumber}") · @currentCostSnapshot.CostingPolicyVersion.Name r@(currentCostSnapshot.CostingPolicyVersion.RevisionNumber)</small>
            }
                </section>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@ApplicationRoles.Administrator">
            <Authorized>
                @if (currentCostSnapshot is not null)
                {
                    var policyAuditRows = PolicyAuditRows()
                        .Where(IsVisiblePolicyAuditRow)
                        .ToList();
                    <section class="activity-panel policy-audit-panel">
                        <details>
                            <summary class="d-flex justify-content-between align-items-center gap-3">
                                <span>
                                    <span class="eyebrow d-block">Administrator only</span>
                                    <strong>Policy &amp; CENTCOM Audit</strong>
                                    <small class="d-block text-muted">Applied dollar impacts and priced material decisions only. Zero-value and unconfigured entries are hidden.</small>
                                </span>
                                <span class="badge text-bg-dark">@policyAuditRows.Count audit entries</span>
                            </summary>
                            <div class="mt-3">
                                <div class="alert alert-light border">
                                    <strong>@currentCostSnapshot.CostingPolicyVersion.Name revision @currentCostSnapshot.CostingPolicyVersion.RevisionNumber</strong>
                                    · effective @currentCostSnapshot.CostingPolicyVersion.EffectiveDate.ToString("MM/dd/yyyy")
                                    · cost snapshot revision @currentCostSnapshot.RevisionNumber created @currentCostSnapshot.PricedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                </div>
                                @foreach (var auditGroup in policyAuditRows.GroupBy(AuditSection).OrderBy(group => AuditSectionOrder(group.Key)))
                                {
                                    <h3 class="h5 mt-4">@auditGroup.Key</h3>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle policy-audit-table">
                                            <thead><tr><th>Task</th><th>Category</th><th>Rule / decision</th><th>Scope</th><th>Result</th><th>Status</th><th>Reason</th><th>Cost impact</th></tr></thead>
                                            <tbody>
                                                @foreach (var row in auditGroup)
                                                {
                                                    <tr class="@(row.Status == "Applied" ? null : row.Status == "Override" ? "table-info" : row.Status == "Warning" ? "table-warning" : "text-muted")">
                                                        <td>@row.Task</td><td>@row.Category</td><td>@row.Rule</td><td>@row.Scope</td><td>@row.Result</td>
                                                        <td><span class="badge @AuditStatusClass(row.Status)">@row.Status</span></td>
                                                        <td>@row.Reason</td><td>@AuditImpact(row)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </details>
                    </section>
                }
            </Authorized>
        </AuthorizeView>

        @if (currentCostSnapshot is not null)
        {
            <section class="activity-panel customer-price-panel">
                <p class="eyebrow">Customer-facing calculation</p>
                <h2>Customer Price</h2>
                <p class="dashboard-subtitle">Apply one discount percentage across the entire job, calculate tax, and review the final amount presented to the customer.</p>

                <div class="row g-3 customer-price-controls">
                    <div class="col-md-3">
                        <label class="form-label" for="job-discount-percent">Promotional Discounts</label>
                        <div class="input-group input-group-lg"><input id="job-discount-percent" type="number" class="form-control" min="0" max="100" step="1" value="@discountValue" @oninput="OnDiscountInput" /><span class="input-group-text">%</span></div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="job-tax-rate">Tax rate</label>
                        <div class="input-group input-group-lg">
                            <input id="job-tax-rate" type="number" class="form-control" min="0" max="100" step="0.01" value="@pricingTaxRate" @oninput="OnTaxRateInput" />
                            <span class="input-group-text">%</span>
                        </div>
                        <small class="text-muted">Enter the rate for @(quote?.CustomerAddress ?? "the customer service address").</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pricing-reason">Pricing note</label>
                        <InputText id="pricing-reason" class="form-control form-control-lg" @bind-Value="pricingAdjustmentReason" placeholder="Reason for discount or margin change" />
                    </div>
                </div>

                <div class="metric-grid">
                    <article class="metric-card"><span>Price before discount</span><strong>@PricingBasePrice.ToString("C2")</strong></article>
                    <article class="metric-card"><span>Promotional discount</span><strong class="@(discountValue > 0 ? "text-danger" : null)">@discountValue%</strong><small>Discount amount: @(PricingDiscountAmount > 0 ? $"−{PricingDiscountAmount:C2}" : PricingDiscountAmount.ToString("C2")) · Subtotal: @PricingPriceAfterDiscount.ToString("C2")</small></article>
                    <article class="metric-card"><span>Tax (@pricingTaxRate.ToString("N2")%)</span><strong>@PricingTaxAmount.ToString("C2")</strong></article>
                    <article class="metric-card accent-revenue customer-total-card"><span>Customer total</span><strong>@PricingFinalPrice.ToString("C2")</strong><small>After discount and tax</small></article>
                </div>
                <div class="effective-margin-banner @(IsPricingBelowPolicyMargin ? "below-margin" : "")">
                    <div><span>Effective gross margin after discount</span><strong>@($"{PricingEffectiveMargin:N2}%")</strong></div>
                    @if (IsPricingBelowPolicyMargin)
                    {
                        <p class="mb-0">This price is below the policy margin of @currentCostSnapshot.CostingPolicyVersion.DefaultTargetMarginPercent.ToString("N2")%. Review before approval.</p>
                    }
                    else
                    {
                        <p class="mb-0">The customer price meets the current policy margin.</p>
                    }
                </div>
            </section>
        }

        @if (version is not null && currentCostSnapshot is null)
        {
            <section class="activity-panel">
                <h2>@(version.Lines.Count == 0 ? "Estimate Workflow" : "Customer Pricing")</h2>
                @if (version.Lines.Count > 0)
                {
                    <div class="metric-grid mt-3">
                        <article class="metric-card"><span>Subtotal</span><strong>@version.Subtotal.ToString("C2")</strong></article>
                        <article class="metric-card"><span>Discount</span><strong>@version.DiscountAmount.ToString("C2")</strong></article>
                        <article class="metric-card"><span>Tax</span><strong>@version.TaxAmount.ToString("C2")</strong></article>
                        <article class="metric-card accent-revenue"><span>Total Price</span><strong>@version.Total.ToString("C2")</strong></article>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        @(pricingAnalyses.Count == 0
                            ? "Complete the CentCom analysis to calculate preliminary job costs and customer totals."
                            : "Preliminary job costs and customer totals calculate automatically from the latest analysis.")
                    </div>
                }

                @if (version.Status == "Draft")
                {
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-primary" @onclick="SubmitForReviewAsync">Submit Estimate to CentCom</button>
                        <button class="btn btn-success" disabled="@(version.Lines.Count == 0)" @onclick="ApproveAsync">Approve estimate</button>
                        <button class="btn btn-outline-danger" @onclick="RejectAsync">Reject</button>
                    </div>
                }
                else if (version.Status == "Approved")
                {
                    <button class="btn btn-outline-primary mt-3" @onclick="CreateRevisionAsync">Create revision</button>
                    <div class="alert alert-success mt-2">Approved version is locked. Customer delivery remains disabled.</div>
                }
                @if (message is not null)
                {
                    <div class="alert alert-info mt-3 mb-0" role="status">@message</div>
                }
            </section>
        }

        <details class="activity-panel">
            <summary><strong>Audit history</strong></summary>
            <div class="activity-list mt-3">
                @foreach (var item in quote!.AuditEvents.OrderByDescending(x => x.OccurredAt))
                {
                    <div class="activity-item">
                        <div>
                            <strong>@item.PreviousStatus → @item.NewStatus</strong>
                            <span>@item.Explanation</span>
                        </div>
                        <time>@item.OccurredAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                    </div>
                }
            </div>
        </details>

        <section class="estimate-save-bar">
            <button type="button"
                    class="btn btn-primary btn-lg"
                    disabled="@savingEstimate"
                    @onclick="SaveEstimateAsync">
                @(savingEstimate ? "Saving Estimate…" : "Save Estimate")
            </button>
        </section>
    </section>
}

@code {
    [Parameter] public int QuoteId { get; set; }

    private QuoteCase? quote;
    private QuoteVersion? version;
    private QuoteCostSnapshot? currentCostSnapshot;
    private QuoteCostSnapshot? auditCostSnapshot;
    private bool isAdministrator;
    private int pricingTargetMargin;
    private int discountValue;
    private decimal pricingTaxRate;
    private string? pricingAdjustmentReason;
    private string? message;
    private string newTaskType = string.Empty;
    private bool projectTasksExpanded = true;
    private readonly HashSet<int> expandedTaskIds = [];
    private readonly HashSet<int> editingAnalysisIds = [];
    private readonly HashSet<int> replacingMaterialIds = [];
    private readonly Dictionary<int, int> reviewCatalogSelections = [];
    private readonly HashSet<int> localOnlyReviewItemIds = [];
    private readonly HashSet<int> localOnlyMaterialIds = [];
    private List<VendorProduct> reviewCatalogItems = [];
    private readonly Dictionary<string, string?> dictationMessages = [];
    private bool savingEstimate;
    private string? activeDictationElementId;
    private DotNetObjectReference<EstimateWorkspace>? dictationReference;
    private CancellationTokenSource? analysisMonitorCancellation;
    private Task? analysisMonitorTask;
    private const string ProjectOverviewElementId = "project-overview-notes";
    private static readonly ProjectPhotoRequirement AdditionalPhotoRequirement =
        new("additional", "Additional Photo", "Additional project context.");

    protected override async Task OnParametersSetAsync()
    {
        expandedTaskIds.Clear();
        await ReloadAsync();
        StartAnalysisMonitoringIfNeeded();
    }

    private void ToggleProjectTask(int taskId)
    {
        if (!expandedTaskIds.Remove(taskId))
        {
            expandedTaskIds.Add(taskId);
        }
    }

    private void ToggleProjectTasks() => projectTasksExpanded = !projectTasksExpanded;

    private bool IsDictating(string elementId) =>
        string.Equals(activeDictationElementId, elementId, StringComparison.Ordinal);

    private string? GetDictationMessage(string elementId) =>
        dictationMessages.GetValueOrDefault(elementId);

    private async Task ToggleDictationAsync(string elementId)
    {
        dictationReference ??= DotNetObjectReference.Create(this);
        var result = await JS.InvokeAsync<DictationToggleResult>(
            "ccvDictation.toggle",
            elementId,
            dictationReference);
        activeDictationElementId = result.Active ? elementId : null;
        dictationMessages[elementId] = result.Supported
            ? (result.Active ? "Listening… Click the microphone again to stop." : null)
            : "Dictation is not supported by this browser. Use Chrome or Edge, or use your device’s keyboard dictation.";
    }

    [JSInvokable]
    public Task OnDictationStateChanged(string elementId, bool active, string? error)
    {
        activeDictationElementId = active ? elementId : null;
        dictationMessages[elementId] = !string.IsNullOrWhiteSpace(error)
            ? error
            : (active ? "Listening… Click the microphone again to stop." : null);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(ApplicationRoles.Administrator);
        var allowed = (await OperationAccess.GetAccessibleOperationsAsync()).Select(x => x.Id).ToList();
        await using var db = await DbFactory.CreateDbContextAsync();
        var legacyAnalyses = await db.QuoteTaskAnalyses
            .Include(x => x.ReviewItems)
            .Where(x => x.QuoteProjectTask.QuoteCaseId == QuoteId && allowed.Contains(x.QuoteProjectTask.QuoteCase.LocalOperationId)
                && (((x.Assumptions != null && x.Assumptions != "") && !x.ReviewItems.Any(item => item.ReviewKind == AnalysisReviewKinds.Assumption))
                    || ((x.QuestionsAndWarnings != null && x.QuestionsAndWarnings != "") && !x.ReviewItems.Any(item => item.ReviewKind == AnalysisReviewKinds.Warning))))
            .ToListAsync();
        foreach (var legacyAnalysis in legacyAnalyses)
        {
            var order = 1;
            if (!legacyAnalysis.ReviewItems.Any(item => item.ReviewKind == AnalysisReviewKinds.Assumption))
            {
                foreach (var item in AnalysisNoteItems(legacyAnalysis.Assumptions, "Assumption"))
                {
                    legacyAnalysis.ReviewItems.Add(new QuoteTaskAnalysisReviewItem
                    {
                        SortOrder = order,
                        ItemKey = $"a{order++:D2}",
                        ReviewKind = AnalysisReviewKinds.Assumption,
                        Category = item.Label,
                        Description = item.Body
                    });
                }
            }
            order = 1;
            if (!legacyAnalysis.ReviewItems.Any(item => item.ReviewKind == AnalysisReviewKinds.Warning))
            {
                foreach (var item in AnalysisNoteItems(legacyAnalysis.QuestionsAndWarnings, "Review item"))
                {
                    legacyAnalysis.ReviewItems.Add(new QuoteTaskAnalysisReviewItem
                    {
                        SortOrder = order,
                        ItemKey = $"r{order++:D2}",
                        ReviewKind = AnalysisReviewKinds.Warning,
                        Category = item.Label,
                        Description = item.Body
                    });
                }
            }
        }
        if (legacyAnalyses.Count > 0) await db.SaveChangesAsync();
        quote = await db.QuoteCases.AsNoTracking().AsSplitQuery()
            .Include(x => x.LocalOperation)
            .Include(x => x.Versions).ThenInclude(x => x.Lines)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.CostingPolicyVersion)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.Tasks).ThenInclude(x => x.QuoteProjectTask)
            .Include(x => x.Versions).ThenInclude(x => x.CostSnapshots).ThenInclude(x => x.Tasks).ThenInclude(x => x.RequiredSupplies)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Photos)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Materials)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Exclusions)
            .Include(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.ReviewItems)
            .Include(x => x.AuditEvents)
            .SingleOrDefaultAsync(x => x.Id == QuoteId && allowed.Contains(x.LocalOperationId));
        reviewCatalogItems = await db.VendorProducts.AsNoTracking()
            .Include(x => x.Product).Include(x => x.SupplyVendor).Include(x => x.Prices)
            .Where(x => x.IsActive && x.SupplyVendor.IsActive)
            .OrderBy(x => x.Product.Name).ThenBy(x => x.SupplyVendor.Name)
            .ToListAsync();
        version = quote?.Versions.OrderByDescending(x => x.VersionNumber).FirstOrDefault();
        currentCostSnapshot = version?.CostSnapshots.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();
        auditCostSnapshot = null;
        if (isAdministrator && currentCostSnapshot is not null)
        {
            auditCostSnapshot = await db.QuoteCostSnapshots.IgnoreQueryFilters().AsNoTracking().AsSplitQuery()
                .Include(x => x.CostingPolicyVersion).ThenInclude(x => x.Rules)
                .Include(x => x.CostingPolicyVersion).ThenInclude(x => x.CrewRates)
                .Include(x => x.CostingPolicyVersion).ThenInclude(x => x.MarginRules)
                .Include(x => x.CostingPolicyVersion).ThenInclude(x => x.SupplyKits).ThenInclude(x => x.Items).ThenInclude(x => x.VendorProduct).ThenInclude(x => x.Product)
                .Include(x => x.Tasks).ThenInclude(x => x.QuoteProjectTask).ThenInclude(x => x.Analyses).ThenInclude(x => x.Materials)
                .Include(x => x.Tasks).ThenInclude(x => x.QuoteProjectTask).ThenInclude(x => x.Analyses).ThenInclude(x => x.Exclusions)
                .Include(x => x.Tasks).ThenInclude(x => x.RequiredSupplies)
                .SingleAsync(x => x.Id == currentCostSnapshot.Id);
            currentCostSnapshot.CostingPolicyVersion = auditCostSnapshot.CostingPolicyVersion;
        }
        var defaultTaxRate = await db.QuotePricingRules.AsNoTracking()
            .Where(x => quote != null && x.LocalOperationId == quote.LocalOperationId)
            .Select(x => (decimal?)x.DefaultTaxRate)
            .SingleOrDefaultAsync() ?? 0;
        if (currentCostSnapshot is not null)
        {
            pricingTargetMargin = (int)decimal.Round(currentCostSnapshot.TargetMarginPercent, 0, MidpointRounding.AwayFromZero);
            var savedDiscount = Math.Max(0, version?.DiscountAmount ?? -currentCostSnapshot.PriceAdjustment);
            discountValue = currentCostSnapshot.SuggestedCustomerPrice <= 0
                ? 0
                : (int)decimal.Round(savedDiscount / currentCostSnapshot.SuggestedCustomerPrice * 100m, 0, MidpointRounding.AwayFromZero);
            pricingAdjustmentReason = currentCostSnapshot.AdjustmentReason;
        }
        else if (pricingTargetMargin == 0)
        {
            pricingTargetMargin = 40;
        }
        pricingTaxRate = decimal.Round(version?.TaxRate > 0 ? version.TaxRate : defaultTaxRate, 2);

        if (PricingAnalyses().Any() && PricingSnapshotNeedsRefresh())
        {
            await CreateCostSnapshotAsync();
        }
    }

    private decimal PricingTargetMargin => Math.Clamp(pricingTargetMargin, 1, 99);

    private void OnTargetMarginInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
            pricingTargetMargin = Math.Clamp(value, 1, 99);
        StateHasChanged();
    }

    private void OnDiscountInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
            discountValue = Math.Clamp(value, 0, 100);
        StateHasChanged();
    }

    private void OnTaxRateInput(ChangeEventArgs args)
    {
        var input = args.Value?.ToString();
        if (decimal.TryParse(input, out var value)
            || decimal.TryParse(input, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out value))
            pricingTaxRate = decimal.Round(Math.Clamp(value, 0, 100), 2);
        StateHasChanged();
    }

    private decimal PricingBasePrice => currentCostSnapshot is null
        ? 0
        : decimal.Round(currentCostSnapshot.TotalCost / (1 - PricingTargetMargin / 100m), 2);
    private decimal PricingDiscountAmount => decimal.Round(PricingBasePrice * Math.Clamp(discountValue, 0, 100) / 100m, 2);
    private decimal PricingPriceAfterDiscount => Math.Max(0, PricingBasePrice - PricingDiscountAmount);
    private decimal PricingTaxAmount => decimal.Round(PricingPriceAfterDiscount * Math.Clamp(pricingTaxRate, 0, 100) / 100m, 2);
    private decimal PricingFinalPrice => PricingPriceAfterDiscount + PricingTaxAmount;
    private decimal PricingGrossProfit => currentCostSnapshot is null ? 0 : PricingBasePrice - currentCostSnapshot.TotalCost;
    private decimal PricingEffectiveMargin => currentCostSnapshot is null || PricingPriceAfterDiscount <= 0
        ? 0
        : decimal.Round((PricingPriceAfterDiscount - currentCostSnapshot.TotalCost) / PricingPriceAfterDiscount * 100m, 2);
    private bool IsPricingBelowPolicyMargin => currentCostSnapshot is not null
        && PricingEffectiveMargin < currentCostSnapshot.CostingPolicyVersion.DefaultTargetMarginPercent;

    private IEnumerable<PolicyAuditRow> PolicyAuditRows()
    {
        if (!isAdministrator || quote is null || auditCostSnapshot is null) yield break;
        var snapshot = auditCostSnapshot;
        var policy = snapshot.CostingPolicyVersion;
        yield return new("Project", "Whole project", "Policy revision", policy.Name, "Project",
            $"Revision {policy.RevisionNumber}, effective {policy.EffectiveDate:MM/dd/yyyy}", "Applied",
            policy.LocalOperationId == quote.LocalOperationId ? "Location-specific policy took precedence." : "Company-wide policy applied because no location-specific policy superseded it.", null);
        yield return new("Project", "Whole project", "General overhead", "Overhead allocation", "Project",
            $"Fixed {policy.GeneralOverheadFixed:C2}; {policy.GeneralOverheadPerProjectDay:C2}/day; {policy.CalculatedOverheadPerCrewDay:C2}/crew-day; {policy.GeneralOverheadPercent:N2}% direct cost",
            "Applied", "Calculated and allocated proportionally across priced tasks.", snapshot.ProjectOverhead);
        yield return new("Project", "Whole project", "Default target margin", "Default margin", "Project",
            $"{policy.DefaultTargetMarginPercent:N2}%", snapshot.TargetMarginPercent == policy.DefaultTargetMarginPercent ? "Applied" : "Override",
            snapshot.TargetMarginPercent == policy.DefaultTargetMarginPercent ? "No more-specific pricing override changed the snapshot margin." : "Task rules or estimator pricing changed the effective snapshot margin.", null);
        yield return new("Project", "Whole project", "Cost snapshot", "Direct cost", "Persisted snapshot", "Materials, required supplies, labor, and task overhead", "Applied", "Stored when this pricing revision was calculated.", snapshot.DirectCost);
        yield return new("Project", "Whole project", "Cost snapshot", "Contingency", "Persisted snapshot", "Sum of task contingency calculations", "Applied", "Stored when this pricing revision was calculated.", snapshot.Contingency);
        yield return new("Project", "Whole project", "Cost snapshot", "Project overhead", "Persisted snapshot", "General and project-level overhead", "Applied", "Stored and allocated across task snapshots.", snapshot.ProjectOverhead);
        yield return new("Project", "Whole project", "Cost snapshot", "Fully burdened job cost", "Persisted snapshot", "Direct cost + contingency + project overhead", "Applied", "Authoritative internal job-cost total for this revision.", snapshot.TotalCost);
        yield return new("Project", "Whole project", "Customer pricing", "Suggested price before discounts", "Persisted snapshot", $"Target margin {snapshot.TargetMarginPercent:N2}%", "Applied", "Calculated from fully burdened job cost and effective margin.", snapshot.SuggestedCustomerPrice);

        var projectTaskTypes = quote.ProjectTasks.Select(task => task.TaskType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var rule in policy.Rules.Where(rule => rule.Scope == CostRuleScopes.Project))
        {
            var applies = rule.IsActive && (rule.TaskType is null || projectTaskTypes.Contains(rule.TaskType));
            var impact = applies ? CalculateRule(rule, snapshot.Tasks.Sum(task => task.TotalCost - task.AllocatedProjectOverhead), snapshot.Tasks.Sum(task => task.EstimatedDays)) : (decimal?)null;
            yield return new("Project", "Whole project", "Additional cost", rule.Name, "Project",
                FormatRuleForSnapshot(rule), applies ? "Applied" : "Not applied",
                !rule.IsActive ? "Rule was inactive." : applies ? "Project contains a matching task type." : $"No {rule.TaskType} task was present.", impact);
        }

        if (policy.Rules.Count == 0)
            yield return new("Project", "Whole project", "Additional costs", "No saved cost rules", "Policy revision", "No task or project cost rules are configured.", "Not configured", "Values in the entry form are not saved until Add cost is selected.", null);
        if (policy.SupplyKits.Count == 0)
            yield return new("Project", "Whole project", "Supply kits", "No standard supply kits", "Policy revision", "No automatic consumable or accessory kits are configured.", "Not configured", "Create a kit and add catalog items under Costing Policies.", null);
        if (policy.CrewRates.Count == 0)
            yield return new("Project", "Whole project", "Crew rates", "Policy fallback only", "Policy revision", $"{policy.DefaultCrewSize:N2} crew at {policy.DefaultDailyCrewCost:C2}/day", "Applied", "No task-specific crew-rate cards are configured.", null);
        if (policy.MarginRules.Count == 0)
            yield return new("Project", "Whole project", "Margins", "Policy fallback only", "Policy revision", $"{policy.DefaultTargetMarginPercent:N2}%", "Applied", "No task-specific margin rules are configured.", null);

        foreach (var taskCost in snapshot.Tasks.OrderBy(item => item.QuoteProjectTask.SortOrder))
        {
            var task = taskCost.QuoteProjectTask;
            var label = $"Task {task.SortOrder} - {task.TaskType}";
            var direct = taskCost.MaterialCost + taskCost.RequiredSupplyCost + taskCost.LaborCost;
            yield return new("Task", label, "Cost breakdown", "CENTCOM materials", "Persisted task snapshot", "Accepted and provisionally priced analysis materials", "Applied", "Material subtotal captured for this cost revision.", taskCost.MaterialCost);
            yield return new("Task", label, "Cost breakdown", "Standard supply kits", "Persisted task snapshot", $"{taskCost.RequiredSupplies.Count} supply item(s)", taskCost.RequiredSupplies.Count > 0 ? "Applied" : "Not configured", taskCost.RequiredSupplies.Count > 0 ? string.Join("; ", taskCost.RequiredSupplies.Select(item => $"{item.KitName}: {item.Description}")) : "No matching saved supply kit added items to this task.", taskCost.RequiredSupplyCost);
            yield return new("Task", label, "Cost breakdown", "Labor", "Persisted task snapshot", $"{taskCost.EstimatedDays:N2} day(s) × {taskCost.DailyCrewCost:C2}/day; {taskCost.CrewSize:N2} crew", "Applied", "Uses a task override, matching rate card, or policy fallback in that precedence order.", taskCost.LaborCost);
            yield return new("Task", label, "Cost breakdown", "Task overhead", "Persisted task snapshot", "Applied task-level additional-cost rules", "Applied", "Zero is valid when no matching task cost rules are configured.", taskCost.TaskOverhead);
            yield return new("Task", label, "Cost breakdown", "Contingency", "Persisted task snapshot", "Applied to task direct cost and task overhead", "Applied", "Uses a task override when present; otherwise the policy default.", taskCost.Contingency);
            yield return new("Task", label, "Cost breakdown", "Allocated project overhead", "Persisted task snapshot", "Proportional share of project overhead", "Applied", "Allocated according to the task share of total task cost.", taskCost.AllocatedProjectOverhead);
            yield return new("Task", label, "Cost breakdown", "Fully burdened task cost", "Persisted task snapshot", $"Suggested price {taskCost.SuggestedCustomerPrice:C2} at {taskCost.TargetMarginPercent:N2}% margin", "Applied", "Authoritative task cost for this pricing revision.", taskCost.TotalCost);
            foreach (var rate in policy.CrewRates.Where(rate => rate.TaskType == task.TaskType))
            {
                var matchesWork = rate.WorkType is null || rate.WorkType == task.WorkType;
                var selected = rate.IsActive && matchesWork && task.CrewSizeOverride is null && task.DailyCrewCostOverride is null &&
                    taskCost.CrewSize == rate.CrewSize && taskCost.DailyCrewCost == rate.DailyCrewCost;
                yield return new("Task", label, "Crew rate", $"{rate.TaskType}/{rate.WorkType ?? "All work types"}", "Task/work type",
                    $"{rate.CrewSize:N2} crew at {rate.DailyCrewCost:C2}/day", selected ? "Applied" : "Not applied",
                    !rate.IsActive ? "Rate was inactive." : !matchesWork ? "Work type did not match." : task.CrewSizeOverride is not null || task.DailyCrewCostOverride is not null ? "Task-level override took precedence." : "A more-specific matching crew rate took precedence.", selected ? taskCost.LaborCost : null);
            }
            if (task.CrewSizeOverride is not null || task.DailyCrewCostOverride is not null)
                yield return new("Task", label, "Crew override", "Task override", "Task", $"{taskCost.CrewSize:N2} crew at {taskCost.DailyCrewCost:C2}/day", "Override", "Estimator-entered task values took precedence over policy rates.", taskCost.LaborCost);

            foreach (var kit in policy.SupplyKits)
            {
                var applies = kit.IsActive && (kit.TaskType is null || kit.TaskType == task.TaskType) && (kit.WorkType is null || kit.WorkType == task.WorkType);
                var impact = applies ? taskCost.RequiredSupplies.Where(item => item.KitName == kit.Name).Sum(item => item.ExtendedCost) : (decimal?)null;
                yield return new("Task", label, "Supply kit", kit.Name, "Task/work type", $"{kit.TaskType ?? "All tasks"}/{kit.WorkType ?? "All work types"} · {kit.Items.Count} item(s)", applies ? "Applied" : "Not applied",
                    !kit.IsActive ? "Kit was inactive." : applies ? "Task and work type matched." : "Task type or work type did not match.", impact);
            }
            foreach (var rule in policy.Rules.Where(rule => rule.Scope == CostRuleScopes.Task))
            {
                var applies = rule.IsActive && (rule.TaskType is null || rule.TaskType == task.TaskType);
                yield return new("Task", label, "Additional cost", rule.Name, "Task", FormatRuleForSnapshot(rule), applies ? "Applied" : "Not applied",
                    !rule.IsActive ? "Rule was inactive." : applies ? "Task type matched." : "Task type did not match.", applies ? CalculateRule(rule, direct, taskCost.EstimatedDays) : null);
            }
            foreach (var margin in policy.MarginRules.Where(margin => margin.TaskType == task.TaskType))
            {
                var matchesWork = margin.WorkType is null || margin.WorkType == task.WorkType;
                var selected = margin.IsActive && matchesWork && task.TargetMarginPercentOverride is null && taskCost.TargetMarginPercent == margin.TargetMarginPercent;
                yield return new("Task", label, "Margin", $"{margin.TaskType}/{margin.WorkType ?? "All work types"}", "Task/work type", $"{margin.TargetMarginPercent:N2}%", selected ? "Applied" : "Not applied",
                    !margin.IsActive ? "Rule was inactive." : !matchesWork ? "Work type did not match." : task.TargetMarginPercentOverride is not null ? "Task-level margin override took precedence." : "A more-specific rule or current job margin took precedence.", null);
            }
            if (task.TargetMarginPercentOverride is not null)
                yield return new("Task", label, "Margin override", "Task override", "Task", $"{task.TargetMarginPercentOverride:N2}%", "Override", "Estimator-entered task margin took precedence.", null);

            var analysis = task.Analyses.OrderByDescending(item => item.RevisionNumber).FirstOrDefault();
            if (analysis is null) continue;
            foreach (var material in analysis.Materials.OrderBy(item => item.SortOrder))
                yield return new("Task", label, "Material resolution", material.OriginalDescription ?? material.Description,
                    material.SourceType ?? "No source", $"{material.Description} · {material.Quantity:N2} {material.Unit} at {material.UnitCost:C2}",
                    material.IsUnmatched ? "Warning" : material.ReviewDecision == MaterialReviewDecisions.Pending ? "Warning" : "Applied",
                    $"{material.MatchKind}; {material.MatchConfidence:P0} confidence; review {material.ReviewDecision}.", material.ExtendedCost);
            foreach (var exclusion in analysis.Exclusions)
                yield return new("Task", label, "Material exclusion", exclusion.Description, "CENTCOM analysis", exclusion.Reason, "Applied", "An active exclusion policy removed this recommendation from material pricing.", 0);
        }
    }

