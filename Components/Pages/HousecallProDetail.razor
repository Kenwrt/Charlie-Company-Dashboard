@page "/hcp/{OperationSlug}/{Kind}/{ExternalId}"
@attribute [Authorize(Roles = $"{ApplicationRoles.Administrator},{ApplicationRoles.LocalOperator}")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text.Json
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject OperationAccessService OperationAccess
@inject HousecallProDataService HousecallPro
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(localEstimate?.CustomerName ?? localJob?.CustomerName ?? "Housecall Pro Detail")</PageTitle>
<section class="dashboard-shell">
@if(loading){<p>Loading current Housecall Pro details…</p>}
else if(detail is null){<div class="alert alert-warning">This record is unavailable or you do not have access to its local operation.</div>}
else{
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Housecall Pro @detail.Kind</p>
            <h1>@(localEstimate?.CustomerName ?? localJob?.CustomerName ?? detail.ExternalId.Replace("csr_", "", StringComparison.OrdinalIgnoreCase))</h1>
            <p class="dashboard-subtitle">@DetailSubtitle()</p>
        </div>
        @if(localEstimate is not null){<div class="dashboard-status"><span>@EffectiveStatus(localEstimate)</span><small>Estimate status</small></div>}
        else if(localJob is not null){<div class="dashboard-status"><span>@(localJob.WorkStatus ?? "Not provided")</span><small>Job status</small></div>}
    </div>
    <p><a href="@($"hcp/{(Kind.Equals("jobs",StringComparison.OrdinalIgnoreCase)?"jobs":"estimates")}")">Back to list</a></p>
    @if(detailMessage is not null){<div class="alert alert-info">@detailMessage</div>}

    @if(localEstimate is not null)
    {
        <section class="activity-panel mb-4">
            <h2>Customer communications and notes</h2>
            <p>Housecall Pro estimate notes are shown when supplied by its API.</p>
            <div class="activity-list">
                @foreach(var item in localEstimate.Communications.OrderByDescending(x=>x.EnteredAt))
                {
                    <div class="activity-item"><div><strong>@item.CommunicationType · @item.Direction</strong><span>@item.Notes</span><small>Entered by @item.EnteredByName</small></div><time>@item.EnteredAt.ToLocalTime().ToString("MM/dd/yyyy")</time></div>
                }
                @foreach(var item in detail.Communications)
                {
                    <div class="activity-item"><div><strong>@item.Type · Housecall Pro</strong><span>@item.Notes</span><small>Entered by @item.EnteredBy</small></div>@if(item.EnteredAt is not null){<time>@item.EnteredAt.Value.ToLocalTime().ToString("MM/dd/yyyy")</time>}</div>
                }
                @if(localEstimate.Communications.Count==0 && detail.Communications.Count==0){<div class="empty-state">No communications or notes are available for this estimate.</div>}
            </div>
        </section>

        <section class="activity-panel mb-4">
            <h2>Follow Up Status</h2>
            @if(localEstimate.FollowUps.Count>0)
            {
                <div class="activity-list mb-3">
                    @foreach(var followUp in localEstimate.FollowUps.OrderByDescending(x=>x.EnteredAt))
                    {
                        <div class="activity-item"><div><strong>@followUp.Status</strong><span>@followUp.Notes</span><small>Entered by @followUp.EnteredByName</small></div><time>@followUp.EnteredAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</time></div>
                    }
                </div>
            }
            <dl class="finance-definition-list">
                <div><dt>Last Changed in CCV</dt><dd>@FormatStatusUpdate(localEstimate)</dd></div>
            </dl>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label class="form-label">Follow Up Status</label><InputSelect class="form-select" @bind-Value="statusInput.Status">@foreach(var item in FollowUpChoices){<option value="@item">@item</option>}</InputSelect></div>
                <div class="col-md-6"><label class="form-label">Follow Up Note</label><InputTextArea class="form-control" @bind-Value="statusInput.Note" /></div>
                <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" @onclick="SaveStatusAsync">Add Follow Up</button></div>
            </div>
            @if(statusMessage is not null){<div class="alert alert-info mt-3">@statusMessage</div>}
        </section>
    }
    else if(localJob is not null)
    {
        <section class="activity-panel mb-4">
            <h2>Customer and job information</h2>
            <dl class="finance-definition-list">
                <div><dt>Customer</dt><dd>@(localJob.CustomerName ?? "Not provided")</dd></div>
                <div><dt>Created by</dt><dd>@(localJob.CreatedByName ?? "Not provided by HCP")</dd></div>
                <div><dt>Email</dt><dd>@(localJob.CustomerEmail ?? "Not provided")</dd></div>
                <div><dt>Phone</dt><dd>@FormatPhone(localJob.CustomerPhone)</dd></div>
                <div><dt>Home address</dt><dd>@(localJob.Address ?? "Not provided")</dd></div>
            </dl>
        </section>

        <section class="activity-panel mb-4">
            <h2>Job details</h2>
            <dl class="finance-definition-list">
                <div><dt>Job number</dt><dd>@(localJob.JobNumber ?? localJob.ExternalId)</dd></div>
                <div><dt>Status</dt><dd>@(localJob.WorkStatus ?? "Not provided")</dd></div>
                <div><dt>Scheduled start</dt><dd>@FormatDateTime(localJob.ScheduledStart)</dd></div>
                <div><dt>Scheduled end</dt><dd>@FormatDateTime(localJob.ScheduledEnd)</dd></div>
                <div><dt>Total job price</dt><dd>@localJob.JobPrice.ToString("C")</dd></div>
                <div><dt>Amount invoiced</dt><dd>@localJob.TotalAmount.ToString("C")</dd></div>
                <div><dt>Remaining uncollected</dt><dd>@localJob.OutstandingBalance.ToString("C")</dd></div>
                <div><dt>Last updated by HCP</dt><dd>@FormatDateTime(localJob.SourceUpdatedAt)</dd></div>
            </dl>
        </section>

        <section class="activity-panel mb-4">
            <h2>Payment history</h2>
            <p>Payments and refunds recorded against this Housecall Pro job.</p>
            <dl class="finance-definition-list mb-3">
                <div><dt>Amount invoiced</dt><dd>@localJob.TotalAmount.ToString("C")</dd></div>
                <div><dt>Net payments recorded</dt><dd>@NetPayments.ToString("C")</dd></div>
                <div><dt>Remaining uncollected</dt><dd>@localJob.OutstandingBalance.ToString("C")</dd></div>
            </dl>
            <div class="activity-list">
                @foreach(var item in paymentHistory?.Transactions??[])
                {
                    <div class="activity-item">
                        <div>
                            <strong>@item.Type · @item.Method</strong>
                            <span>@item.Amount.ToString("C") · @item.Status</span>
                            @if(!string.IsNullOrWhiteSpace(item.Note)){<span>@item.Note</span>}
                            <small>Invoice @item.InvoiceNumber@if(!string.IsNullOrWhiteSpace(item.Category)){<text> · @item.Category</text>}</small>
                        </div>
                        <time>@(item.PaidAt?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")??"Date not provided")</time>
                    </div>
                }
                @if(paymentHistory?.Transactions.Count is null or 0){<div class="empty-state">No payments or refunds have been recorded for this job.</div>}
            </div>
        </section>
    }
    else
    {
        <dl class="finance-definition-list">@foreach(var field in detail.Fields){<div><dt>@field.Key</dt><dd>@field.Value</dd></div>}</dl>
    }

    <details class="activity-panel mt-4"><summary>Technical response details</summary><pre class="mt-3">@detail.Json</pre></details>
}
</section>

@code {
    [Parameter] public string OperationSlug { get; set; }="";
    [Parameter] public string Kind { get; set; }="";
    [Parameter] public string ExternalId { get; set; }="";
    private bool loading=true;
    private HcpRecordDetail? detail;
    private HousecallProEstimate? localEstimate;
    private HousecallProJob? localJob;
    private HcpJobPaymentHistory? paymentHistory;
    private StatusInput statusInput=new();
    private static readonly string[] FollowUpChoices=[HousecallProEstimateStatuses.FollowUp,HousecallProEstimateStatuses.FollowUpPending,HousecallProEstimateStatuses.FollowUpComplete];
    private string? statusMessage;
    private string? detailMessage;

    protected override async Task OnParametersSetAsync()
    {
        loading=true;
        detail=null;
        localEstimate=null;
        localJob=null;
        paymentHistory=null;
        detailMessage=null;
        if(await OperationAccess.CanAccessAsync(OperationSlug))
        {
            var detailKind=Kind.StartsWith("job",StringComparison.OrdinalIgnoreCase)?"job":"estimate";
            if(detailKind=="estimate")await ReloadLocalEstimateAsync();
            else
            {
                await ReloadLocalJobAsync();
                try
                {
                    paymentHistory=await HousecallPro.GetJobPaymentHistoryAsync(OperationSlug,ExternalId);
                }
                catch(Exception)
                {
                    detailMessage="Live Housecall Pro payment history is temporarily unavailable. The synchronized job summary is shown below.";
                }
            }
            try
            {
                detail=await HousecallPro.GetDetailAsync(OperationSlug,detailKind,ExternalId);
            }
            catch(Exception)
            {
                detailMessage="Live Housecall Pro details are temporarily unavailable. The synchronized CCV record is shown below.";
            }
            detail??=BuildCachedDetail(detailKind);
            if(detail is not null && detail.Json.Contains("\"source\": \"CCV synchronized cache\"",StringComparison.Ordinal))
                detailMessage="Live Housecall Pro details are unavailable for this record. The synchronized CCV record is shown below.";
        }
        loading=false;
    }

    private async Task ReloadLocalEstimateAsync()
    {
        await using var db=await DbContextFactory.CreateDbContextAsync();
        localEstimate=await db.HousecallProEstimates.AsNoTracking().Include(x=>x.Communications).Include(x=>x.FollowUps).Include(x=>x.LocalOperation).SingleOrDefaultAsync(x=>x.ExternalId==ExternalId&&x.LocalOperation.Slug==OperationSlug);
        if(localEstimate is not null)
        {
            statusInput=new(){Status=localEstimate.InternalStatus is not null&&FollowUpChoices.Contains(localEstimate.InternalStatus)?localEstimate.InternalStatus:HousecallProEstimateStatuses.FollowUp};
        }
    }

    private async Task ReloadLocalJobAsync()
    {
        await using var db=await DbContextFactory.CreateDbContextAsync();
        localJob=await db.HousecallProJobs.AsNoTracking().Include(x=>x.LocalOperation).SingleOrDefaultAsync(x=>x.ExternalId==ExternalId&&x.LocalOperation.Slug==OperationSlug);
    }

    private HcpRecordDetail? BuildCachedDetail(string detailKind)
    {
        if(detailKind=="estimate"&&localEstimate is not null)
        {
            var fields=new List<KeyValuePair<string,string>>
            {
                new("ID",localEstimate.ExternalId),
                new("Customer",localEstimate.CustomerName??"Not provided"),
                new("Status",EffectiveStatus(localEstimate)),
                new("Amount",localEstimate.TotalAmount.ToString("C")),
                new("Updated",FormatDateTime(localEstimate.SourceUpdatedAt))
            };
            var json=JsonSerializer.Serialize(new{source="CCV synchronized cache",localEstimate.ExternalId,localEstimate.EstimateNumber,localEstimate.CustomerName,Status=EffectiveStatus(localEstimate),localEstimate.TotalAmount,localEstimate.SourceUpdatedAt},new JsonSerializerOptions{WriteIndented=true});
            return new("estimate",localEstimate.ExternalId,fields,[],json);
        }
        if(detailKind=="job"&&localJob is not null)
        {
            var fields=new List<KeyValuePair<string,string>>
            {
                new("ID",localJob.ExternalId),
                new("Customer",localJob.CustomerName??"Not provided"),
                new("Status",localJob.WorkStatus??"Not provided"),
                new("Amount",localJob.TotalAmount.ToString("C")),
                new("Updated",FormatDateTime(localJob.SourceUpdatedAt))
            };
            var json=JsonSerializer.Serialize(new{source="CCV synchronized cache",localJob.ExternalId,localJob.JobNumber,localJob.CustomerName,localJob.WorkStatus,localJob.JobPrice,localJob.TotalAmount,localJob.OutstandingBalance,localJob.SourceUpdatedAt},new JsonSerializerOptions{WriteIndented=true});
            return new("job",localJob.ExternalId,fields,[],json);
        }
        return null;
    }

    private async Task SaveStatusAsync()
    {
        if(localEstimate is null||!FollowUpChoices.Contains(statusInput.Status)||string.IsNullOrWhiteSpace(statusInput.Note)){statusMessage="Choose a follow up status and enter a follow up note.";return;}
        var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        await using var db=await DbContextFactory.CreateDbContextAsync();
        var estimate=await db.HousecallProEstimates.FindAsync(localEstimate.Id);
        if(estimate is null)return;
        estimate.InternalStatus=statusInput.Status;
        estimate.InternalStatusNote=statusInput.Note.Trim();
        estimate.InternalStatusUpdatedBy=UserName(user);
        estimate.InternalStatusUpdatedAt=DateTimeOffset.UtcNow;
        db.HousecallProEstimateFollowUps.Add(new(){HousecallProEstimateId=estimate.Id,Status=statusInput.Status,Notes=statusInput.Note.Trim(),EnteredByUserId=user.FindFirstValue(ClaimTypes.NameIdentifier),EnteredByName=UserName(user)});
        await db.SaveChangesAsync();
        statusMessage=statusInput.Status==HousecallProEstimateStatuses.FollowUpComplete?"Status saved. This estimate is now hidden from the active HCP Estimates list.":"Status saved in CCV. No change was sent to Housecall Pro.";
        statusInput=new(){Status=statusInput.Status};
        await ReloadLocalEstimateAsync();
    }

    private static string UserName(ClaimsPrincipal user)=>user.Identity?.Name??user.FindFirstValue(ClaimTypes.Email)??"Unknown user";
    private static string EffectiveStatus(HousecallProEstimate estimate)=>estimate.InternalStatus??estimate.ApprovalStatus??"Not provided";
    private static string? Clean(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
    private static string FormatStatusUpdate(HousecallProEstimate estimate)=>estimate.InternalStatusUpdatedAt is null?"No Follow Up as of yet.":$"{estimate.InternalStatusUpdatedBy} · {estimate.InternalStatusUpdatedAt.Value.ToLocalTime():MM/dd/yyyy h:mm tt}";
    private string DetailSubtitle()=>localEstimate is not null?$"HCP estimate {localEstimate.EstimateNumber??localEstimate.ExternalId} · Live technical detail cached for five minutes.":localJob is not null?$"HCP job {localJob.JobNumber??localJob.ExternalId} · Live technical detail cached for five minutes.":$"Housecall Pro {detail?.Kind} {ExternalId}";
    private static string FormatDateTime(DateTimeOffset? value)=>value?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")??"Not provided";
    private static string FormatPhone(string? value){if(string.IsNullOrWhiteSpace(value))return "Not provided";var digits=new string(value.Where(char.IsDigit).ToArray());if(digits.Length==11&&digits[0]=='1')digits=digits[1..];return digits.Length==10?$"({digits[..3]}) {digits.Substring(3,3)}-{digits[6..]}":value;}
    private decimal NetPayments=>paymentHistory?.Transactions.Sum(x=>x.Amount)??0;
    private sealed class StatusInput{public string Status{get;set;}=HousecallProEstimateStatuses.FollowUp;[StringLength(2000)]public string? Note{get;set;}}
}
