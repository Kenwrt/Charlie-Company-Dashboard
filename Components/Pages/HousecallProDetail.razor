@page "/hcp/{OperationSlug}/{Kind}/{ExternalId}"
@attribute [Authorize(Roles = $"{ApplicationRoles.Administrator},{ApplicationRoles.LocalOperator}")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text.Json
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject OperationAccessService OperationAccess
@inject HousecallProDataService HousecallPro
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(localEstimate?.CustomerName ?? localJob?.CustomerName ?? "Housecall Pro Detail")</PageTitle>
<section class="dashboard-shell">
@if(loading){<p>Loading current Housecall Pro details…</p>}
else if(detail is null){<div class="alert alert-warning">This record is unavailable or you do not have access to its local operation.</div>}
else{
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Housecall Pro @detail.Kind</p>
            <h1>@(localEstimate?.CustomerName ?? localJob?.CustomerName ?? detail.ExternalId.Replace("csr_", "", StringComparison.OrdinalIgnoreCase))</h1>
            <p class="dashboard-subtitle">@DetailSubtitle()</p>
        </div>
        @if(localEstimate is not null){<div class="dashboard-status"><span>@EffectiveStatus(localEstimate)</span><small>Estimate status</small></div>}
        else if(localJob is not null){<div class="dashboard-status"><span>@EffectiveStatus(localJob)</span><small>Job status</small></div>}
    </div>
    <p><a href="@($"hcp/{(Kind.Equals("jobs",StringComparison.OrdinalIgnoreCase)?"jobs":"estimates")}")">Back to list</a></p>
    @if(detailMessage is not null){<div class="alert alert-info">@detailMessage</div>}

    @if(localEstimate is not null)
    {
        <section class="activity-panel mb-4">
            <h2>Customer communications and notes</h2>
            <p>Housecall Pro estimate notes are shown when supplied by its API.</p>
            <div class="activity-list">
                @foreach(var item in localEstimate.Communications.OrderByDescending(x=>x.EnteredAt))
                {
                    <div class="activity-item"><div><strong>@item.CommunicationType · @item.Direction</strong><span>@item.Notes</span><small>Entered by @item.EnteredByName</small></div><time>@item.EnteredAt.ToLocalTime().ToString("MM/dd/yyyy")</time></div>
                }
                @foreach(var item in detail.Communications)
                {
                    <div class="activity-item"><div><strong>@item.Type · Housecall Pro</strong><span>@item.Notes</span><small>Entered by @item.EnteredBy</small></div>@if(item.EnteredAt is not null){<time>@item.EnteredAt.Value.ToLocalTime().ToString("MM/dd/yyyy")</time>}</div>
                }
                @if(localEstimate.Communications.Count==0 && detail.Communications.Count==0){<div class="empty-state">No communications or notes are available for this estimate.</div>}
            </div>
        </section>

        <section class="activity-panel mb-4">
            <h2>Follow Up Status</h2>
            @if(localEstimate.FollowUps.Count>0)
            {
                <div class="activity-list mb-3">
                    @foreach(var followUp in localEstimate.FollowUps.OrderByDescending(x=>x.EnteredAt))
                    {
                        <div class="activity-item"><div><strong>@followUp.Status</strong><span>@followUp.Notes</span><small>Entered by @followUp.EnteredByName</small></div><time>@followUp.EnteredAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</time></div>
                    }
                </div>
            }
            <dl class="finance-definition-list">
                <div><dt>Last Changed in CCV</dt><dd>@FormatStatusUpdate(localEstimate)</dd></div>
            </dl>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label class="form-label">Follow Up Status</label><InputSelect class="form-select" @bind-Value="statusInput.Status">@foreach(var item in FollowUpChoices){<option value="@item">@item</option>}</InputSelect></div>
                <div class="col-md-6"><label class="form-label">Follow Up Note</label><InputTextArea class="form-control" @bind-Value="statusInput.Note" /></div>
                <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" @onclick="SaveStatusAsync">Add Follow Up</button></div>
            </div>
            @if(statusMessage is not null){<div class="alert alert-info mt-3">@statusMessage</div>}
        </section>
    }
    else if(localJob is not null)
    {
        <section class="activity-panel mb-4">
            <h2>Customer and job information</h2>
            <dl class="finance-definition-list">
                <div><dt>Customer</dt><dd>@(localJob.CustomerName ?? "Not provided")</dd></div>
                <div><dt>Created by</dt><dd>@(localJob.CreatedByName ?? "Not provided by HCP")</dd></div>
                <div><dt>Email</dt><dd>@(localJob.CustomerEmail ?? "Not provided")</dd></div>
                <div><dt>Phone</dt><dd>@FormatPhone(localJob.CustomerPhone)</dd></div>
                <div><dt>Home address</dt><dd>@(localJob.Address ?? "Not provided")</dd></div>
            </dl>
        </section>

        <section class="activity-panel mb-4">
            <h2>Job details</h2>
            <dl class="finance-definition-list">
                <div><dt>Job number</dt><dd>@(localJob.JobNumber ?? localJob.ExternalId)</dd></div>
                <div><dt>Status</dt><dd>@EffectiveStatus(localJob)</dd></div>
                <div><dt>Scheduled start</dt><dd>@FormatDateTime(localJob.ScheduledStart)</dd></div>
                <div><dt>Scheduled end</dt><dd>@FormatDateTime(localJob.ScheduledEnd)</dd></div>
                <div><dt>Total job price</dt><dd>@localJob.JobPrice.ToString("C2")</dd></div>
                <div><dt>Amount invoiced</dt><dd>@localJob.TotalAmount.ToString("C2")</dd></div>
                <div><dt>Remaining uncollected</dt><dd>@localJob.OutstandingBalance.ToString("C2")</dd></div>
                <div><dt>Last updated by HCP</dt><dd>@FormatDateTime(localJob.SourceUpdatedAt)</dd></div>
            </dl>
        </section>

        <section class="activity-panel mb-4">
            <h2>Payment history</h2>
            <p>Payments and refunds recorded against this Housecall Pro job.</p>
            <dl class="finance-definition-list mb-3">
                <div><dt>Amount invoiced</dt><dd>@localJob.TotalAmount.ToString("C2")</dd></div>
                <div><dt>Net payments recorded</dt><dd>@NetPayments.ToString("C2")</dd></div>
                <div><dt>Remaining uncollected</dt><dd>@localJob.OutstandingBalance.ToString("C2")</dd></div>
            </dl>
            <div class="activity-list">
                @foreach(var item in paymentHistory?.Transactions??[])
                {
                    <div class="activity-item">
                        <div>
                            <strong>@item.Type · @item.Method</strong>
                            <span>@item.Amount.ToString("C2") · @item.Status</span>
                            @if(!string.IsNullOrWhiteSpace(item.Note)){<span>@item.Note</span>}
                            <small>Invoice @item.InvoiceNumber@if(!string.IsNullOrWhiteSpace(item.Category)){<text> · @item.Category</text>}</small>
                        </div>
                        <time>@(item.PaidAt?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")??"Date not provided")</time>
                    </div>
                }
                @if(paymentHistory?.Transactions.Count is null or 0){<div class="empty-state">No payments or refunds have been recorded for this job.</div>}
            </div>
        </section>

        <section class="activity-panel mb-4 job-progress-panel">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div><p class="eyebrow">Operations control</p><h2>Job progress &amp; revenue risk</h2><p>Track the phase, delays, next action, and payments that depend on job progress.</p></div>
                <span class="badge @RiskBadgeClass">@RiskLabel</span>
            </div>
            <div class="metric-grid finance-metric-grid mb-4">
                <article class="metric-card accent-jobs"><span>Current phase</span><strong class="progress-metric-text">@(localJob.Progress?.CurrentPhase ?? "Not tracked")</strong><small>@PhaseAgeText</small></article>
                <article class="metric-card accent-expired"><span>Active blockers</span><strong>@ActiveBlockers.Count</strong><small>@CriticalBlockerCount critical</small></article>
                <article class="metric-card accent-revenue"><span>Next payment at risk</span><strong>@RevenueAtRisk.ToString("C2")</strong><small>@NextPaymentText</small></article>
                <article class="metric-card accent-quotes"><span>Next follow-up</span><strong class="progress-metric-text">@NextFollowUpText</strong><small>@(localJob.Progress?.NextAction ?? "No next action recorded")</small></article>
            </div>

            <h3 class="h5">Update job phase</h3>
            <div class="row g-2 mb-4">
                <div class="col-md-3"><label class="form-label">Current phase</label><InputSelect class="form-select" @bind-Value="progressInput.CurrentPhase">@foreach(var phase in JobProgressOptions.Phases){<option value="@phase">@phase</option>}</InputSelect></div>
                <div class="col-md-2"><label class="form-label">Expected phase completion</label><InputDate class="form-control" @bind-Value="progressInput.ExpectedPhaseCompletionDate" /></div>
                <div class="col-md-2"><label class="form-label">Revised job completion</label><InputDate class="form-control" @bind-Value="progressInput.RevisedJobCompletionDate" /></div>
                <div class="col-md-2"><label class="form-label">Follow-up date</label><InputDate class="form-control" @bind-Value="progressInput.NextFollowUpDate" /></div>
                <div class="col-md-3"><label class="form-label">Responsible party</label><InputText class="form-control" @bind-Value="progressInput.ResponsibleParty" /></div>
                <div class="col-md-9"><label class="form-label">Next action</label><InputText class="form-control" @bind-Value="progressInput.NextAction" /></div>
                <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100" @onclick="SaveProgressAsync">Save progress</button></div>
            </div>

            <h3 class="h5">Active blockers</h3>
            @if(ActiveBlockers.Count==0){<div class="empty-state mb-3">No active job blockers are recorded.</div>}
            else
            {
                <div class="activity-list mb-3">
                    @foreach(var blocker in ActiveBlockers.OrderByDescending(BlockerSeverity).ThenBy(x=>x.StartedOn))
                    {
                        <div class="activity-item blocker-item blocker-@BlockerSeverity(blocker)">
                            <div><strong>@blocker.BlockerType · @BlockerAge(blocker) days</strong><span>@blocker.Description</span><small>Next: @(blocker.NextAction??"Not recorded") · Follow-up: @FormatDate(blocker.NextFollowUpDate) · Owner: @(blocker.ResponsibleParty??"Not assigned") · Revenue at risk: @blocker.RevenueAtRisk.ToString("C2")</small></div>
                            <button class="btn btn-sm btn-outline-success" @onclick="()=>ResolveBlockerAsync(blocker.Id)">Resolve</button>
                        </div>
                    }
                </div>
            }
            <div class="row g-2 mb-4 progress-entry-box">
                <div class="col-md-2"><label class="form-label">Blocker type</label><InputSelect class="form-select" @bind-Value="blockerInput.BlockerType">@foreach(var item in JobProgressOptions.BlockerTypes){<option value="@item">@item</option>}</InputSelect></div>
                <div class="col-md-4"><label class="form-label">Description</label><InputText class="form-control" @bind-Value="blockerInput.Description" /></div>
                <div class="col-md-2"><label class="form-label">Started</label><InputDate class="form-control" @bind-Value="blockerInput.StartedOn" /></div>
                <div class="col-md-2"><label class="form-label">Expected resolution</label><InputDate class="form-control" @bind-Value="blockerInput.ExpectedResolutionDate" /></div>
                <div class="col-md-2"><label class="form-label">Revenue at risk</label><InputNumber class="form-control" @bind-Value="blockerInput.RevenueAtRisk" /></div>
                <div class="col-md-3"><label class="form-label">Responsible party</label><InputText class="form-control" @bind-Value="blockerInput.ResponsibleParty" /></div>
                <div class="col-md-5"><label class="form-label">Next action</label><InputText class="form-control" @bind-Value="blockerInput.NextAction" /></div>
                <div class="col-md-2"><label class="form-label">Follow-up date</label><InputDate class="form-control" @bind-Value="blockerInput.NextFollowUpDate" /></div>
                <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" @onclick="AddBlockerAsync">Add blocker</button></div>
            </div>

            <h3 class="h5">Payment milestones</h3>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 progress-entry-box">
                <div>
                    <strong>Standard project payment schedule</strong>
                    <div class="small text-muted">$1,500 design fee, 30% of the remaining contract at construction start, and the balance at final payment.</div>
                </div>
                <button class="btn btn-outline-primary ms-md-auto" disabled="@(localJob.PaymentMilestones.Count > 0)" @onclick="ApplyStandardPaymentTemplateAsync">Apply schedule</button>
            </div>
            @if(localJob.PaymentMilestones.Count>0)
            {
                <div class="table-responsive mb-3"><table class="table"><thead><tr><th>Milestone</th><th>Trigger</th><th>Expected</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach(var milestone in localJob.PaymentMilestones.OrderBy(x=>x.ExpectedPaymentDate))
                {<tr><td>@milestone.Name</td><td>@milestone.TriggerPhase</td><td>@FormatDate(milestone.ExpectedPaymentDate)</td><td>@milestone.Amount.ToString("C2")</td><td>@milestone.Status</td><td><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" @onclick="()=>EditMilestone(milestone)">Edit</button><button class="btn btn-sm btn-outline-primary" @onclick="()=>AdvanceMilestoneAsync(milestone.Id)">Advance status</button></div></td></tr>}
                </tbody></table></div>
            }
            <div class="row g-2 progress-entry-box">
                <div class="col-md-3"><label class="form-label">Milestone name</label><InputText class="form-control" @bind-Value="milestoneInput.Name" /></div>
                <div class="col-md-2"><label class="form-label">Trigger phase</label><InputSelect class="form-select" @bind-Value="milestoneInput.TriggerPhase">@foreach(var phase in JobProgressOptions.Phases){<option value="@phase">@phase</option>}</InputSelect></div>
                <div class="col-md-2"><label class="form-label">Expected payment</label><InputDate class="form-control" @bind-Value="milestoneInput.ExpectedPaymentDate" /></div>
                <div class="col-md-2"><label class="form-label">Amount</label><InputNumber class="form-control" @bind-Value="milestoneInput.Amount" /></div>
                <div class="col-md-2"><label class="form-label">Status</label><InputSelect class="form-select" @bind-Value="milestoneInput.Status">@foreach(var item in JobProgressOptions.MilestoneStatuses){<option value="@item">@item</option>}</InputSelect></div>
                <div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary w-100" @onclick="SaveMilestoneAsync">@(editingMilestoneId is null ? "Add" : "Save")</button></div>
                @if(editingMilestoneId is not null)
                {
                    <div class="col-12"><button class="btn btn-sm btn-link" @onclick="CancelMilestoneEdit">Cancel editing</button></div>
                }
            </div>
            @if(progressMessage is not null){<div class="alert alert-info mt-3">@progressMessage</div>}

            <details class="mt-4"><summary><strong>Progress audit timeline</strong> · @localJob.ProgressEvents.Count event(s)</summary><div class="activity-list mt-3">@foreach(var item in localJob.ProgressEvents.OrderByDescending(x=>x.OccurredAt)){<div class="activity-item"><div><strong>@item.EventType</strong><span>@item.Summary</span><small>@item.EnteredBy</small></div><time>@item.OccurredAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</time></div>}</div></details>
        </section>

        <section class="activity-panel mb-4">
            <h2>Follow Up Status</h2>
            @if(localJob.FollowUps.Count>0)
            {
                <div class="activity-list mb-3">
                    @foreach(var followUp in localJob.FollowUps.OrderByDescending(x=>x.EnteredAt))
                    {
                        <div class="activity-item"><div><strong>@followUp.Status</strong><span>@followUp.Notes</span><small>Entered by @followUp.EnteredByName</small></div><time>@followUp.EnteredAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</time></div>
                    }
                </div>
            }
            <dl class="finance-definition-list">
                <div><dt>Last Changed in CCV</dt><dd>@FormatStatusUpdate(localJob)</dd></div>
            </dl>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label class="form-label">Follow Up Status</label><InputSelect class="form-select" @bind-Value="statusInput.Status">@foreach(var item in FollowUpChoices){<option value="@item">@item</option>}</InputSelect></div>
                <div class="col-md-6"><label class="form-label">Follow Up Note</label><InputTextArea class="form-control" @bind-Value="statusInput.Note" /></div>
                <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" @onclick="SaveStatusAsync">Add Follow Up</button></div>
            </div>
            @if(statusMessage is not null){<div class="alert alert-info mt-3">@statusMessage</div>}
        </section>
    }
    else
    {
        <dl class="finance-definition-list">@foreach(var field in detail.Fields){<div><dt>@field.Key</dt><dd>@field.Value</dd></div>}</dl>
    }

    <details class="activity-panel mt-4"><summary>Technical response details</summary><pre class="mt-3">@detail.Json</pre></details>
}
</section>

@code {
    [Parameter] public string OperationSlug { get; set; }="";
    [Parameter] public string Kind { get; set; }="";
    [Parameter] public string ExternalId { get; set; }="";
    private bool loading=true;
    private HcpRecordDetail? detail;
    private HousecallProEstimate? localEstimate;
    private HousecallProJob? localJob;
    private HcpJobPaymentHistory? paymentHistory;
    private StatusInput statusInput=new();
    private static readonly string[] FollowUpChoices=[HousecallProEstimateStatuses.FollowUp,HousecallProEstimateStatuses.FollowUpPending,HousecallProEstimateStatuses.FollowUpComplete];
    private string? statusMessage;
    private string? detailMessage;
    private ProgressInput progressInput=new();
    private BlockerInput blockerInput=new();
    private MilestoneInput milestoneInput=new();
    private int? editingMilestoneId;
    private string? progressMessage;

    protected override async Task OnParametersSetAsync()
    {
        loading=true;
        detail=null;
        localEstimate=null;
        localJob=null;
        paymentHistory=null;
        detailMessage=null;
        if(await OperationAccess.CanAccessAsync(OperationSlug))
        {
            var detailKind=Kind.StartsWith("job",StringComparison.OrdinalIgnoreCase)?"job":"estimate";
            if(detailKind=="estimate")await ReloadLocalEstimateAsync();
            else
            {
                await ReloadLocalJobAsync();
                try
                {
                    paymentHistory=await HousecallPro.GetJobPaymentHistoryAsync(OperationSlug,ExternalId);
                }
                catch(Exception)
                {
                    detailMessage="Live Housecall Pro payment history is temporarily unavailable. The synchronized job summary is shown below.";
                }
            }
            try
            {
                detail=await HousecallPro.GetDetailAsync(OperationSlug,detailKind,ExternalId);
            }
            catch(Exception)
            {
                detailMessage="Live Housecall Pro details are temporarily unavailable. The synchronized CCV record is shown below.";
            }
            detail??=BuildCachedDetail(detailKind);
            if(detail is not null && detail.Json.Contains("\"source\": \"CCV synchronized cache\"",StringComparison.Ordinal))
                detailMessage="Live Housecall Pro details are unavailable for this record. The synchronized CCV record is shown below.";
        }
        loading=false;
    }

    private async Task ReloadLocalEstimateAsync()
    {
        await using var db=await DbContextFactory.CreateDbContextAsync();
        localEstimate=await db.HousecallProEstimates.AsNoTracking().Include(x=>x.Communications).Include(x=>x.FollowUps).Include(x=>x.LocalOperation).SingleOrDefaultAsync(x=>x.ExternalId==ExternalId&&x.LocalOperation.Slug==OperationSlug);
        if(localEstimate is not null)
        {
            statusInput=new(){Status=localEstimate.InternalStatus is not null&&FollowUpChoices.Contains(localEstimate.InternalStatus)?localEstimate.InternalStatus:HousecallProEstimateStatuses.FollowUp};
        }
    }

    private async Task ReloadLocalJobAsync()
    {
        await using var db=await DbContextFactory.CreateDbContextAsync();
        localJob=await db.HousecallProJobs.AsNoTracking().Include(x=>x.FollowUps).Include(x=>x.Progress).Include(x=>x.Blockers).Include(x=>x.PaymentMilestones).Include(x=>x.ProgressEvents).Include(x=>x.LocalOperation).SingleOrDefaultAsync(x=>x.ExternalId==ExternalId&&x.LocalOperation.Slug==OperationSlug);
        if(localJob is not null)
        {
            statusInput=new(){Status=localJob.InternalStatus is not null&&FollowUpChoices.Contains(localJob.InternalStatus)?localJob.InternalStatus:HousecallProEstimateStatuses.FollowUp};
            progressInput=new(){CurrentPhase=localJob.Progress?.CurrentPhase??"Design",ExpectedPhaseCompletionDate=localJob.Progress?.ExpectedPhaseCompletionDate,RevisedJobCompletionDate=localJob.Progress?.RevisedJobCompletionDate,NextAction=localJob.Progress?.NextAction,NextFollowUpDate=localJob.Progress?.NextFollowUpDate,ResponsibleParty=localJob.Progress?.ResponsibleParty};
            blockerInput=new(){StartedOn=DateOnly.FromDateTime(DateTime.Today),RevenueAtRisk=NextPendingMilestone?.Amount??localJob.OutstandingBalance};
        }
    }

    private HcpRecordDetail? BuildCachedDetail(string detailKind)
    {
        if(detailKind=="estimate"&&localEstimate is not null)
        {
            var fields=new List<KeyValuePair<string,string>>
            {
                new("ID",localEstimate.ExternalId),
                new("Customer",localEstimate.CustomerName??"Not provided"),
                new("Status",EffectiveStatus(localEstimate)),
                new("Amount",localEstimate.TotalAmount.ToString("C2")),
                new("Updated",FormatDateTime(localEstimate.SourceUpdatedAt))
            };
            var json=JsonSerializer.Serialize(new{source="CCV synchronized cache",localEstimate.ExternalId,localEstimate.EstimateNumber,localEstimate.CustomerName,Status=EffectiveStatus(localEstimate),localEstimate.TotalAmount,localEstimate.SourceUpdatedAt},new JsonSerializerOptions{WriteIndented=true});
            return new("estimate",localEstimate.ExternalId,fields,[],json);
        }
        if(detailKind=="job"&&localJob is not null)
        {
            var fields=new List<KeyValuePair<string,string>>
            {
                new("ID",localJob.ExternalId),
                new("Customer",localJob.CustomerName??"Not provided"),
                new("Status",EffectiveStatus(localJob)),
                new("Amount",localJob.TotalAmount.ToString("C2")),
                new("Updated",FormatDateTime(localJob.SourceUpdatedAt))
            };
            var json=JsonSerializer.Serialize(new{source="CCV synchronized cache",localJob.ExternalId,localJob.JobNumber,localJob.CustomerName,Status=EffectiveStatus(localJob),localJob.WorkStatus,localJob.JobPrice,localJob.TotalAmount,localJob.OutstandingBalance,localJob.SourceUpdatedAt},new JsonSerializerOptions{WriteIndented=true});
            return new("job",localJob.ExternalId,fields,[],json);
        }
        return null;
    }

    private async Task SaveStatusAsync()
    {
        if((localEstimate is null&&localJob is null)||!FollowUpChoices.Contains(statusInput.Status)||string.IsNullOrWhiteSpace(statusInput.Note)){statusMessage="Choose a follow up status and enter a follow up note.";return;}
        var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        await using var db=await DbContextFactory.CreateDbContextAsync();
        if(localEstimate is not null)
        {
            var estimate=await db.HousecallProEstimates.FindAsync(localEstimate.Id);
            if(estimate is null)return;
            estimate.InternalStatus=statusInput.Status;
            estimate.InternalStatusNote=statusInput.Note.Trim();
            estimate.InternalStatusUpdatedBy=UserName(user);
            estimate.InternalStatusUpdatedAt=DateTimeOffset.UtcNow;
            db.HousecallProEstimateFollowUps.Add(new(){HousecallProEstimateId=estimate.Id,Status=statusInput.Status,Notes=statusInput.Note.Trim(),EnteredByUserId=user.FindFirstValue(ClaimTypes.NameIdentifier),EnteredByName=UserName(user)});
        }
        else
        {
            var job=await db.HousecallProJobs.FindAsync(localJob!.Id);
            if(job is null)return;
            job.InternalStatus=statusInput.Status;
            job.InternalStatusNote=statusInput.Note.Trim();
            job.InternalStatusUpdatedBy=UserName(user);
            job.InternalStatusUpdatedAt=DateTimeOffset.UtcNow;
            db.HousecallProJobFollowUps.Add(new(){HousecallProJobId=job.Id,Status=statusInput.Status,Notes=statusInput.Note.Trim(),EnteredByUserId=user.FindFirstValue(ClaimTypes.NameIdentifier),EnteredByName=UserName(user)});
        }
        await db.SaveChangesAsync();
        statusMessage=statusInput.Status==HousecallProEstimateStatuses.FollowUpComplete?$"Status saved. This {(localEstimate is not null?"estimate":"job")} is now hidden from the active HCP {(localEstimate is not null?"Estimates":"Jobs")} list.":"Status saved in CCV. No change was sent to Housecall Pro.";
        statusInput=new(){Status=statusInput.Status};
        if(localEstimate is not null)await ReloadLocalEstimateAsync();else await ReloadLocalJobAsync();
    }

    private static string UserName(ClaimsPrincipal user)=>user.Identity?.Name??user.FindFirstValue(ClaimTypes.Email)??"Unknown user";
    private static string EffectiveStatus(HousecallProEstimate estimate)=>estimate.InternalStatus??estimate.ApprovalStatus??"Not provided";
    private static string EffectiveStatus(HousecallProJob job)=>job.InternalStatus??job.WorkStatus??"Not provided";
    private static string? Clean(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
