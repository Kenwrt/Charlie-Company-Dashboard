    private async Task CreateCostSnapshotAsync()
    {
        if (quote is null || version is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var policy = await db.CostingPolicyVersions.AsNoTracking()
            .Include(x => x.Rules)
            .Include(x => x.CrewRates)
            .Include(x => x.MarginRules)
            .Include(x => x.SupplyKits).ThenInclude(x => x.Items).ThenInclude(x => x.VendorProduct).ThenInclude(x => x.Prices)
            .Where(x => x.IsActive && x.EffectiveDate <= today && (x.EndDate == null || x.EndDate >= today)
                && (x.LocalOperationId == quote.LocalOperationId || x.LocalOperationId == null))
            .OrderByDescending(x => x.LocalOperationId == quote.LocalOperationId)
            .ThenByDescending(x => x.EffectiveDate)
            .ThenByDescending(x => x.RevisionNumber)
            .FirstOrDefaultAsync();
        if (policy is null)
        {
            message = "No active costing policy applies to this operation. An administrator must create one under Costing Policies.";
            return;
        }

        var trackedVersion = await db.QuoteVersions
            .Include(x => x.QuoteCase).ThenInclude(x => x.ProjectTasks).ThenInclude(x => x.Analyses).ThenInclude(x => x.Materials)
            .SingleOrDefaultAsync(x => x.Id == version.Id);
        if (trackedVersion is null) return;
        var pricingCandidates = trackedVersion.QuoteCase.ProjectTasks
            .Select(task => task.Analyses
                .Where(x => x.Status is QuoteTaskAnalysisStatuses.Accepted or QuoteTaskAnalysisStatuses.NeedsReview)
                .OrderByDescending(x => x.RevisionNumber)
                .FirstOrDefault())
            .Where(x => x is not null).ToDictionary(x => x!.QuoteProjectTaskId, x => x!);
        if (pricingCandidates.Count == 0) { message = "Complete at least one CentCom task analysis before pricing."; return; }
        var isPreliminary = pricingCandidates.Values.Any(x => x.Status != QuoteTaskAnalysisStatuses.Accepted);

        var revision = (await db.QuoteCostSnapshots.Where(x => x.QuoteVersionId == version.Id).Select(x => (int?)x.RevisionNumber).MaxAsync() ?? 0) + 1;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var snapshot = new QuoteCostSnapshot
        {
            QuoteVersionId = version.Id, CostingPolicyVersionId = policy.Id, RevisionNumber = revision,
            TargetMarginPercent = policy.DefaultTargetMarginPercent,
            PricedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier)
        };
        decimal totalTaskCost = 0;
        decimal projectDays = 0;
        foreach (var task in trackedVersion.QuoteCase.ProjectTasks.OrderBy(x => x.SortOrder))
        {
            if (!pricingCandidates.TryGetValue(task.Id, out var analysis)) continue;
            var days = Math.Max(0, task.EstimatedDays);
            var crewRate = policy.CrewRates.Where(x => x.IsActive && x.TaskType == task.TaskType
                    && (x.WorkType == null || x.WorkType == task.WorkType))
                .OrderByDescending(x => x.WorkType != null).FirstOrDefault();
            var crew = task.CrewSizeOverride ?? crewRate?.CrewSize ?? policy.DefaultCrewSize;
            var dailyCrew = task.DailyCrewCostOverride ?? crewRate?.DailyCrewCost ?? policy.DefaultDailyCrewCost;
            var material = analysis.MaterialSubtotal;
            var applicableKits = policy.SupplyKits.Where(x => x.IsActive
                    && (x.TaskType == null || x.TaskType == task.TaskType)
                    && (x.WorkType == null || x.WorkType == task.WorkType)).ToList();
            var supplyLines = applicableKits.SelectMany(kit => kit.Items.Select(item =>
            {
                var price = item.VendorProduct.Prices
                    .Where(x => x.EffectiveDate <= today && (x.ExpirationDate == null || x.ExpirationDate >= today))
                    .OrderByDescending(x => x.EffectiveDate).FirstOrDefault();
                var extended = decimal.Round(item.Quantity * (price?.UnitPrice ?? 0) * (1 + item.WastePercent / 100m), 2);
                return new { Kit = kit, Item = item, UnitCost = price?.UnitPrice ?? 0, Extended = extended };
            })).ToList();
            var supplyCost = supplyLines.Sum(x => x.Extended);
            var labor = decimal.Round(days * dailyCrew, 2);
            var direct = material + supplyCost + labor;
            var applicable = policy.Rules.Where(x => x.IsActive && x.Scope == CostRuleScopes.Task && (x.TaskType == null || x.TaskType == task.TaskType)).ToList();
            var overhead = applicable.Sum(rule => CalculateRule(rule, direct, days));
            var contingencyPercent = task.ContingencyPercentOverride ?? policy.DefaultContingencyPercent;
            var contingency = decimal.Round((direct + overhead) * contingencyPercent / 100m, 2);
            var total = direct + overhead + contingency;
            var taskSnapshot = new QuoteTaskCostSnapshot
            {
                QuoteProjectTaskId = task.Id, MaterialCost = material, RequiredSupplyCost = supplyCost, EstimatedDays = days, CrewSize = crew,
                DailyCrewCost = dailyCrew, LaborCost = labor, TaskOverhead = overhead, Contingency = contingency,
                TotalCost = total,
                AppliedRules = string.Join("; ", applicable.Select(x => $"{x.Name}: {FormatRuleForSnapshot(x)}")
                    .Concat(applicableKits.Select(x => $"Supply kit: {x.Name}"))
                    .Concat(crewRate is null ? Enumerable.Empty<string>() : [$"Crew rate: {crewRate.TaskType}/{crewRate.WorkType ?? "All"}"]))
            };
            foreach (var line in supplyLines)
            {
                taskSnapshot.RequiredSupplies.Add(new QuoteTaskSupplyCostSnapshot
                {
                    VendorProductId = line.Item.VendorProductId, KitName = line.Kit.Name,
                    Description = line.Item.VendorProduct.Product.Name, Quantity = line.Item.Quantity,
                    UnitCost = line.UnitCost, WastePercent = line.Item.WastePercent, ExtendedCost = line.Extended
                });
            }
            snapshot.Tasks.Add(taskSnapshot);
            totalTaskCost += total;
            projectDays += days;
        }
        var projectTaskTypes = trackedVersion.QuoteCase.ProjectTasks.Select(x => x.TaskType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var projectRules = policy.Rules.Where(x => x.IsActive && x.Scope == CostRuleScopes.Project
            && (x.TaskType == null || projectTaskTypes.Contains(x.TaskType))).ToList();
        var generalOverhead = policy.GeneralOverheadFixed
            + (policy.GeneralOverheadPerProjectDay + policy.CalculatedOverheadPerCrewDay) * projectDays
            + totalTaskCost * policy.GeneralOverheadPercent / 100m
            + projectRules.Sum(rule => CalculateRule(rule, totalTaskCost, projectDays));
        snapshot.DirectCost = snapshot.Tasks.Sum(x => x.MaterialCost + x.RequiredSupplyCost + x.LaborCost + x.TaskOverhead);
        snapshot.Contingency = snapshot.Tasks.Sum(x => x.Contingency);
        snapshot.ProjectOverhead = decimal.Round(generalOverhead, 2);
        foreach (var taskCost in snapshot.Tasks)
        {
            var ratio = totalTaskCost <= 0 ? 1m / Math.Max(1, snapshot.Tasks.Count) : taskCost.TotalCost / totalTaskCost;
            taskCost.AllocatedProjectOverhead = decimal.Round(snapshot.ProjectOverhead * ratio, 2);
            taskCost.TotalCost = decimal.Round(taskCost.TotalCost + taskCost.AllocatedProjectOverhead, 2);
            var task = trackedVersion.QuoteCase.ProjectTasks.Single(x => x.Id == taskCost.QuoteProjectTaskId);
            var marginRule = policy.MarginRules.Where(x => x.IsActive && x.TaskType == task.TaskType
                    && (x.WorkType == null || x.WorkType == task.WorkType))
                .OrderByDescending(x => x.WorkType != null).FirstOrDefault();
            taskCost.TargetMarginPercent = currentCostSnapshot is not null
                ? PricingTargetMargin
                : task.TargetMarginPercentOverride ?? marginRule?.TargetMarginPercent ?? policy.DefaultTargetMarginPercent;
            taskCost.SuggestedCustomerPrice = taskCost.TargetMarginPercent >= 100
                ? taskCost.TotalCost
                : decimal.Round(taskCost.TotalCost / (1 - taskCost.TargetMarginPercent / 100m), 2);
            taskCost.AppliedRules = string.Join("; ", new[] { taskCost.AppliedRules, marginRule is null ? null : $"Margin: {marginRule.TaskType}/{marginRule.WorkType ?? "All"} {marginRule.TargetMarginPercent:N2}%" }.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        snapshot.TotalCost = snapshot.Tasks.Sum(x => x.TotalCost);
        snapshot.SuggestedCustomerPrice = snapshot.Tasks.Sum(x => x.SuggestedCustomerPrice);
        snapshot.TargetMarginPercent = snapshot.SuggestedCustomerPrice <= 0 ? 0
            : decimal.Round((snapshot.SuggestedCustomerPrice - snapshot.TotalCost) / snapshot.SuggestedCustomerPrice * 100m, 4);
        db.QuoteCostSnapshots.Add(snapshot);
        await AddAuditEventAsync(db, quote, $"{(isPreliminary ? "Preliminary cost" : "Cost")} snapshot revision {revision} created using {policy.Name} revision {policy.RevisionNumber}.");
        await db.SaveChangesAsync();
        message = isPreliminary
            ? $"Preliminary totals calculated in snapshot revision {revision}. Reprice after any material review changes."
            : $"Cost snapshot revision {revision} created. Previous snapshots remain unchanged.";
        await ReloadAsync();
    }

    private static decimal CalculateRule(CostingPolicyRule rule, decimal directCost, decimal days) =>
        decimal.Round(rule.CalculationMethod switch
        {
            CostRuleCalculationMethods.PerProjectDay => rule.Rate * days,
            CostRuleCalculationMethods.PercentOfDirectCost => directCost * rule.Rate / 100m,
            _ => rule.Rate
        }, 2);

    private static string FormatRuleForSnapshot(CostingPolicyRule rule) =>
        rule.CalculationMethod == CostRuleCalculationMethods.PercentOfDirectCost
            ? $"{rule.Rate:N2}%"
            : $"{rule.Rate:C2} {rule.CalculationMethod}";

    private async Task CapturePicturesAsync(
        QuoteProjectTask task,
        ProjectPhotoRequirement requirement,
        InputFileChangeEventArgs args)
    {
        if (quote is null) return;
        var files = args.GetMultipleFiles(12);
        if (files.Count == 0) return;
        var root = Configuration["EstimatePictures:StoragePath"];
        if (string.IsNullOrWhiteSpace(root))
        {
            root = Path.Combine(Environment.ContentRootPath, "EstimatePictures");
        }
        var taskDirectory = Path.Combine(root, $"estimate-{quote.Id}", $"task-{task.Id}");
        Directory.CreateDirectory(taskDirectory);

        await using var db = await DbFactory.CreateDbContextAsync();
        var validTask = await db.QuoteProjectTasks.AnyAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (!validTask) return;

        var saved = 0;
        foreach (var file in files)
        {
            if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) continue;
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not ".jpg" and not ".jpeg" and not ".png" and not ".webp" and not ".heic") extension = ".jpg";
            var storedPath = Path.Combine(taskDirectory, $"{DateTimeOffset.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}{extension}");
            await using var source = file.OpenReadStream(20 * 1024 * 1024);
            await using var destination = File.Create(storedPath);
            await source.CopyToAsync(destination);
            db.QuoteProjectTaskPhotos.Add(new QuoteProjectTaskPhoto
            {
                QuoteProjectTaskId = task.Id,
                OriginalFileName = Path.GetFileName(file.Name),
                StoragePath = storedPath,
                ContentType = file.ContentType,
                FileSize = file.Size,
                RequirementKey = requirement.Key,
                RequirementLabel = requirement.Label
            });
            saved++;
        }

        if (saved > 0)
        {
            await AddAuditEventAsync(db, quote, $"{saved} photograph(s) added to Project Task {task.SortOrder}.");
            await db.SaveChangesAsync();
            await PublishEstimateEventAsync("EstimateWorkspace", "CaptureProjectTaskPictures", "Completed", $"{saved} photograph(s) stored for Project Task {task.SortOrder}.");
        }
        message = saved == 0 ? "No supported image files were selected." : $"{saved} photograph(s) added to Project Task {task.SortOrder}.";
        await ReloadAsync();
    }

    private async Task AddAuditEventAsync(ApplicationDbContext db, QuoteCase currentQuote, string explanation)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        db.QuoteAuditEvents.Add(new QuoteAuditEvent
        {
            QuoteCaseId = currentQuote.Id,
            PreviousStatus = currentQuote.Status,
            NewStatus = currentQuote.Status,
            UserId = user.FindFirstValue(ClaimTypes.NameIdentifier),
            Explanation = explanation
        });
        var trackedQuote = await db.QuoteCases.FindAsync(currentQuote.Id);
        if (trackedQuote is not null) trackedQuote.UpdatedAt = DateTimeOffset.UtcNow;
    }

    private async Task TransitionAsync(string status, string explanation)
    {
        if (quote is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteCases.FindAsync(quote.Id);
        if (tracked is null) return;
        var previous = tracked.Status;
        tracked.Status = status;
        tracked.UpdatedAt = DateTimeOffset.UtcNow;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        db.QuoteAuditEvents.Add(new QuoteAuditEvent
        {
            QuoteCaseId = tracked.Id,
            PreviousStatus = previous,
            NewStatus = status,
            UserId = user.FindFirstValue(ClaimTypes.NameIdentifier),
            Explanation = explanation
        });
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("EstimateWorkflow", "Transition", "Completed", $"Estimate transitioned from {previous} to {status}: {explanation}");
        await ReloadAsync();
    }

    private async Task SubmitForReviewAsync()
    {
        if (quote is null) return;
        var incomplete = quote.ProjectTasks
            .Where(task =>
                string.IsNullOrWhiteSpace(task.ScopeOfWork) ||
                ProjectPhotoGuidance.For(task.TaskType).Any(requirement =>
                    task.Photos.All(photo => photo.RequirementKey != requirement.Key)))
            .ToList();
        if (quote.ProjectTasks.Count == 0)
        {
            message = "Add at least one project task before submitting the estimate.";
            return;
        }
        if (incomplete.Count > 0)
        {
            message = $"Complete the scope of work and every required photograph for Project Task(s): {string.Join(", ", incomplete.Select(x => x.SortOrder))}.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existingQueuedTaskIds = await db.QuoteProcessingJobs
            .Where(x => x.QuoteCaseId == quote.Id && x.JobType == "CentCom Task Analysis" && x.QuoteProjectTaskId != null)
            .Select(x => x.QuoteProjectTaskId!.Value)
            .ToListAsync();
        foreach (var task in quote.ProjectTasks.Where(x => !existingQueuedTaskIds.Contains(x.Id)))
        {
            db.QuoteProcessingJobs.Add(new QuoteProcessingJob
            {
                QuoteCaseId = quote.Id,
                QuoteProjectTaskId = task.Id,
                JobType = "CentCom Task Analysis",
                Status = "Queued",
                Message = $"Project Task {task.SortOrder} ({task.TaskType}) queued with scope and {task.Photos.Count} photograph(s)."
            });
        }
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.ReadyForAnalysis, "All project tasks submitted to the CentCom analysis queue.");
        message = $"{quote.ProjectTasks.Count} project task(s) queued for CentCom analysis.";
    }
    private Task RejectAsync() => TransitionAsync(QuoteStatuses.Rejected, "Estimate rejected by operator.");

    private async Task ApproveAsync()
    {
        if (quote is null || version is null || version.Lines.Count == 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteVersions.FindAsync(version.Id);
        if (tracked is null || tracked.Status != "Draft") return;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        tracked.Status = "Approved";
        tracked.ApprovedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        tracked.ApprovedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.Approved, "Estimate version approved. External update and customer email remain disabled.");
    }

    private async Task CreateRevisionAsync()
    {
        if (quote is null || version is null || version.Status != "Approved") return;
        var next = new QuoteVersion
        {
            QuoteCaseId = quote.Id,
            VersionNumber = version.VersionNumber + 1,
            TaxRate = version.TaxRate,
            DiscountAmount = version.DiscountAmount,
            CustomerNotes = version.CustomerNotes
        };
        foreach (var line in version.Lines)
        {
            next.Lines.Add(new QuoteLine
            {
                SortOrder = line.SortOrder,
                Description = line.Description,
                Quantity = line.Quantity,
                Unit = line.Unit,
                MaterialUnitCost = line.MaterialUnitCost,
                LaborHours = line.LaborHours,
                LaborRate = line.LaborRate,
                EquipmentCost = line.EquipmentCost,
                WastePercent = line.WastePercent,
                MarkupPercent = line.MarkupPercent,
                CustomerPrice = line.CustomerPrice,
                Source = "Revision"
            });
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Add(next);
        await db.SaveChangesAsync();
        await TransitionAsync(QuoteStatuses.RevisionRequested, "A new editable estimate version was created.");
    }

    private Task PublishEstimateEventAsync(string module, string step, string status, string eventMessage) =>
        quote is null
            ? Task.CompletedTask
            : OperationalEvents.PublishAsync(new OperationalEventRequest(
                "CharlieCompany.Web",
                module,
                step,
                status,
                eventMessage,
                CorrelationId: $"quote-{quote.Id:D6}",
                LocalOperationId: quote.LocalOperationId,
                QuoteCaseId: quote.Id,
                JobNumber: quote.HousecallProJobId));

    private static string FormatFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:N1} MB" : $"{bytes / 1024d:N0} KB";

