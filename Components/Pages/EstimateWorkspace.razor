        {
            catalogItem = new VendorProduct
            {
                SupplyVendorId = vendor.Id, VendorSku = sku, VendorDescription = material.Description.Trim(), PurchaseUnit = material.Unit.Trim(), PackageQuantity = 1,
                Product = new Product { Name = material.Description.Trim()[..Math.Min(160, material.Description.Trim().Length)], Manufacturer = "Home Depot", ManufacturerPartNumber = sku, UnitOfMeasure = material.Unit.Trim() }
            };
            db.VendorProducts.Add(catalogItem);
        }
        var today = DateOnly.FromDateTime(DateTime.Today);
        var price = catalogItem.Prices.SingleOrDefault(x => x.EffectiveDate == today);
        if (price is null) { price = new VendorPrice { UnitPrice = material.UnitCost, EffectiveDate = today, SourceType = "Manual estimate review" }; catalogItem.Prices.Add(price); }
        else price.UnitPrice = material.UnitCost;
        tracked.VendorProduct = catalogItem;
        tracked.VendorSku = sku;
        tracked.Description = material.Description.Trim();
        tracked.Quantity = Math.Max(0, material.Quantity);
        tracked.Unit = material.Unit.Trim();
        tracked.UnitCost = material.UnitCost;
        tracked.WastePercent = Math.Max(0, material.WastePercent);
        tracked.MatchKind = MaterialMatchKinds.ManualCatalog;
        tracked.ReviewDecision = MaterialReviewDecisions.Accepted;
        tracked.IsRemoved = false;
        tracked.IsUnmatched = false;
        tracked.SourceType = vendor.Name;
        tracked.SourceReference = "Manual estimate review";
        tracked.SourcePriceDate = today;
        await db.SaveChangesAsync();
        var currentUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        await SaveReusableMaterialRuleAsync(db, tracked, currentUser.FindFirstValue(ClaimTypes.NameIdentifier));
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        message = $"Added '{tracked.Description}' to the Home Depot catalog and selected it for this estimate.";
        await ReloadAsync();
    }

    private static VendorPrice? CurrentCatalogPrice(VendorProduct item)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return item.Prices.Where(x => x.EffectiveDate <= today && (x.ExpirationDate == null || x.ExpirationDate >= today))
            .OrderByDescending(x => x.EffectiveDate).ThenByDescending(x => x.Id).FirstOrDefault();
    }

    private async Task SubmitTaskAnalysisAsync(QuoteProjectTask task)
    {
        if (quote is null || string.IsNullOrWhiteSpace(task.ScopeOfWork))
        {
            message = "Enter and save the task scope of work before requesting CentCom analysis.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var trackedTask = await db.QuoteProjectTasks
            .SingleOrDefaultAsync(x => x.Id == task.Id && x.QuoteCaseId == quote.Id);
        if (trackedTask is null)
        {
            message = "The project task could not be found. Reload the estimate and try again.";
            return;
        }
        ApplyProjectTaskEdits(trackedTask, task);
        var revision = (await db.QuoteTaskAnalyses
            .Where(x => x.QuoteProjectTaskId == task.Id)
            .Select(x => (int?)x.RevisionNumber)
            .MaxAsync() ?? 0) + 1;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var analysis = new QuoteTaskAnalysis
        {
            QuoteProjectTaskId = task.Id,
            RevisionNumber = revision,
            Status = QuoteTaskAnalysisStatuses.Processing,
            SubmittedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier)
        };
        db.QuoteTaskAnalyses.Add(analysis);
        var processingJob = new QuoteProcessingJob
        {
            QuoteCaseId = quote.Id,
            QuoteProjectTaskId = task.Id,
            JobType = "CentCom Task Analysis",
            // Reserve this job before saving so another application instance that shares
            // the database cannot claim it with an older material-matching implementation.
            Status = "Processing",
            Message = $"Project Task {task.SortOrder} ({task.TaskType}) analysis revision {revision} is processing."
        };
        db.QuoteProcessingJobs.Add(processingJob);
        await AddAuditEventAsync(db, quote, $"CentCom analysis revision {revision} submitted for Project Task {task.SortOrder} ({task.TaskType}).");
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("CentComAnalysis", "Submit", "Processing", $"Task {task.SortOrder} analysis revision {revision} reserved for this application instance.");
        message = $"Project Task {task.SortOrder} is being analyzed by CentCom.";
        await CentComTaskAnalysis.ProcessAsync(processingJob.Id, CancellationToken.None);
        await ReloadAsync();
    }

    private void StartAnalysisMonitoringIfNeeded()
    {
        var hasPendingAnalysis = quote?.ProjectTasks.Any(task =>
            LatestAnalysis(task)?.Status is QuoteTaskAnalysisStatuses.Queued or
                QuoteTaskAnalysisStatuses.Processing) == true;
        if (!hasPendingAnalysis || analysisMonitorTask is { IsCompleted: false }) return;

        analysisMonitorCancellation?.Dispose();
        analysisMonitorCancellation = new CancellationTokenSource();
        analysisMonitorTask = MonitorPendingAnalysesAsync(analysisMonitorCancellation.Token);
    }

    private async Task MonitorPendingAnalysesAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });

                var stillPending = quote?.ProjectTasks.Any(task =>
                    LatestAnalysis(task)?.Status is QuoteTaskAnalysisStatuses.Queued or
                        QuoteTaskAnalysisStatuses.Processing) == true;
                if (!stillPending) break;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Component disposal stopped the monitor.
        }
    }

    private async Task ReviewAnalysisAsync(QuoteTaskAnalysis analysis, bool accept)
    {
        if (quote is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteTaskAnalyses
            .Include(x => x.QuoteProjectTask)
            .Include(x => x.Materials)
            .SingleOrDefaultAsync(x => x.Id == analysis.Id && x.QuoteProjectTask.QuoteCaseId == quote.Id);
        if (tracked is null || tracked.Status != QuoteTaskAnalysisStatuses.NeedsReview) return;
        if (accept && tracked.Materials.Any(x => !x.IsRemoved &&
            (x.ReviewDecision == MaterialReviewDecisions.Pending || x.MatchKind == MaterialMatchKinds.Unresolved)))
        {
            message = "Review every unresolved or suggested material. Accept it, replace it, remove it, add it to the catalog, or mark it one-off before accepting the analysis.";
            return;
        }
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        tracked.Status = accept ? QuoteTaskAnalysisStatuses.Accepted : QuoteTaskAnalysisStatuses.Rejected;
        tracked.ReviewedAt = DateTimeOffset.UtcNow;
        tracked.ReviewedByUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        await AddAuditEventAsync(
            db,
            quote,
            $"CentCom analysis revision {tracked.RevisionNumber} for Project Task {tracked.QuoteProjectTask.SortOrder} was {(accept ? "accepted" : "rejected")}.");
        await db.SaveChangesAsync();
        await PublishEstimateEventAsync("CentComAnalysis", "Review", "Completed", $"Analysis revision {tracked.RevisionNumber} {(accept ? "accepted" : "rejected")}.");
        message = $"CentCom analysis revision {tracked.RevisionNumber} was {(accept ? "accepted" : "rejected")}.";
        await ReloadAsync();
    }

    private async Task SaveAnalysisEditsAsync(QuoteTaskAnalysis analysis)
    {
        if (quote is null || analysis.Status != QuoteTaskAnalysisStatuses.NeedsReview) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.QuoteTaskAnalyses
            .Include(x => x.QuoteProjectTask)
            .Include(x => x.Materials)
            .SingleOrDefaultAsync(x => x.Id == analysis.Id && x.QuoteProjectTask.QuoteCaseId == quote.Id);
        if (tracked is null) return;

        tracked.DeliveryAllowance = Math.Max(0, analysis.DeliveryAllowance);
        tracked.TaxAllowance = Math.Max(0, analysis.TaxAllowance);
        tracked.OtherAllowance = Math.Max(0, analysis.OtherAllowance);
        foreach (var edited in analysis.Materials)
        {
            var item = tracked.Materials.SingleOrDefault(x => x.Id == edited.Id);
            if (item is null && edited.Id == 0)
            {
                item = new QuoteTaskAnalysisMaterial
                {
                    SortOrder = edited.SortOrder,
                    OriginalDescription = edited.OriginalDescription ?? edited.Description,
                    MatchKind = MaterialMatchKinds.Unresolved,
                    ReviewDecision = MaterialReviewDecisions.Pending,
                    IsUnmatched = true,
                    SourceType = "Manual review"
                };
                tracked.Materials.Add(item);
            }
            if (item is null) continue;
            item.VendorSku = string.IsNullOrWhiteSpace(edited.VendorSku) ? null : edited.VendorSku.Trim();
            item.Description = edited.Description.Trim();
            item.Quantity = Math.Max(0, edited.Quantity);
            item.Unit = edited.Unit.Trim();
            item.UnitCost = Math.Max(0, edited.UnitCost);
            item.WastePercent = Math.Max(0, edited.WastePercent);
        }

        await AddAuditEventAsync(
            db,
            quote,
            $"CentCom analysis revision {tracked.RevisionNumber} for Project Task {tracked.QuoteProjectTask.SortOrder} was manually edited.");
        await db.SaveChangesAsync();
        editingAnalysisIds.Remove(analysis.Id);
        await PublishEstimateEventAsync("CentComAnalysis", "Edit", "Completed", $"Analysis revision {tracked.RevisionNumber} manually edited.");
        message = $"CentCom analysis revision {tracked.RevisionNumber} edits were saved.";
        await ReloadAsync();
    }

    private async Task CancelAnalysisEditsAsync(int analysisId)
    {
        editingAnalysisIds.Remove(analysisId);
        await ReloadAsync();
    }

    private async Task AddProjectTaskAsync()
