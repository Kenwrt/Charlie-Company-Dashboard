@page "/hcp/jobs"
@attribute [Authorize(Roles = $"{ApplicationRoles.Administrator},{ApplicationRoles.LocalOperator}")]
@using CharleyCompany.Dashboard.Web.Data
@using CharleyCompany.Dashboard.Web.Services
@using CharleyCompany.Dashboard.Web.Options
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject OperationAccessService OperationAccess
@inject HousecallProDataService HousecallPro

<PageTitle>Housecall Pro Jobs</PageTitle>
<section class="dashboard-shell">
    @if (!string.IsNullOrWhiteSpace(ReceivablesFilter))
    {
        <nav class="mb-3" aria-label="Breadcrumb">
            <a href="/#receivables-aging" class="text-decoration-none">← Back to Receivables aging report</a>
        </nav>
    }
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Housecall Pro</p>
            <h1>Jobs</h1>
            <p class="dashboard-subtitle">Imported job summaries for your assigned local operations.</p>
        </div>
        <div class="dashboard-header-action">
            <input class="form-control" value="@search" @oninput="OnSearchInputAsync" placeholder="Search" aria-label="Search jobs" />
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <label class="form-label">Local operation</label>
            <InputSelect class="form-select" @bind-Value="operationId" @bind-Value:after="ReloadAsync">
                <option value="0">All assigned operations</option>
                @foreach (var operation in operations) { <option value="@operation.Id">@operation.EffectiveDisplayName</option> }
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <InputSelect class="form-select" @bind-Value="status" @bind-Value:after="ReloadAsync">
                <option value="@ScheduledAndUnscheduledStatus">Active Jobs</option>
                <option value="scheduled">Scheduled</option>
                <option value="unscheduled">Unscheduled</option>
                <option value="">All statuses</option>
                @foreach (var item in statuses.Where(IsAdditionalStatus)) { <option value="@item">@item</option> }
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">From date</label>
            <InputDate class="form-control" @bind-Value="fromDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Through date</label>
            <InputDate class="form-control" @bind-Value="throughDate" />
        </div>
        <div class="col-md-3 d-flex align-items-end justify-content-end">
            <button class="btn btn-primary" @onclick="SyncAsync" disabled="@syncing">@(syncing ? "Syncing…" : "Sync now")</button>
        </div>
    </div>

    @if (ReceivablesFilter == "expected")
    {
        <div class="alert alert-info">Showing all jobs with an uncollected balance.</div>
    }
    else if (ReceivablesFilter == "over30")
    {
        <div class="alert alert-info">Showing jobs with an uncollected balance that are older than 30 days.</div>
    }
    else if (ReceivablesFilter == "aging")
    {
        <div class="alert alert-info">Showing jobs in the @AgingFilterLabel aging period.</div>
    }

    @if (message is not null) { <div class="alert alert-info">@message</div> }
    <p class="text-muted">Showing @jobs.Count of @totalCount synchronized jobs.</p>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("job")'>Job @SortIndicator("job")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("operation")'>Operation @SortIndicator("operation")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("customer")'>Customer @SortIndicator("customer")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("address")'>Home address @SortIndicator("address")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("status")'>Status @SortIndicator("status")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("date")'>Date @SortIndicator("date")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("price")'>Price @SortIndicator("price")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("invoiced")'>Invoiced @SortIndicator("invoiced")</button></th><th><button class="btn btn-link p-0 fw-bold" @onclick='() => SortAsync("uncollected")'>Uncollected @SortIndicator("uncollected")</button></th><th></th></tr></thead>
            <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td><a href="@($"hcp/{job.LocalOperation.Slug}/jobs/{job.ExternalId}")">@(job.JobNumber ?? job.ExternalId)</a></td>
                    <td>@job.LocalOperation.EffectiveDisplayName</td>
                    <td>@job.CustomerName<small class="d-block text-muted">@job.CustomerEmail<br />@FormatPhone(job.CustomerPhone)</small></td>
                    <td>@job.Address</td>
                    <td>@EffectiveStatus(job)</td>
                    <td>@(job.ScheduledStart?.ToLocalTime().ToString("MM/dd/yyyy") ?? "Not provided")</td>
                    <td>@job.JobPrice.ToString("C2")</td>
                    <td>@job.TotalAmount.ToString("C2")</td>
                    <td>@job.OutstandingBalance.ToString("C2")</td>
                    <td><a class="btn btn-sm btn-outline-primary" href="@($"hcp/{job.LocalOperation.Slug}/jobs/{job.ExternalId}")">Details</a></td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <td colspan="6">Filtered totals (@totalCount @(totalCount == 1 ? "job" : "jobs"))</td>
                    <td>@totalJobPrice.ToString("C2")</td>
                    <td>@totalAmountInvoiced.ToString("C2")</td>
                    <td>@totalUncollected.ToString("C2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    @if (jobs.Count == 0) { <div class="empty-state">No synchronized Housecall Pro jobs match the selected filters.</div> }
</section>

@code {
    [SupplyParameterFromQuery(Name = "operation")] public string? OperationFilter { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusFilter { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public DateTime? FromFilter { get; set; }
    [SupplyParameterFromQuery(Name = "through")] public DateTime? ThroughFilter { get; set; }
    [SupplyParameterFromQuery(Name = "receivables")] public string? ReceivablesFilter { get; set; }
    [SupplyParameterFromQuery(Name = "aging")] public string? AgingFilter { get; set; }
    [SupplyParameterFromQuery(Name = "allDates")] public bool AllDates { get; set; }

    private List<LocalOperation> operations = [];
    private List<HousecallProJob> jobs = [];
    private List<string> statuses = [];
    private int operationId;
    private const string ScheduledAndUnscheduledStatus = "scheduled-and-unscheduled";
    private const string NeedsSchedulingStatus = "needs scheduling";
    private string status = ScheduledAndUnscheduledStatus;
    private string search = "";
    private DateTime? fromDate = new(DateTime.Today.Year, 1, 1);
    private DateTime? throughDate = new(DateTime.Today.Year, 12, 31);
    private bool syncing;
    private string? message;
    private int totalCount;
    private decimal totalJobPrice;
    private decimal totalAmountInvoiced;
    private decimal totalUncollected;
    private CancellationTokenSource? searchDebounce;
    private string sortColumn = "date";
    private bool sortDescending = true;

    protected override async Task OnInitializedAsync()
    {
        operations = (await OperationAccess.GetAccessibleOperationsAsync()).ToList();
        operationId = operations.FirstOrDefault(operation =>
            operation.Slug.Equals(OperationFilter, StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
        if (!string.IsNullOrWhiteSpace(StatusFilter)) status = StatusFilter;
        else if (!string.IsNullOrWhiteSpace(ReceivablesFilter)) status = "";
        if (AllDates)
        {
            fromDate = null;
            throughDate = null;
        }
        else
        {
            if (FromFilter is not null) fromDate = FromFilter.Value.Date;
            if (ThroughFilter is not null) throughDate = ThroughFilter.Value.Date;
        }
        await LoadStatusesAsync();
        await ReloadAsync();
    }

    private async Task LoadStatusesAsync()
    {
        var allowed = operations.Select(x => x.Id).ToList();
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var sourceStatuses = await db.HousecallProJobs.AsNoTracking()
            .Where(x => allowed.Contains(x.LocalOperationId) && x.WorkStatus != null)
            .Select(x => x.WorkStatus!)
            .Distinct()
            .ToListAsync();
        statuses = sourceStatuses
            .Concat(HousecallProEstimateStatuses.All.Where(x => x != HousecallProEstimateStatuses.New))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private async Task ReloadAsync()
    {
        var allowed = operations.Select(x => x.Id).ToList();
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var query = db.HousecallProJobs.AsNoTracking().Include(x => x.LocalOperation)
            .Where(x => allowed.Contains(x.LocalOperationId) && x.InternalStatus != HousecallProEstimateStatuses.FollowUpComplete);

        if (operationId != 0) query = query.Where(x => x.LocalOperationId == operationId);
        var explicitlySelectedCanceledStatus =
            status.Equals("user canceled", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("pro canceled", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("pro-canceled", StringComparison.OrdinalIgnoreCase);
        if (!explicitlySelectedCanceledStatus)
            query = query.Where(x =>
                x.WorkStatus != "user canceled" &&
                x.WorkStatus != "pro canceled" &&
                x.WorkStatus != "pro-canceled");
        if (status == ScheduledAndUnscheduledStatus)
        {
            query = query.Where(x =>
                x.InternalStatus == "scheduled" ||
                x.InternalStatus == "unscheduled" ||
                x.InternalStatus == NeedsSchedulingStatus ||
                x.InternalStatus == "in progress" ||
                (x.InternalStatus == null &&
                    (x.WorkStatus == "scheduled" ||
                     x.WorkStatus == "unscheduled" ||
                     x.WorkStatus == NeedsSchedulingStatus ||
                     x.WorkStatus == "in progress")));
        }
        else if (status.Equals("unscheduled", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(x =>
                x.InternalStatus == "unscheduled" ||
                x.InternalStatus == NeedsSchedulingStatus ||
                (x.InternalStatus == null &&
                    (x.WorkStatus == "unscheduled" || x.WorkStatus == NeedsSchedulingStatus)));
        }
        else if (!string.IsNullOrWhiteSpace(status))
        {
            query = query.Where(x => x.InternalStatus == status || (x.InternalStatus == null && x.WorkStatus == status));
        }
        var includesUnscheduled =
            status == ScheduledAndUnscheduledStatus ||
            status.Equals("unscheduled", StringComparison.OrdinalIgnoreCase) ||
            status.Equals(NeedsSchedulingStatus, StringComparison.OrdinalIgnoreCase);
        if (ReceivablesFilter is "expected" or "over30" or "aging")
        {
            var currentYearStart = new DateTimeOffset(DateTime.Today.Year, 1, 1, 0, 0, 0, TimeSpan.Zero);
            query = query.Where(x =>
                x.OutstandingBalance > 0 &&
                (x.ScheduledStart ?? x.SourceUpdatedAt ?? x.LastSyncedAt) >= currentYearStart);
        }
        if (ReceivablesFilter == "over30")
        {
            var cutoff = ToUtcBoundary(DateTime.Today.AddDays(-30));
            query = query.Where(x => (x.ScheduledEnd ?? x.ScheduledStart) < cutoff);
        }
        if (ReceivablesFilter == "aging")
        {
            var ageDate = query.Select(x => new { Job = x, Date = x.ScheduledEnd ?? x.ScheduledStart });
            var cutoff30 = ToUtcBoundary(DateTime.Today.AddDays(-30));
            var cutoff60 = ToUtcBoundary(DateTime.Today.AddDays(-60));
            var cutoff90 = ToUtcBoundary(DateTime.Today.AddDays(-90));
            query = AgingFilter switch
            {
                "current-30" => ageDate.Where(x => x.Date >= cutoff30).Select(x => x.Job),
                "31-60" => ageDate.Where(x => x.Date >= cutoff60 && x.Date < cutoff30).Select(x => x.Job),
                "61-90" => ageDate.Where(x => x.Date >= cutoff90 && x.Date < cutoff60).Select(x => x.Job),
                "91-plus" => ageDate.Where(x => x.Date < cutoff90).Select(x => x.Job),
                "unknown" => ageDate.Where(x => x.Date == null).Select(x => x.Job),
                _ => query.Where(_ => false)
            };
        }
        if (fromDate is not null)
        {
            var from = ToUtcBoundary(fromDate.Value);
            query = query.Where(x =>
                x.ScheduledStart >= from ||
                (includesUnscheduled &&
                    (x.InternalStatus == "unscheduled" ||
                     x.InternalStatus == NeedsSchedulingStatus ||
                     (x.InternalStatus == null &&
                        (x.WorkStatus == "unscheduled" || x.WorkStatus == NeedsSchedulingStatus)))));
        }
        if (throughDate is not null)
        {
            var throughExclusive = ToUtcBoundary(throughDate.Value.AddDays(1));
            query = query.Where(x =>
                x.ScheduledStart < throughExclusive ||
                (includesUnscheduled &&
                    (x.InternalStatus == "unscheduled" ||
                     x.InternalStatus == NeedsSchedulingStatus ||
                     (x.InternalStatus == null &&
                        (x.WorkStatus == "unscheduled" || x.WorkStatus == NeedsSchedulingStatus)))));
        }
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = $"%{search.Trim()}%";
            query = query.Where(x =>
                EF.Functions.ILike(x.JobNumber ?? "", term) ||
                EF.Functions.ILike(x.ExternalId, term) ||
                EF.Functions.ILike(x.CustomerName ?? "", term) ||
                EF.Functions.ILike(x.CreatedByName ?? "", term) ||
                EF.Functions.ILike(x.CustomerEmail ?? "", term) ||
                EF.Functions.ILike(x.CustomerPhone ?? "", term) ||
                EF.Functions.ILike(x.Address ?? "", term));
        }

        totalCount = await query.CountAsync();
        var totals = await query.GroupBy(_ => 1)
            .Select(group => new
            {
                JobPrice = group.Sum(x => x.JobPrice),
                AmountInvoiced = group.Sum(x => x.TotalAmount),
                Uncollected = group.Sum(x => x.OutstandingBalance)
            })
            .SingleOrDefaultAsync();
        totalJobPrice = totals?.JobPrice ?? 0;
        totalAmountInvoiced = totals?.AmountInvoiced ?? 0;
        totalUncollected = totals?.Uncollected ?? 0;
        query = ApplySort(query);
        jobs = await query.Take(500).ToListAsync();
    }

    private IQueryable<HousecallProJob> ApplySort(IQueryable<HousecallProJob> query) => (sortColumn, sortDescending) switch
    {
        ("job", false) => query.OrderBy(x => x.JobNumber), ("job", true) => query.OrderByDescending(x => x.JobNumber),
        ("operation", false) => query.OrderBy(x => x.LocalOperation.DisplayName).ThenBy(x => x.LocalOperation.Name), ("operation", true) => query.OrderByDescending(x => x.LocalOperation.DisplayName).ThenByDescending(x => x.LocalOperation.Name),
        ("customer", false) => query.OrderBy(x => x.CustomerName), ("customer", true) => query.OrderByDescending(x => x.CustomerName),
        ("address", false) => query.OrderBy(x => x.Address), ("address", true) => query.OrderByDescending(x => x.Address),
        ("status", false) => query.OrderBy(x => x.InternalStatus ?? x.WorkStatus), ("status", true) => query.OrderByDescending(x => x.InternalStatus ?? x.WorkStatus),
        ("price", false) => query.OrderBy(x => x.JobPrice), ("price", true) => query.OrderByDescending(x => x.JobPrice),
        ("invoiced", false) => query.OrderBy(x => x.TotalAmount), ("invoiced", true) => query.OrderByDescending(x => x.TotalAmount),
        ("uncollected", false) => query.OrderBy(x => x.OutstandingBalance), ("uncollected", true) => query.OrderByDescending(x => x.OutstandingBalance),
        (_, false) => query.OrderBy(x => x.ScheduledStart == null).ThenBy(x => x.ScheduledStart),
        _ => query.OrderBy(x => x.ScheduledStart == null).ThenByDescending(x => x.ScheduledStart)
    };

    private async Task SortAsync(string column) { if (sortColumn == column) sortDescending = !sortDescending; else { sortColumn = column; sortDescending = false; } await ReloadAsync(); }
    private string SortIndicator(string column) => sortColumn == column ? (sortDescending ? "▼" : "▲") : "↕";

    private async Task SyncAsync()
    {
        syncing = true;
        message = null;
        try
        {
            foreach (var operation in operations.Where(x => operationId == 0 || x.Id == operationId))
            {
                var key = Configuration.GetSection(HousecallProOptions.SectionName).Get<HousecallProOptions>()?.GetApiKey(operation.Slug);
                if (key is not null) await HousecallPro.SyncOperationAsync(operation, key);
            }
            message = "Housecall Pro jobs and estimates were synchronized.";
            await LoadStatusesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { message = $"Sync failed: {ex.Message}"; }
        finally { syncing = false; }
    }

    private static string FormatPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits[0] == '1') digits = digits[1..];
        return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value;
    }

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        search = args.Value?.ToString() ?? "";
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, searchDebounce.Token);
            await ReloadAsync();
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
    }

    private static DateTimeOffset ToUtcBoundary(DateTime value)
    {
        var date = DateTime.SpecifyKind(value.Date, DateTimeKind.Unspecified);
        return new DateTimeOffset(date, TimeZoneInfo.Local.GetUtcOffset(date)).ToUniversalTime();
    }
    private static string EffectiveStatus(HousecallProJob job)
    {
        var value = job.InternalStatus ?? job.WorkStatus;
        return value?.Equals(NeedsSchedulingStatus, StringComparison.OrdinalIgnoreCase) == true
            ? "unscheduled"
            : value ?? "Not provided";
    }
    private string AgingFilterLabel => AgingFilter switch
    {
        "current-30" => "Current to 30 days",
        "31-60" => "31–60 days",
        "61-90" => "61–90 days",
        "91-plus" => "91+ days",
        "unknown" => "Unknown (unscheduled/no date)",
        _ => "selected"
    };

    private static bool IsAdditionalStatus(string value) =>
        !value.Equals("scheduled", StringComparison.OrdinalIgnoreCase) &&
        !value.Equals("unscheduled", StringComparison.OrdinalIgnoreCase) &&
        !value.Equals(NeedsSchedulingStatus, StringComparison.OrdinalIgnoreCase);

    [Inject] private IConfiguration Configuration { get; set; } = null!;
}
