    private sealed record RevenueForecastSummary(IReadOnlyList<RevenueForecastJobRow> Jobs,IReadOnlyList<RevenueForecastBucket> Buckets,IReadOnlyList<string> Operations)
    {
        public static RevenueForecastSummary Empty { get; } = new([], [], []);
