        trackedReview.ResolvedAt = DateTimeOffset.UtcNow;
        await SaveReusableReviewRuleAsync(db, trackedReview, user.FindFirstValue(ClaimTypes.NameIdentifier));
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        reviewCatalogSelections.Remove(item.Id);
